#!/bin/bash
set -euo pipefail

IOS_PATH="$WORKSPACE/Builds/iOS"
ARCHIVE="$WORKSPACE/Builds/iOSArchive/Game.xcarchive"
EXPORT="$WORKSPACE/Builds/iOSExport"
SCHEME="${IOS_SCHEME:-__UMP_IOS_SCHEME__}"
OPTIONS="$WORKSPACE/Jenkins/ExportOptions.plist"

rm -rf "$WORKSPACE/Builds/iOSArchive" "$EXPORT"
mkdir -p "$(dirname "$ARCHIVE")" "$EXPORT"

cd "$IOS_PATH"

xcodebuild   -project Unity-iPhone.xcodeproj   -scheme "$SCHEME"   -configuration Release   -archivePath "$ARCHIVE"   archive

xcodebuild   -exportArchive   -archivePath "$ARCHIVE"   -exportPath "$EXPORT"   -exportOptionsPlist "$OPTIONS"

find "$EXPORT" -maxdepth 2 -type f -print
