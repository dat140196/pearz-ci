pipeline {

    agent any

    environment {
        IOS_SCHEME = '**UMP_IOS_SCHEME**'
    }

    stages {

        // ====================================================
        // VALIDATE BRANCH
        // ====================================================

        stage('Validate Branch') {
            steps {
                script {

                    def allowedBranches = [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ]

                    if (!allowedBranches.contains(env.BRANCH_NAME)) {
                        error(
                            "Unsupported PEARZ branch: ${env.BRANCH_NAME}"
                        )
                    }

                    echo "========================================"
                    echo "PEARZ BUILD"
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "========================================"
                }
            }
        }

        // ====================================================
        // ANDROID AAB
        // release/android
        // ====================================================

        stage('Android AAB') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        // ====================================================
        // ANDROID APK
        // release/android-test
        // ====================================================

        stage('Android APK') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        // ====================================================
        // IOS DEVICE
        // release/ios-test
        // ====================================================

        stage('iOS Device') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS BUILD
        // release/ios
        // ====================================================

        stage('iOS TestFlight Build') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS ARCHIVE / EXPORT
        // ====================================================

        stage('iOS Archive / Export') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/archive_ios.sh
                    ./Jenkins/archive_ios.sh
                '''
            }
        }

        // ====================================================
        // TESTFLIGHT UPLOAD
        // ====================================================

        stage('TestFlight Upload') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/upload_testflight.sh
                    ./Jenkins/upload_testflight.sh
                '''
            }
        }

        // ====================================================
        // GOOGLE DRIVE
        // ====================================================

        stage('Drive Upload') {

            steps {

                script {

                    def artifact = ''

                    // Android AAB
                    if (env.BRANCH_NAME == 'release/android') {
                        artifact = 'Builds/Android/Game.aab'
                    }

                    // Android APK
                    if (env.BRANCH_NAME == 'release/android-test') {
                        artifact = 'Builds/AndroidTest/Game.apk'
                    }

                    // iOS IPA
                    if (env.BRANCH_NAME == 'release/ios') {

                        artifact = sh(
                            script: '''
                                find Builds/iOSExport \
                                -type f \
                                -name "*.ipa" \
                                | head -n 1 || true
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    if (artifact && fileExists(artifact)) {

                        echo "========================================"
                        echo "[PEARZ] Google Drive Upload"
                        echo "[PEARZ] Artifact: ${artifact}"
                        echo "========================================"

                        withCredentials([

                            string(
                                credentialsId: 'UMP_DRIVE_SERVICE_ACCOUNT_JSON',
                                variable: 'UMP_DRIVE_SERVICE_ACCOUNT_JSON'
                            ),

                            string(
                                credentialsId: 'UMP_DRIVE_FOLDER_ID',
                                variable: 'UMP_DRIVE_FOLDER_ID'
                            )

                        ]) {

                            withEnv([
                                "PEARZ_ARTIFACT=${artifact}"
                            ]) {

                                sh '''
                                    chmod +x Jenkins/upload_drive.sh
                                    chmod +x Jenkins/upload_drive_impl.py

                                    ./Jenkins/upload_drive.sh \
                                        "$PEARZ_ARTIFACT"
                                '''
                            }
                        }

                    } else {

                        echo "[PEARZ] No artifact found for Google Drive upload."

                    }
                }
            }
        }
    }

    // ========================================================
    // POST ACTIONS
    // ========================================================

    post {

        always {

            script {

                def artifact = ''

                // ------------------------------------------------
                // Android AAB
                // ------------------------------------------------

                if (env.BRANCH_NAME == 'release/android') {

                    def path =
                        "${env.WORKSPACE}/Builds/Android/Game.aab"

                    if (fileExists(path)) {
                        artifact = path
                    }
                }

                // ------------------------------------------------
                // Android APK
                // ------------------------------------------------

                if (env.BRANCH_NAME == 'release/android-test') {

                    def path =
                        "${env.WORKSPACE}/Builds/AndroidTest/Game.apk"

                    if (fileExists(path)) {
                        artifact = path
                    }
                }

                // ------------------------------------------------
                // iOS IPA
                // ------------------------------------------------

                if (env.BRANCH_NAME == 'release/ios') {

                    def ipa = sh(
                        script: '''
                            find Builds/iOSExport \
                            -type f \
                            -name "*.ipa" \
                            | head -n 1 || true
                        ''',
                        returnStdout: true
                    ).trim()

                    if (ipa) {
                        artifact =
                            "${env.WORKSPACE}/${ipa}"
                    }
                }

                def status =
                    currentBuild.currentResult ?: 'UNKNOWN'

                echo "========================================"
                echo "PEARZ BUILD RESULT"
                echo "Status   : ${status}"
                echo "Artifact : ${artifact}"
                echo "========================================"

                // =================================================
                // TELEGRAM
                // Always notify SUCCESS / FAILURE
                // =================================================

                withCredentials([

                    string(
                        credentialsId: 'UMP_TELEGRAM_BOT_TOKEN',
                        variable: 'UMP_TELEGRAM_BOT_TOKEN'
                    ),

                    string(
                        credentialsId: 'UMP_TELEGRAM_CHAT_ID',
                        variable: 'UMP_TELEGRAM_CHAT_ID'
                    )

                ]) {

                    withEnv([
                        "UMP_BUILD_STATUS=${status}",
                        "UMP_ARTIFACT=${artifact}"
                    ]) {

                        sh '''
                            chmod +x Jenkins/notify_telegram.sh

                            ./Jenkins/notify_telegram.sh || true
                        '''
                    }
                }

                // =================================================
                // JENKINS ARTIFACT ARCHIVE
                // =================================================

                archiveArtifacts(
                    artifacts:
                        'Builds/**/*.apk,' +
                        'Builds/**/*.aab,' +
                        'Builds/**/*.ipa',
                    allowEmptyArchive: true
                )
            }
        }
    }
}