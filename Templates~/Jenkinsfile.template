pipeline {

    agent any

    environment {
        IOS_SCHEME = '**UMP_IOS_SCHEME**'
    }

    stages {

        stage('Validate Branch') {
            steps {
                script {

                    def allowedBranches = [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ]

                    if (!allowedBranches.contains(env.BRANCH_NAME)) {
                        error(
                            "Unsupported PEARZ branch: ${env.BRANCH_NAME}"
                        )
                    }

                    echo "========================================"
                    echo "PEARZ BUILD"
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "========================================"
                }
            }
        }

        // ====================================================
        // ANDROID AAB
        // release/android
        // ====================================================

        stage('Android AAB') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        // ====================================================
        // ANDROID APK
        // release/android-test
        // ====================================================

        stage('Android APK') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        // ====================================================
        // IOS DEVICE
        // release/ios-test
        // ====================================================

        stage('iOS Device') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS BUILD
        // release/ios
        // ====================================================

        stage('iOS TestFlight Build') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS ARCHIVE / EXPORT
        // ====================================================

        stage('iOS Archive / Export') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/archive_ios.sh
                    ./Jenkins/archive_ios.sh
                '''
            }
        }

        // ====================================================
        // TESTFLIGHT
        // ====================================================

        stage('TestFlight Upload') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/upload_testflight.sh
                    ./Jenkins/upload_testflight.sh
                '''
            }
        }

        // ====================================================
        // GOOGLE DRIVE
        // ====================================================

        stage('Drive Upload') {

            steps {

                script {

                    def artifact = ''

                    if (
                        env.BRANCH_NAME ==
                        'release/android'
                    ) {
                        artifact =
                            'Builds/Android/Game.aab'
                    }

                    if (
                        env.BRANCH_NAME ==
                        'release/android-test'
                    ) {
                        artifact =
                            'Builds/AndroidTest/Game.apk'
                    }

                    if (
                        env.BRANCH_NAME ==
                        'release/ios'
                    ) {
                        artifact = sh(
                            script:
                                'find Builds/iOSExport ' +
                                '-type f -name "*.ipa" ' +
                                '| head -n 1 || true',
                            returnStdout: true
                        ).trim()
                    }

                    if (
                        artifact &&
                        fileExists(artifact)
                    ) {

                        echo "========================================"
                        echo "Uploading to Google Drive"
                        echo "Artifact: ${artifact}"
                        echo "========================================"

                        sh """
                            chmod +x Jenkins/upload_drive.sh
                            chmod +x Jenkins/upload_drive_impl.py
                            ./Jenkins/upload_drive.sh '${artifact}'
                        """

                    } else {

                        echo "No artifact found for Drive upload."

                    }
                }
            }
        }
    }

    // ========================================================
    // POST
    // Telegram + Jenkins Artifact
    // ========================================================

    post {

        always {

            script {

                def artifact = ''

                if (
                    env.BRANCH_NAME ==
                    'release/android'
                ) {
                    artifact =
                        "${env.WORKSPACE}/Builds/Android/Game.aab"
                }

                if (
                    env.BRANCH_NAME ==
                    'release/android-test'
                ) {
                    artifact =
                        "${env.WORKSPACE}/Builds/AndroidTest/Game.apk"
                }

                if (
                    env.BRANCH_NAME ==
                    'release/ios'
                ) {

                    def ipa = sh(
                        script:
                            'find Builds/iOSExport ' +
                            '-type f -name "*.ipa" ' +
                            '| head -n 1 || true',
                        returnStdout: true
                    ).trim()

                    if (ipa) {
                        artifact =
                            "${env.WORKSPACE}/${ipa}"
                    }
                }

                def status =
                    currentBuild.currentResult ?: 'UNKNOWN'

                echo "========================================"
                echo "PEARZ BUILD RESULT"
                echo "Status   : ${status}"
                echo "Artifact : ${artifact}"
                echo "========================================"

                sh """
                    chmod +x Jenkins/notify_telegram.sh

                    UMP_BUILD_STATUS='${status}' \
                    UMP_ARTIFACT='${artifact}' \
                    ./Jenkins/notify_telegram.sh || true
                """
            }

            archiveArtifacts(
                artifacts:
                    'Builds/**/*.apk,' +
                    'Builds/**/*.aab,' +
                    'Builds/**/*.ipa',
                allowEmptyArchive: true
            )
        }
    }
}