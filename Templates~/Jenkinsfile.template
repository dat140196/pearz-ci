// ============================================================
// ANDROID BUILD + SIGNING
//
// Signing policy:
//   release/android      -> AAB, release keystore REQUIRED
//   release/android-test -> APK, custom keystore SKIPPED
//
// Only the Google Play AAB branch is allowed to bind Jenkins
// keystore credentials. Test/other Android builds call the shell
// directly; build_android.sh and JenkinsBuild.cs also enforce the
// same rule so a global/stale env var cannot sign them by accident.
//
// release/android keystore lookup order:
//   1. Optional Jenkins credentials:
//      UMP_ANDROID_KEYSTORE
//      UMP_ANDROID_KEYSTORE_PASS
//      UMP_ANDROID_KEY_ALIAS
//      UMP_ANDROID_KEY_ALIAS_PASS
//   2. Project Keystores/ folder
//   3. ~/.pearz/keystores (or UMP_KEYSTORE_HOME)
// ============================================================

def runAndroidBuild() {
    sh '''
        chmod +x Jenkins/find_unity.sh
        chmod +x Jenkins/build_android.sh
        ./Jenkins/build_android.sh
    '''
}

def buildAndroid() {

    // release/android-test must not even request Jenkins keystore
    // credentials. It builds with Android debug/default signing.
    if (env.BRANCH_NAME != 'release/android') {
        echo '[PEARZ] Android keystore skipped - only release/android AAB uses it.'
        runAndroidBuild()
        return
    }

    def hasJenkinsKeystore = true

    // Probe the optional Jenkins credential. If it is absent, the
    // shell resolver will look in the project/machine keystore store.
    try {
        withCredentials([
            file(
                credentialsId: 'UMP_ANDROID_KEYSTORE',
                variable: 'UMP_KEYSTORE_PROBE'
            )
        ]) {
            echo '[PEARZ] Android release keystore credential found.'
        }
    } catch (Exception e) {
        hasJenkinsKeystore = false
        echo '[PEARZ] No UMP_ANDROID_KEYSTORE Jenkins credential.'
        echo '[PEARZ] release/android will use the keystore resolver.'
    }

    if (!hasJenkinsKeystore) {
        runAndroidBuild()
        return
    }

    withCredentials([
        file(
            credentialsId: 'UMP_ANDROID_KEYSTORE',
            variable: 'UMP_ANDROID_KEYSTORE'
        ),
        string(
            credentialsId: 'UMP_ANDROID_KEYSTORE_PASS',
            variable: 'UMP_ANDROID_KEYSTORE_PASS'
        ),
        string(
            credentialsId: 'UMP_ANDROID_KEY_ALIAS',
            variable: 'UMP_ANDROID_KEY_ALIAS'
        ),
        string(
            credentialsId: 'UMP_ANDROID_KEY_ALIAS_PASS',
            variable: 'UMP_ANDROID_KEY_ALIAS_PASS'
        )
    ]) {
        runAndroidBuild()
    }
}

// ============================================================
// CHECKOUT LOCATION
//
// The project is checked out on the Desktop of the build
// machine instead of the hidden Jenkins workspace, so the exact
// tree that was built can be opened in Finder, Unity or Xcode
// while a failure is being looked at.
//
// Two rules this path has to obey:
//
//   1. No "%" in it. Jenkins encodes the "/" of a branch as
//      "%2F" inside JOB_NAME, and Unity 6 fails halfway through
//      an Android build on such a path - llvm-objcopy reports
//      "No such file or directory" for a file whose folder is
//      right there. The job name is sanitised below.
//
//   2. It is resolved on the controller, before a node exists,
//      so $HOME of the build user is not readable here. The
//      parent of JENKINS_HOME is used instead, which is the
//      home of the user Jenkins runs as in the normal
//      "~/.jenkins" setup.
//
// Set the global environment variable UMP_WORKSPACE_ROOT
// (Manage Jenkins > System) to put the checkout anywhere else.
// ============================================================

// Plain string work, no pipeline steps: @NonCPS keeps it callable
// from the agent directive, which is not a CPS context.
@NonCPS
def umpWorkspace() {

    def root = env.UMP_WORKSPACE_ROOT

    if (!root) {

        def home = env.HOME

        // "/Users/pearz/.jenkins" -> "/Users/pearz"
        if (!home && env.JENKINS_HOME) {
            home = env.JENKINS_HOME.replaceAll('/[^/]+/?$', '')
        }

        root = (home ?: '/tmp') + '/Desktop/PearzBuilds'
    }

    // "MeowPuzzle/release%2Fandroid" -> "MeowPuzzle/release_android"
    def job = (env.JOB_NAME ?: 'ump')
        .replaceAll('%2F', '_')
        .replaceAll('[^A-Za-z0-9._/-]', '_')

    return root + '/' + job
}

pipeline {

    agent {

        node {

            label ''

            customWorkspace "${umpWorkspace()}"
        }
    }

    parameters {

        // release/ios-test only. OFF is the safe default for
        // Personal Team/device builds: APNs signing requirements and
        // the generated Crashlytics Run Script are removed from the
        // exported Xcode project. Turn ON only when this build is
        // specifically testing Firebase and has the required Apple
        // Push profile + GoogleService-Info.plist.
        booleanParam(
            name: 'IOS_TEST_ENABLE_FIREBASE_PUSH',
            defaultValue: false,
            description: 'release/ios-test: keep Firebase Push + Crashlytics. OFF strips APNs signing + Crashlytics Run Script from generated Xcode for Personal Team.'
        )
    }

    options {

        // A push while a build is running must queue, never start a
        // second Unity on the same workspace.
        disableConcurrentBuilds()

        // Builds are 80 MB+, do not fill the Mac disk.
        buildDiscarder(
            logRotator(
                numToKeepStr: '15',
                artifactNumToKeepStr: '3'
            )
        )
    }

    triggers {

        // Auto build on push. The webhook from the Git host triggers
        // instantly; this polling is the fallback when no webhook is
        // configured. Polling only starts after the first build of
        // the branch.
        pollSCM('H/2 * * * *')
    }

    stages {

        // ====================================================
        // VALIDATE BRANCH
        // ====================================================

        stage('Validate Branch') {
            steps {
                script {

                    def allowedBranches = [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ]

                    // Every branch is built automatically on push, so
                    // a non-release branch is skipped quietly instead
                    // of failing the build.
                    if (!allowedBranches.contains(env.BRANCH_NAME)) {

                        echo "========================================"
                        echo "[PEARZ] Branch not handled by UMP:"
                        echo "[PEARZ] ${env.BRANCH_NAME}"
                        echo "[PEARZ] Nothing to build."
                        echo "========================================"

                        currentBuild.result = 'NOT_BUILT'

                    } else {

                        echo "========================================"
                        echo "[PEARZ] BUILD"
                        echo "[PEARZ] Branch    : ${env.BRANCH_NAME}"
                        echo "[PEARZ] Checkout  : ${env.WORKSPACE}"
                        echo "========================================"

                        // This workspace is intentionally persistent (iOS append
                        // export), so remove only per-build metadata. Otherwise a
                        // failed build could send a Drive URL/package from an older
                        // successful build in Telegram.
                        sh '''
                            mkdir -p Builds
                            rm -f \
                                Builds/ump_drive_url.txt \
                                Builds/ump_build_info_drive_url.txt \
                                Builds/ump_build_info.txt
                            find Builds -maxdepth 1 -type f \
                                -name '*_BUILD_INFO.txt' -delete 2>/dev/null || true
                        '''
                    }
                }
            }
        }

        // ====================================================
        // GIT SUBMODULES
        //
        // Unity local packages can live in SSH git submodules
        // (for example Packages/com.pearz.thirdparty). Jenkins'
        // normal checkout does not necessarily populate them, so
        // initialise/update them before Unity starts Package Manager.
        //
        // Credential expected in Jenkins:
        //   github-ssh  (SSH Username with private key)
        // ====================================================

        stage('Git Submodules') {

            when {
                expression {
                    [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ].contains(env.BRANCH_NAME)
                }
            }

            steps {
                script {

                    if (!fileExists('.gitmodules')) {
                        echo '[PEARZ] No .gitmodules file - submodule step skipped.'
                        return
                    }

                    // Do not use sshagent{} here. Some Jenkins installations
                    // do not have the SSH Agent plugin. The standard Credentials
                    // Binding plugin already exposes sshUserPrivateKey, so use
                    // the key file directly through GIT_SSH_COMMAND instead.
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'github-ssh',
                            keyFileVariable: 'UMP_GITHUB_SSH_KEY',
                            usernameVariable: 'UMP_GITHUB_SSH_USER'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "========================================"
                            echo "[PEARZ] GIT SUBMODULES"
                            echo "[PEARZ] Workspace : $WORKSPACE"
                            echo "[PEARZ] Auth      : Jenkins SSH private key"
                            echo "========================================"

                            chmod 600 "$UMP_GITHUB_SSH_KEY"

                            # Force git/ssh to use the Jenkins credential key.
                            # IdentitiesOnly prevents unrelated keys from the
                            # build user's ssh-agent/keychain being attempted.
                            export GIT_SSH_COMMAND="ssh -i $UMP_GITHUB_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

                            git submodule sync --recursive

                            # Jenkins reuses the custom workspace. Reset any
                            # already-initialised submodule so a previous build
                            # cannot leave it on a dirty/stale revision.
                            git submodule foreach --recursive 'git reset --hard || true'
                            git submodule foreach --recursive 'git clean -fd || true'

                            git submodule update \
                                --init \
                                --recursive \
                                --force

                            echo "[PEARZ] Submodule status:"
                            git submodule status --recursive

                            # This package is used as a Unity local dependency
                            # in projects that include this submodule. Verify it
                            # only when the path is declared in .gitmodules so
                            # other Pearz projects are not forced to contain it.
                            if git config -f .gitmodules \
                                --get-regexp '^submodule[.].*[.]path$' \
                                | awk '{print $2}' \
                                | grep -qx 'Packages/com.pearz.thirdparty'; then

                                PACKAGE_JSON="Packages/com.pearz.thirdparty/package.json"

                                if [ ! -f "$PACKAGE_JSON" ]; then
                                    echo "[PEARZ] ERROR: Missing $PACKAGE_JSON after submodule update."
                                    exit 1
                                fi

                                echo "[PEARZ] com.pearz.thirdparty ready."
                            fi

                            echo "[PEARZ] Git submodules ready."
                        '''
                    }
                }
            }
        }

        // ====================================================
        // ANDROID AAB
        // release/android
        // ====================================================

        stage('Android AAB') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android'
                }
            }

            steps {
                script {
                    buildAndroid()
                }
            }
        }

        // ====================================================
        // ANDROID APK
        // release/android-test
        // ====================================================

        stage('Android APK') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {
                script {
                    buildAndroid()
                }
            }
        }

        // ====================================================
        // IOS DEVICE
        // release/ios-test
        // ====================================================

        stage('iOS Device') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios-test'
                }
            }

            steps {

                // Optional: the build user's login password, so the
                // script can unlock the keychain Xcode keeps its
                // Apple ID token in. Without it xcodebuild reports
                // "No Accounts" from a Jenkins session.
                script {

                    def binding = [
                        string(
                            credentialsId: 'UMP_KEYCHAIN_PASSWORD',
                            variable: 'UMP_KEYCHAIN_PASSWORD'
                        )
                    ]

                    // Whether the credential exists at all. Probing
                    // it on its own keeps a real build failure from
                    // being mistaken for a missing credential.
                    def hasKeychain = true

                    try {

                        withCredentials(binding) { }

                    } catch (ignored) {

                        hasKeychain = false

                        echo '[PEARZ] No UMP_KEYCHAIN_PASSWORD credential - ' +
                             'add one if xcodebuild reports "No Accounts".'
                    }

                    def firebasePushEnabled =
                        params.IOS_TEST_ENABLE_FIREBASE_PUSH == true

                    def stripFirebasePush =
                        firebasePushEnabled ? '0' : '1'

                    echo '========================================'
                    echo '[PEARZ] iOS test Firebase integration: ' +
                         (firebasePushEnabled ?
                            'ENABLED - keep APNs + Crashlytics' :
                            'DISABLED - strip APNs + Crashlytics Run Script')
                    echo '========================================'

                    def run = {

                        // The strip runs between the two on purpose:
                        // Unity/Firebase packages add capabilities and the
                        // Crashlytics build phase from post-process callbacks.
                        // build_ios.sh also finishes CocoaPods first. The strip
                        // therefore runs on the final generated Xcode project and
                        // never edits the Unity project or Firebase package code.
                        withEnv([
                            "UMP_IOS_STRIP_FIREBASE_PUSH=${stripFirebasePush}"
                        ]) {
                            sh '''
                                chmod +x Jenkins/find_unity.sh
                                chmod +x Jenkins/build_ios.sh
                                chmod +x Jenkins/strip_ios_iap.sh
                                chmod +x Jenkins/install_ios_device.sh

                                ./Jenkins/build_ios.sh

                                ./Jenkins/strip_ios_iap.sh

                                ./Jenkins/install_ios_device.sh
                            '''
                        }
                    }

                    if (hasKeychain) {

                        withCredentials(binding) { run() }

                    } else {

                        run()
                    }
                }
            }
        }

        // ====================================================
        // IOS BUILD
        // release/ios
        // ====================================================

        stage('iOS TestFlight Build') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/find_unity.sh
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS ARCHIVE / EXPORT
        // ====================================================

        stage('iOS Archive / Export') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/archive_ios.sh
                    ./Jenkins/archive_ios.sh
                '''
            }
        }

        // ====================================================
        // TESTFLIGHT UPLOAD
        // ====================================================

        stage('TestFlight Upload') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/upload_testflight.sh
                    ./Jenkins/upload_testflight.sh
                '''
            }
        }

        // ====================================================
        // GOOGLE DRIVE UPLOAD
        // ====================================================

        // Android uploads its artifact (+ optional versioned BUILD_INFO).
        // iOS uploads only the stable <GameName>_BUILD_INFO.txt into IOS/.

        stage('Drive Upload') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/android' ||
                    env.BRANCH_NAME == 'release/android-test' ||
                    env.BRANCH_NAME == 'release/ios-test' ||
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                script {
                    def uploadFile = ''
                    def buildInfoOnly = false

                    // ------------------------------------------------
                    // Android AAB
                    // ------------------------------------------------
                    if (env.BRANCH_NAME == 'release/android') {
                        uploadFile = sh(
                            script: '''
                                find Builds/Android \
                                -type f \
                                -name "*.aab" \
                                2>/dev/null | head -n 1 || true
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    // ------------------------------------------------
                    // Android APK
                    // ------------------------------------------------
                    if (env.BRANCH_NAME == 'release/android-test') {
                        uploadFile = sh(
                            script: '''
                                find Builds/AndroidTest \
                                -type f \
                                -name "*.apk" \
                                2>/dev/null | head -n 1 || true
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    // ------------------------------------------------
                    // iOS: Drive receives BUILD_INFO only.
                    // No .app / .ipa is uploaded here. Both iOS branches
                    // overwrite the stable <GameName>_BUILD_INFO.txt in:
                    //   <Drive root>/<Game name>/IOS/
                    // ------------------------------------------------
                    if (env.BRANCH_NAME == 'release/ios-test' ||
                        env.BRANCH_NAME == 'release/ios') {

                        buildInfoOnly = true

                        uploadFile = sh(
                            script: '''
                                INFO="Builds/ump_build_info.txt"

                                if [ ! -f "$INFO" ]; then
                                    exit 0
                                fi

                                SAFE="$(awk -F= '/^PRODUCT_NAME_SAFE=/ {print $2; exit}' \
                                    "$INFO" | tr -d '\r')"
                                EXPORT_DIR="$(awk -F= '/^ARTIFACT=/ {print substr($0, index($0, "=") + 1); exit}' \
                                    "$INFO" | tr -d '\r')"

                                if [ -z "$SAFE" ] || [ -z "$EXPORT_DIR" ]; then
                                    exit 0
                                fi

                                IOS_ROOT="$(dirname "$EXPORT_DIR")"
                                TARGET="${IOS_ROOT}/${SAFE}_BUILD_INFO.txt"

                                # iOS BUILD_INFO sits beside the game Xcode export
                                # directory under Builds/iOS. Never synthesize/copy a
                                # fallback from Builds/ump_build_info.txt because
                                # that can upload metadata from the wrong location.
                                if [ ! -f "$TARGET" ]; then
                                    echo "[PEARZ] ERROR: iOS BUILD_INFO not found: $TARGET" >&2
                                    exit 1
                                fi

                                printf '%s\n' "$TARGET"
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    if (uploadFile && fileExists(uploadFile)) {
                        echo '========================================'
                        echo '[PEARZ] GOOGLE DRIVE UPLOAD'
                        echo "[PEARZ] File: ${uploadFile}"
                        if (buildInfoOnly) {
                            echo '[PEARZ] Mode: iOS BUILD_INFO only'
                            echo '[PEARZ] Drive: <Game name>/IOS/<GameName>_BUILD_INFO.txt'
                        }
                        echo '========================================'

                        try {
                            withCredentials([
                                string(
                                    credentialsId:
                                        'UMP_DRIVE_OAUTH_CLIENT_ID',
                                    variable:
                                        'UMP_DRIVE_OAUTH_CLIENT_ID'
                                ),
                                string(
                                    credentialsId:
                                        'UMP_DRIVE_OAUTH_CLIENT_SECRET',
                                    variable:
                                        'UMP_DRIVE_OAUTH_CLIENT_SECRET'
                                ),
                                string(
                                    credentialsId:
                                        'UMP_DRIVE_OAUTH_REFRESH_TOKEN',
                                    variable:
                                        'UMP_DRIVE_OAUTH_REFRESH_TOKEN'
                                ),
                                string(
                                    credentialsId:
                                        'UMP_DRIVE_FOLDER_ID',
                                    variable:
                                        'UMP_DRIVE_FOLDER_ID'
                                )
                            ]) {
                                withEnv([
                                    "PEARZ_ARTIFACT=${uploadFile}",
                                    "UMP_DRIVE_BUILD_INFO_ONLY=${buildInfoOnly ? '1' : '0'}"
                                ]) {
                                    sh '''
                                        chmod +x Jenkins/upload_drive.sh
                                        chmod +x Jenkins/upload_drive_impl.py

                                        ./Jenkins/upload_drive.sh \
                                            "$PEARZ_ARTIFACT"
                                    '''
                                }
                            }

                            echo '========================================'
                            echo '[PEARZ] Google Drive upload finished.'
                            echo '========================================'

                        } catch (Exception e) {
                            echo '========================================'
                            echo '[PEARZ] Google Drive upload FAILED.'
                            echo "[PEARZ] ${e.getMessage()}"
                            echo '[PEARZ] Build will NOT fail because'
                            echo '[PEARZ] Google Drive upload failed.'
                            echo '========================================'
                        }

                    } else {
                        echo '========================================'
                        echo '[PEARZ] No Drive upload file found.'
                        echo '[PEARZ] Google Drive upload skipped.'
                        echo '========================================'
                    }
                }
            }
        }
    }

    // ========================================================
    // POST
    // ========================================================

    post {

        always {

            script {

                // Pushes to other branches build automatically too;
                // stay silent for them.
                def branch = env.BRANCH_NAME ?: ''

                if (!branch.startsWith('release/')) {

                    echo "[PEARZ] ${branch}: no notification, no artifact."

                    return
                }

                def artifact = ''

                def found = sh(
                    script: '''
                        find Builds \
                        -type f -name "*.aab" -o \
                        -type f -name "*.apk" -o \
                        -type f -name "*.ipa" \
                        2>/dev/null | head -n 1 || true
                    ''',
                    returnStdout: true
                ).trim()

                if (found) {

                    artifact = "${env.WORKSPACE}/${found}"
                }

                def status =
                    currentBuild.currentResult ?: 'UNKNOWN'

                echo "========================================"
                echo "[PEARZ] BUILD RESULT"
                echo "[PEARZ] Status   : ${status}"
                echo "[PEARZ] Artifact : ${artifact}"
                echo "========================================"

                // =================================================
                // TELEGRAM
                // Telegram failure NEVER fails Jenkins build
                // =================================================

                try {

                    withCredentials([

                        string(
                            credentialsId:
                                'UMP_TELEGRAM_BOT_TOKEN',
                            variable:
                                'UMP_TELEGRAM_BOT_TOKEN'
                        ),

                        string(
                            credentialsId:
                                'UMP_TELEGRAM_CHAT_ID',
                            variable:
                                'UMP_TELEGRAM_CHAT_ID'
                        )

                    ]) {

                        withEnv([

                            "UMP_BUILD_STATUS=${status}",

                            "UMP_ARTIFACT=${artifact}"

                        ]) {

                            sh '''
                                chmod +x Jenkins/notify_telegram.sh

                                ./Jenkins/notify_telegram.sh || true
                            '''
                        }
                    }

                } catch (Exception e) {

                    echo "========================================"
                    echo "[PEARZ] Telegram notification FAILED."
                    echo "[PEARZ] ${e.getMessage()}"
                    echo "[PEARZ] Build result will NOT be changed."
                    echo "========================================"
                }

                // =================================================
                // JENKINS ARTIFACT ARCHIVE
                // =================================================

                archiveArtifacts(
                    artifacts:
                        'Builds/**/*.apk,' +
                        'Builds/**/*.aab,' +
                        'Builds/**/*.ipa,' +
                        'Builds/**/*_BUILD_INFO.txt,' +
                        'Builds/ump_build_info.txt,' +
                        'Builds/ump_build_info_drive_url.txt,' +
                        'Builds/ump_drive_url.txt',
                    allowEmptyArchive: true
                )
            }
        }
    }
}