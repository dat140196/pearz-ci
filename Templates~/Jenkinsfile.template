pipeline {

    agent any

    environment {
        UNITY_PATH = '**UMP_UNITY_PATH**'
        IOS_SCHEME = '**UMP_IOS_SCHEME**'
    }

    stages {

        stage('Validate Branch') {
            steps {
                script {
                    def allowedBranches = [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ]

                    if (!allowedBranches.contains(env.BRANCH_NAME)) {
                        error("Unsupported UMP branch: ${env.BRANCH_NAME}")
                    }

                    echo "Building branch: ${env.BRANCH_NAME}"
                }
            }
        }

        stage('Android AAB') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/android'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        stage('Android APK') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_android.sh
                    ./Jenkins/build_android.sh
                '''
            }
        }

        stage('iOS Device') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/ios-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        stage('iOS TestFlight Build') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        stage('iOS Archive / Export') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/archive_ios.sh
                    ./Jenkins/archive_ios.sh
                '''
            }
        }

        stage('TestFlight Upload') {
            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/upload_testflight.sh
                    ./Jenkins/upload_testflight.sh
                '''
            }
        }

        stage('Drive Upload') {
            steps {
                script {

                    def artifact = ''

                    if (env.BRANCH_NAME == 'release/android') {
                        artifact = 'Builds/Android/Game.aab'
                    }

                    if (env.BRANCH_NAME == 'release/android-test') {
                        artifact = 'Builds/AndroidTest/Game.apk'
                    }

                    if (env.BRANCH_NAME == 'release/ios') {
                        artifact = sh(
                            script: 'find Builds/iOSExport -type f -name "*.ipa" | head -n 1 || true',
                            returnStdout: true
                        ).trim()
                    }

                    if (artifact && fileExists(artifact)) {

                        echo "Uploading artifact to Google Drive:"
                        echo artifact

                        sh """
                            chmod +x Jenkins/upload_drive.sh
                            chmod +x Jenkins/upload_drive_impl.py
                            ./Jenkins/upload_drive.sh '${artifact}'
                        """

                    } else {

                        echo "No artifact found for Drive upload."
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                def artifact = ''

                if (env.BRANCH_NAME == 'release/android') {
                    artifact = "${env.WORKSPACE}/Builds/Android/Game.aab"
                }

                if (env.BRANCH_NAME == 'release/android-test') {
                    artifact = "${env.WORKSPACE}/Builds/AndroidTest/Game.apk"
                }

                if (env.BRANCH_NAME == 'release/ios') {
                    artifact = sh(
                        script: 'find Builds/iOSExport -type f -name "*.ipa" | head -n 1 || true',
                        returnStdout: true
                    ).trim()

                    if (artifact) {
                        artifact = "${env.WORKSPACE}/${artifact}"
                    }
                }

                def status = currentBuild.currentResult

                echo "Build status: ${status}"
                echo "Artifact: ${artifact}"

                sh """
                    chmod +x Jenkins/notify_telegram.sh

                    UMP_BUILD_STATUS='${status}' \
                    UMP_ARTIFACT='${artifact}' \
                    ./Jenkins/notify_telegram.sh || true
                """
            }

            archiveArtifacts(
                artifacts: 'Builds/**/*.apk,Builds/**/*.aab,Builds/**/*.ipa',
                allowEmptyArchive: true
            )
        }
    }
}