// ============================================================
// ANDROID BUILD + SIGNING
//
// Unity does not create a release keystore and does not keep
// keystore passwords in the project.
//
// Default (recommended for several projects on one Jenkins):
// no credential at all. Jenkins/resolve_keystore.sh picks the
// keystore out of ~/.pearz/keystores by applicationIdentifier,
// so a new project only means two more files on the Mac.
//
// Optional per-job override, e.g. one Jenkins folder per game:
//   UMP_ANDROID_KEYSTORE          Secret file (.keystore / .jks)
//   UMP_ANDROID_KEYSTORE_PASS     Secret text
//   UMP_ANDROID_KEY_ALIAS         Secret text
//   UMP_ANDROID_KEY_ALIAS_PASS    Secret text
//
// With neither, a test APK still builds with the Android debug
// key; an AAB fails, because Google Play rejects debug signing.
// ============================================================

def buildAndroid() {

    def signed = true

    // Probe first: a missing credential must not be confused with
    // a failing Unity build.
    try {

        withCredentials([
            file(
                credentialsId: 'UMP_ANDROID_KEYSTORE',
                variable: 'UMP_KEYSTORE_PROBE'
            )
        ]) {
            echo '[PEARZ] Android keystore credential found.'
        }

    } catch (Exception e) {

        signed = false

        echo '[PEARZ] No UMP_ANDROID_KEYSTORE credential.'
        echo '[PEARZ] Falling back to the keystore store on this machine.'
    }

    if (!signed) {

        sh '''
            chmod +x Jenkins/find_unity.sh
            chmod +x Jenkins/build_android.sh
            ./Jenkins/build_android.sh
        '''

        return
    }

    withCredentials([

        file(
            credentialsId: 'UMP_ANDROID_KEYSTORE',
            variable: 'UMP_ANDROID_KEYSTORE'
        ),

        string(
            credentialsId: 'UMP_ANDROID_KEYSTORE_PASS',
            variable: 'UMP_ANDROID_KEYSTORE_PASS'
        ),

        string(
            credentialsId: 'UMP_ANDROID_KEY_ALIAS',
            variable: 'UMP_ANDROID_KEY_ALIAS'
        ),

        string(
            credentialsId: 'UMP_ANDROID_KEY_ALIAS_PASS',
            variable: 'UMP_ANDROID_KEY_ALIAS_PASS'
        )

    ]) {

        sh '''
            chmod +x Jenkins/find_unity.sh
            chmod +x Jenkins/build_android.sh
            ./Jenkins/build_android.sh
        '''
    }
}

pipeline {

    agent any

    options {

        // A push while a build is running must queue, never start a
        // second Unity on the same workspace.
        disableConcurrentBuilds()

        // Builds are 80 MB+, do not fill the Mac disk.
        buildDiscarder(
            logRotator(
                numToKeepStr: '15',
                artifactNumToKeepStr: '3'
            )
        )
    }

    triggers {

        // Auto build on push. The webhook from the Git host triggers
        // instantly; this polling is the fallback when no webhook is
        // configured. Polling only starts after the first build of
        // the branch.
        pollSCM('H/2 * * * *')
    }

    stages {

        // ====================================================
        // VALIDATE BRANCH
        // ====================================================

        stage('Validate Branch') {
            steps {
                script {

                    def allowedBranches = [
                        'release/android',
                        'release/android-test',
                        'release/ios-test',
                        'release/ios'
                    ]

                    // Every branch is built automatically on push, so
                    // a non-release branch is skipped quietly instead
                    // of failing the build.
                    if (!allowedBranches.contains(env.BRANCH_NAME)) {

                        echo "========================================"
                        echo "[PEARZ] Branch not handled by UMP:"
                        echo "[PEARZ] ${env.BRANCH_NAME}"
                        echo "[PEARZ] Nothing to build."
                        echo "========================================"

                        currentBuild.result = 'NOT_BUILT'

                    } else {

                        echo "========================================"
                        echo "[PEARZ] BUILD"
                        echo "[PEARZ] Branch: ${env.BRANCH_NAME}"
                        echo "========================================"
                    }
                }
            }
        }

        // ====================================================
        // ANDROID AAB
        // release/android
        // ====================================================

        stage('Android AAB') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android'
                }
            }

            steps {
                script {
                    buildAndroid()
                }
            }
        }

        // ====================================================
        // ANDROID APK
        // release/android-test
        // ====================================================

        stage('Android APK') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {
                script {
                    buildAndroid()
                }
            }
        }

        // ====================================================
        // IOS DEVICE
        // release/ios-test
        // ====================================================

        stage('iOS Device') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios-test'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/find_unity.sh
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS BUILD
        // release/ios
        // ====================================================

        stage('iOS TestFlight Build') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/find_unity.sh
                    chmod +x Jenkins/build_ios.sh
                    ./Jenkins/build_ios.sh
                '''
            }
        }

        // ====================================================
        // IOS ARCHIVE / EXPORT
        // ====================================================

        stage('iOS Archive / Export') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/archive_ios.sh
                    ./Jenkins/archive_ios.sh
                '''
            }
        }

        // ====================================================
        // TESTFLIGHT UPLOAD
        // ====================================================

        stage('TestFlight Upload') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/ios'
                }
            }

            steps {
                sh '''
                    chmod +x Jenkins/upload_testflight.sh
                    ./Jenkins/upload_testflight.sh
                '''
            }
        }

        // ====================================================
        // GOOGLE DRIVE UPLOAD
        // ====================================================

        // Android only: iOS ships through TestFlight / direct
        // install, so no Drive copy is needed there.

        stage('Drive Upload') {

            when {
                expression {
                    env.BRANCH_NAME == 'release/android' ||
                    env.BRANCH_NAME == 'release/android-test'
                }
            }

            steps {

                script {

                    def artifact = ''

                    // ------------------------------------------------
                    // Android AAB
                    // ------------------------------------------------

                    if (env.BRANCH_NAME == 'release/android') {

                        artifact = sh(
                            script: '''
                                find Builds/Android \
                                -type f \
                                -name "*.aab" \
                                2>/dev/null | head -n 1 || true
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    // ------------------------------------------------
                    // Android APK
                    // ------------------------------------------------

                    if (env.BRANCH_NAME == 'release/android-test') {

                        artifact = sh(
                            script: '''
                                find Builds/AndroidTest \
                                -type f \
                                -name "*.apk" \
                                2>/dev/null | head -n 1 || true
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    // ------------------------------------------------
                    // Upload
                    // ------------------------------------------------

                    if (artifact && fileExists(artifact)) {

                        echo "========================================"
                        echo "[PEARZ] GOOGLE DRIVE UPLOAD"
                        echo "[PEARZ] Artifact: ${artifact}"
                        echo "========================================"

                        try {

                            withCredentials([

                                string(
                                    credentialsId:
                                        'UMP_DRIVE_SERVICE_ACCOUNT_JSON',
                                    variable:
                                        'UMP_DRIVE_SERVICE_ACCOUNT_JSON'
                                ),

                                string(
                                    credentialsId:
                                        'UMP_DRIVE_FOLDER_ID',
                                    variable:
                                        'UMP_DRIVE_FOLDER_ID'
                                )

                            ]) {

                                withEnv([
                                    "PEARZ_ARTIFACT=${artifact}"
                                ]) {

                                    sh '''
                                        chmod +x Jenkins/upload_drive.sh
                                        chmod +x Jenkins/upload_drive_impl.py

                                        ./Jenkins/upload_drive.sh \
                                            "$PEARZ_ARTIFACT"
                                    '''
                                }
                            }

                            echo "========================================"
                            echo "[PEARZ] Google Drive upload finished."
                            echo "========================================"

                        } catch (Exception e) {

                            echo "========================================"
                            echo "[PEARZ] Google Drive upload FAILED."
                            echo "[PEARZ] ${e.getMessage()}"
                            echo "[PEARZ] Build will NOT fail because"
                            echo "[PEARZ] Google Drive upload failed."
                            echo "========================================"
                        }

                    } else {

                        echo "========================================"
                        echo "[PEARZ] No artifact found."
                        echo "[PEARZ] Google Drive upload skipped."
                        echo "========================================"
                    }
                }
            }
        }
    }

    // ========================================================
    // POST
    // ========================================================

    post {

        always {

            script {

                // Pushes to other branches build automatically too;
                // stay silent for them.
                def branch = env.BRANCH_NAME ?: ''

                if (!branch.startsWith('release/')) {

                    echo "[PEARZ] ${branch}: no notification, no artifact."

                    return
                }

                def artifact = ''

                def found = sh(
                    script: '''
                        find Builds \
                        -type f -name "*.aab" -o \
                        -type f -name "*.apk" -o \
                        -type f -name "*.ipa" \
                        2>/dev/null | head -n 1 || true
                    ''',
                    returnStdout: true
                ).trim()

                if (found) {

                    artifact = "${env.WORKSPACE}/${found}"
                }

                def status =
                    currentBuild.currentResult ?: 'UNKNOWN'

                echo "========================================"
                echo "[PEARZ] BUILD RESULT"
                echo "[PEARZ] Status   : ${status}"
                echo "[PEARZ] Artifact : ${artifact}"
                echo "========================================"

                // =================================================
                // TELEGRAM
                // Telegram failure NEVER fails Jenkins build
                // =================================================

                try {

                    withCredentials([

                        string(
                            credentialsId:
                                'UMP_TELEGRAM_BOT_TOKEN',
                            variable:
                                'UMP_TELEGRAM_BOT_TOKEN'
                        ),

                        string(
                            credentialsId:
                                'UMP_TELEGRAM_CHAT_ID',
                            variable:
                                'UMP_TELEGRAM_CHAT_ID'
                        )

                    ]) {

                        withEnv([

                            "UMP_BUILD_STATUS=${status}",

                            "UMP_ARTIFACT=${artifact}"

                        ]) {

                            sh '''
                                chmod +x Jenkins/notify_telegram.sh

                                ./Jenkins/notify_telegram.sh || true
                            '''
                        }
                    }

                } catch (Exception e) {

                    echo "========================================"
                    echo "[PEARZ] Telegram notification FAILED."
                    echo "[PEARZ] ${e.getMessage()}"
                    echo "[PEARZ] Build result will NOT be changed."
                    echo "========================================"
                }

                // =================================================
                // JENKINS ARTIFACT ARCHIVE
                // =================================================

                archiveArtifacts(
                    artifacts:
                        'Builds/**/*.apk,' +
                        'Builds/**/*.aab,' +
                        'Builds/**/*.ipa',
                    allowEmptyArchive: true
                )
            }
        }
    }
}