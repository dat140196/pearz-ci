#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ iOS - build the Unity generated Xcode project, sign it
# with the configured team, install on a connected iPhone, and
# optionally launch it.
#
# Jenkins/strip_ios_iap.sh must run before this script on
# release/ios-test. The Unity export step removes StoreKit.framework
# from the Unity-iPhone app target, and the strip script removes any
# remaining local IAP capability marker while preserving signing.
#
# Optional env vars:
#   UMP_IOS_PROJECT
#   IOS_SCHEME=Unity-iPhone
#   UMP_IOS_CONFIGURATION=Release
#   UMP_IOS_DEVICE_UDID
#   UMP_IOS_DEVICE_NAME
#   UMP_IOS_DEVICE_TIMEOUT=60
#   UMP_IOS_TEAM_ID
#   UMP_KEYCHAIN_PASSWORD
#   UMP_IOS_LAUNCH=0
#   UMP_ASC_KEY_PATH / UMP_ASC_KEY_ID / UMP_ASC_ISSUER_ID
# ============================================================

echo "========================================"
echo "[PEARZ] iOS install on device"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"
DERIVED="$WORKSPACE/Builds/iOSDerived"

if [ -n "${UMP_KEYCHAIN_PASSWORD:-}" ]; then
    if security unlock-keychain \
        -p "$UMP_KEYCHAIN_PASSWORD" \
        "$HOME/Library/Keychains/login.keychain-db" \
        >/dev/null 2>&1; then
        echo "[PEARZ] Login keychain unlocked."
    else
        echo "[PEARZ] WARNING: could not unlock login keychain."
    fi
fi

PROJECT="${UMP_IOS_PROJECT:-}"
if [ -z "$PROJECT" ]; then
    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project under $WORKSPACE/Builds/iOS"
    exit 1
fi

SCHEME="${IOS_SCHEME:-Unity-iPhone}"
if ! xcodebuild -list -project "$PROJECT" 2>/dev/null \
    | grep -q "^[[:space:]]*$SCHEME[[:space:]]*$"; then
    SCHEMES="$(xcodebuild -list -project "$PROJECT" 2>/dev/null \
        | awk '/Schemes:/ {found=1; next} found && !NF {exit} found {gsub(/^[ \t]+|[ \t]+$/, ""); print}')"

    if echo "$SCHEMES" | grep -qx "Unity-iPhone"; then
        SCHEME="Unity-iPhone"
    else
        SCHEME="$(echo "$SCHEMES" \
            | grep -vxE 'GameAssembly|UnityFramework|Pods-.*' \
            | head -n 1 || true)"
    fi
fi

if [ -z "$SCHEME" ]; then
    echo "[PEARZ] ERROR: no app scheme found."
    exit 1
fi

SETTINGS="$(xcodebuild -showBuildSettings \
    -project "$PROJECT" \
    -scheme "$SCHEME" \
    -configuration "$CONFIGURATION" \
    2>/dev/null || true)"

BUNDLE_ID="$(echo "$SETTINGS" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

TEAM="${UMP_IOS_TEAM_ID:-}"
TEAM_SOURCE="UMP_IOS_TEAM_ID"

if [ -z "$TEAM" ]; then
    TEAM="$(echo "$SETTINGS" \
        | awk -F' = ' '/ DEVELOPMENT_TEAM = / {print $2; exit}' \
        | tr -d ' \r' || true)"
    TEAM_SOURCE="Xcode project"
fi

if [ -z "$TEAM" ]; then
    PBXPROJ="$PROJECT/project.pbxproj"
    TEAM="$(grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam)[ \t]*=[ \t]*"?[A-Z0-9]{10}' \
        "$PBXPROJ" 2>/dev/null \
        | grep -oE '[A-Z0-9]{10}$' \
        | head -n 1 || true)"
    TEAM_SOURCE="project.pbxproj"
fi

if [ -z "$TEAM" ]; then
    echo "[PEARZ] ERROR: no DEVELOPMENT_TEAM found."
    echo "[PEARZ] Set UMP_IOS_TEAM_ID or select the team once in Xcode."
    exit 1
fi

echo "[PEARZ] Project       : $PROJECT"
echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"
echo "[PEARZ] Bundle id     : ${BUNDLE_ID:-<unknown>}"
echo "[PEARZ] Team          : $TEAM ($TEAM_SOURCE)"

# ------------------------------------------------------------
# Device discovery
# ------------------------------------------------------------
find_device_devicectl() {
    local json
    local i=0
    local udid
    local name
    local state

    xcrun devicectl --version >/dev/null 2>&1 || return 0

    json="$(mktemp "${TMPDIR:-/tmp}/ump-devices-XXXXXX")"
    if ! xcrun devicectl list devices --json-output "$json" \
        >/dev/null 2>&1; then
        rm -f "$json"
        return 0
    fi

    while [ "$i" -lt 32 ]; do
        udid="$(plutil -extract "result.devices.$i.hardwareProperties.udid" \
            raw "$json" 2>/dev/null || true)"
        [ -n "$udid" ] || break

        name="$(plutil -extract "result.devices.$i.deviceProperties.name" \
            raw "$json" 2>/dev/null || true)"
        state="$(plutil -extract "result.devices.$i.connectionProperties.pairingState" \
            raw "$json" 2>/dev/null || true)"

        [ -n "$name" ] || name="iPhone"
        [ -n "$state" ] || state="unknown"

        echo "$name|$state|$udid"
        i=$((i + 1))
    done

    rm -f "$json"
}

find_device_xctrace() {
    xcrun xctrace list devices 2>/dev/null \
        | awk '/^== Devices ==/ {found=1; next} /^== / {found=0} found {print}' \
        | grep -E '\([0-9]+(\.[0-9]+)+\) \([0-9A-Za-z-]+\)[[:space:]]*$' \
        | sed -E 's/^(.*) \([^)]*\) \(([0-9A-Za-z-]+)\)[[:space:]]*$/\1|connected|\2/' \
        || true
}

UDID="${UMP_IOS_DEVICE_UDID:-}"
DEVICE_NAME="${UMP_IOS_DEVICE_NAME:-}"

if [ -z "$UDID" ]; then
    WAIT_FOR="${UMP_IOS_DEVICE_TIMEOUT:-60}"
    WAITED=0
    DEVICE_LINES=""

    while [ -z "$DEVICE_LINES" ] && [ "$WAITED" -le "$WAIT_FOR" ]; do
        DEVICE_LINES="$(find_device_devicectl)"
        if [ -z "$DEVICE_LINES" ]; then
            DEVICE_LINES="$(find_device_xctrace)"
        fi

        if [ -n "$DEVICE_NAME" ]; then
            DEVICE_LINES="$(echo "$DEVICE_LINES" \
                | grep -F "$DEVICE_NAME" || true)"
        fi

        [ -n "$DEVICE_LINES" ] && break
        [ "$WAITED" -ge "$WAIT_FOR" ] && break

        if [ "$WAITED" -eq 0 ]; then
            echo "[PEARZ] Waiting up to ${WAIT_FOR}s for an iOS device..."
        fi

        sleep 3
        WAITED=$((WAITED + 3))
    done

    if [ -z "$DEVICE_LINES" ]; then
        echo "[PEARZ] ERROR: no connected iOS device detected."
        xcrun devicectl list devices 2>/dev/null || true
        xcrun xctrace list devices 2>/dev/null || true
        exit 1
    fi

    DEVICE_LINE="$(echo "$DEVICE_LINES" | head -n 1)"
    DEVICE_NAME="$(echo "$DEVICE_LINE" | cut -d'|' -f1)"
    UDID="$(echo "$DEVICE_LINE" | awk -F'|' '{print $NF}')"
fi

echo "[PEARZ] Device        : ${DEVICE_NAME:-iPhone}"
echo "[PEARZ] Device UDID   : $UDID"

# ------------------------------------------------------------
# Build
# ------------------------------------------------------------
rm -rf "$DERIVED"
mkdir -p "$DERIVED"

BUILD_ARGS=(
    -project "$PROJECT"
    -scheme "$SCHEME"
    -configuration "$CONFIGURATION"
    -destination "id=$UDID"
    -derivedDataPath "$DERIVED"
    -allowProvisioningUpdates
    "DEVELOPMENT_TEAM=$TEAM"
    "CODE_SIGN_STYLE=Automatic"
)

if [ -n "${UMP_ASC_KEY_PATH:-}" ] && \
   [ -n "${UMP_ASC_KEY_ID:-}" ] && \
   [ -n "${UMP_ASC_ISSUER_ID:-}" ]; then
    BUILD_ARGS+=(
        -authenticationKeyPath "$UMP_ASC_KEY_PATH"
        -authenticationKeyID "$UMP_ASC_KEY_ID"
        -authenticationKeyIssuerID "$UMP_ASC_ISSUER_ID"
    )
fi

BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/ump-xcodebuild-XXXXXX")"

echo "========================================"
echo "[PEARZ] xcodebuild"
echo "========================================"

if ! xcodebuild "${BUILD_ARGS[@]}" build 2>&1 | tee "$BUILD_LOG"; then
    echo "[PEARZ] ERROR: xcodebuild failed."

    if grep -q "In-App Purchase capability" "$BUILD_LOG"; then
        echo "[PEARZ] IAP signing is still being requested."
        echo "[PEARZ] Bundle id: ${BUNDLE_ID:-<unknown>}"
        echo "[PEARZ] Check the Unity log for:"
        echo "[PEARZ]   Removed StoreKit.framework from Unity-iPhone target only."
        echo "[PEARZ] Then check Jenkins/strip_ios_iap.sh diagnostics immediately above."
    fi

    if grep -qE 'No Accounts|No profiles for|requires a development team' "$BUILD_LOG"; then
        echo "[PEARZ] Signing account/profile problem detected."
        echo "[PEARZ] Ensure Xcode is signed in for team $TEAM and the Jenkins"
        echo "[PEARZ] user can access its login keychain."
    fi

    rm -f "$BUILD_LOG"
    exit 1
fi

rm -f "$BUILD_LOG"

# ------------------------------------------------------------
# Find app
# ------------------------------------------------------------
APP="$(find "$DERIVED/Build/Products/$CONFIGURATION-iphoneos" \
    -maxdepth 1 \
    -type d \
    -name "*.app" \
    2>/dev/null | head -n 1 || true)"

if [ -z "$APP" ]; then
    echo "[PEARZ] ERROR: built .app not found."
    exit 1
fi

APP_BUNDLE_ID="$(/usr/libexec/PlistBuddy \
    -c 'Print :CFBundleIdentifier' \
    "$APP/Info.plist" 2>/dev/null || true)"

echo "[PEARZ] App           : $APP"
echo "[PEARZ] App bundle id : ${APP_BUNDLE_ID:-<unknown>}"

# ------------------------------------------------------------
# Install
# ------------------------------------------------------------
INSTALLED=0

if xcrun devicectl --version >/dev/null 2>&1; then
    echo "[PEARZ] Installing with devicectl..."
    if xcrun devicectl device install app \
        --device "$UDID" \
        "$APP"; then
        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ] && command -v ios-deploy >/dev/null 2>&1; then
    echo "[PEARZ] Installing with ios-deploy..."
    if ios-deploy --id "$UDID" --bundle "$APP" --no-wifi; then
        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ]; then
    echo "[PEARZ] ERROR: app installation failed."
    echo "[PEARZ] Unlock the device and confirm Trust/Developer Mode."
    exit 1
fi

echo "[PEARZ] Installed on $UDID"

# ------------------------------------------------------------
# Launch, best effort
# ------------------------------------------------------------
if [ "${UMP_IOS_LAUNCH:-1}" != "0" ] && [ -n "$APP_BUNDLE_ID" ]; then
    echo "[PEARZ] Launching $APP_BUNDLE_ID..."
    xcrun devicectl device process launch \
        --device "$UDID" \
        "$APP_BUNDLE_ID" || \
        echo "[PEARZ] Launch skipped; install succeeded."
fi

echo "========================================"
echo "[PEARZ] iOS device install finished"
echo "========================================"
