#!/bin/bash

set -euo pipefail

# ============================================================
# PEARZ iOS - compile the Xcode project Unity generated and
# install it on a device plugged into the Jenkins Mac.
# Used by release/ios-test.
#
# Optional Jenkins env vars:
#   UMP_IOS_DEVICE_UDID   pick one device when several are
#                         attached, and skip detection entirely
#   UMP_IOS_DEVICE_NAME   ... or pick it by name
#   UMP_IOS_DEVICE_TIMEOUT
#                         seconds to wait for the device to appear
#                         after the Unity build (60)
#   UMP_IOS_TEAM_ID       Apple Developer team for automatic signing
#   UMP_IOS_CONFIGURATION Release (default) or Debug
#   UMP_IOS_LAUNCH=0      install only, do not start the app
#   UMP_KEYCHAIN_PASSWORD login password of the build user, to
#                         unlock the keychain Xcode keeps its
#                         account token in
#   UMP_IOS_STRIP_CAPABILITIES
#                         capabilities to delete from the project
#                         before building, because the team cannot
#                         sign them (In-App Purchase by default;
#                         "" keeps every capability)
# ============================================================

echo "========================================"
echo "[PEARZ] iOS install on device"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"

# Jenkins runs outside the GUI session the Apple ID was signed in
# from, and there the login keychain is locked - the Xcode account
# token inside it is then invisible and xcodebuild reports "No
# Accounts" however many accounts Xcode shows on screen.
if [ -n "${UMP_KEYCHAIN_PASSWORD:-}" ]; then

    if security unlock-keychain -p "$UMP_KEYCHAIN_PASSWORD" \
        "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null; then

        echo "[PEARZ] Login keychain unlocked."

    else

        echo "[PEARZ] WARNING: could not unlock the login keychain."
        echo "[PEARZ] Check UMP_KEYCHAIN_PASSWORD."
    fi
fi

# Unity exports to Builds/iOS/<Game name>, so look the project up
# instead of assuming a fixed path.
PROJECT="${UMP_IOS_PROJECT:-}"

if [ -z "$PROJECT" ]; then

    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project under"
    echo "$WORKSPACE/Builds/iOS"
    echo "[PEARZ] Run the Unity iOS build first."
    exit 1
fi

DERIVED="$WORKSPACE/Builds/iOSDerived"

echo "[PEARZ] Project      : $PROJECT"

# ------------------------------------------------------------
# Scheme
# ------------------------------------------------------------

#
# A Unity project ships several schemes - GameAssembly and
# UnityFramework are libraries and never produce a .app, so
# picking the first one in the list builds the wrong thing.
#

SCHEME="${IOS_SCHEME:-}"

if [ -z "$SCHEME" ]; then

    SCHEMES="$(xcodebuild -list -project "$PROJECT" 2>/dev/null \
        | awk '/Schemes:/ {found=1; next} found && !NF {exit} found {
            gsub(/^[ \t]+|[ \t]+$/, ""); print }')"

    if echo "$SCHEMES" | grep -qx "Unity-iPhone"; then

        SCHEME="Unity-iPhone"

    else

        SCHEME="$(echo "$SCHEMES" \
            | grep -vxE "GameAssembly|UnityFramework|Pods-.*" \
            | head -n 1 || true)"
    fi
fi

[ -n "$SCHEME" ] || SCHEME="Unity-iPhone"

echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"

SETTINGS="$(xcodebuild -showBuildSettings \
    -project "$PROJECT" \
    -scheme "$SCHEME" 2>/dev/null || true)"

BUNDLE_ID="$(echo "$SETTINGS" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

[ -n "$BUNDLE_ID" ] && echo "[PEARZ] Bundle id    : $BUNDLE_ID"

PBXPROJ="$PROJECT/project.pbxproj"

# ------------------------------------------------------------
# Device
#
# xctrace lists physical devices as
#   <name> (<ios version>) (<udid>)
# while the host Mac has no version, which is what separates
# them. Offline devices sit in their own section.
#
# xctrace is the old interface though, and it files a perfectly
# reachable iOS 17+ device under "Offline" - devicectl is asked
# whenever it comes up empty.
#
# Waiting on top of that covers the seconds right after the Unity
# build, which tears down a usbmuxd session of its own as the
# editor exits. It costs nothing when the device is already there.
# ------------------------------------------------------------

list_devices_xctrace() {

    xcrun xctrace list devices 2>/dev/null \
        | awk '/^== Devices ==/ {found=1; next} /^== / {found=0} found {print}' \
        | grep -E '\([0-9]+(\.[0-9]+)+\) \([0-9A-Za-z-]+\)[[:space:]]*$' || true
}

# devicectl is the service Xcode 15 and up actually talks to, and
# it reports devices xctrace files under "Offline" - an iPhone on
# iOS 17+ is often only visible here. The table it prints carries
# a CoreDevice UUID rather than the UDID xcodebuild wants, so the
# UDID is read out of the JSON instead.
#
# Printed in the same shape as xctrace, so either source feeds the
# same parsing below: <name> (<state>) (<udid>)
list_devices_devicectl() {

    local json
    local i=0
    local udid
    local name
    local state

    xcrun devicectl --version >/dev/null 2>&1 || return 0

    json="$(mktemp "${TMPDIR:-/tmp}/ump-devices-XXXXXX")"

    if ! xcrun devicectl list devices --json-output "$json" \
        >/dev/null 2>&1; then

        rm -f "$json"
        return 0
    fi

    # plutil cannot count an array, so the list ends where the
    # extraction stops returning a UDID.
    while [ "$i" -lt 16 ]; do

        udid="$(plutil -extract "result.devices.$i.hardwareProperties.udid" \
            raw "$json" 2>/dev/null || true)"

        [ -n "$udid" ] || break

        name="$(plutil -extract "result.devices.$i.deviceProperties.name" \
            raw "$json" 2>/dev/null || true)"

        state="$(plutil -extract \
            "result.devices.$i.connectionProperties.pairingState" \
            raw "$json" 2>/dev/null || true)"

        [ -n "$name" ] || name="iPhone"
        [ -n "$state" ] || state="unknown"

        echo "$name ($state) ($udid)"

        i=$((i + 1))
    done

    rm -f "$json"
}

list_devices() {

    local lines

    lines="$(list_devices_xctrace)"

    if [ -z "$lines" ]; then

        lines="$(list_devices_devicectl)"

        if [ -n "$lines" ]; then
            echo "[PEARZ] Device found through devicectl, not xctrace." >&2
        fi
    fi

    if [ -n "${UMP_IOS_DEVICE_NAME:-}" ]; then

        lines="$(echo "$lines" | grep -F "$UMP_IOS_DEVICE_NAME" || true)"
    fi

    echo "$lines"
}

UDID="${UMP_IOS_DEVICE_UDID:-}"

if [ -z "$UDID" ]; then

    DEVICE_LINES="$(list_devices)"

    WAIT_FOR="${UMP_IOS_DEVICE_TIMEOUT:-60}"
    WAITED=0

    while [ -z "$DEVICE_LINES" ] && [ "$WAITED" -lt "$WAIT_FOR" ]; do

        if [ "$WAITED" -eq 0 ]; then
            echo "[PEARZ] No device yet - waiting up to ${WAIT_FOR}s for it"
            echo "[PEARZ] to come back after the Unity build."
        fi

        sleep 3

        WAITED=$((WAITED + 3))

        DEVICE_LINES="$(list_devices)"
    done

    if [ -n "$DEVICE_LINES" ] && [ "$WAITED" -gt 0 ]; then
        echo "[PEARZ] Device showed up after ${WAITED}s."
    fi

    if [ -z "$DEVICE_LINES" ]; then

        echo "[PEARZ] ERROR: no iOS device detected."

        # A device that is paired but locked, unplugged or asleep
        # is listed under its own heading rather than missing, and
        # that says which of the two problems this is.
        OFFLINE="$(xcrun xctrace list devices 2>/dev/null \
            | awk '/^== Devices Offline ==/ {found=1; next} /^== / {found=0} found {print}' \
            | grep -E '\([0-9A-Za-z-]+\)[[:space:]]*$' || true)"

        if [ -n "$OFFLINE" ]; then

            echo "[PEARZ] Paired with this Mac but offline after"
            echo "[PEARZ] ${WAITED}s of waiting:"
            echo "$OFFLINE" | sed 's|^|[PEARZ]   |'
            echo "[PEARZ] devicectl did not list it either, so the"
            echo "[PEARZ] device really is unreachable from here."
            echo "[PEARZ] Unplug and plug the cable once, and set"
            echo "[PEARZ] UMP_IOS_DEVICE_UDID to skip detection and let"
            echo "[PEARZ] xcodebuild talk to the device directly."

        else

            echo "[PEARZ] Check that the device is plugged in, unlocked,"
            echo "[PEARZ] and that it trusts this Mac."
        fi

        echo "[PEARZ] Devices seen by Xcode:"
        xcrun xctrace list devices 2>/dev/null || true

        # xctrace and devicectl ask different services, so a device
        # missing from one is often listed by the other.
        echo "[PEARZ] Devices seen by devicectl:"
        xcrun devicectl list devices 2>/dev/null || true

        exit 1
    fi

    COUNT="$(echo "$DEVICE_LINES" | grep -c . || true)"

    if [ "$COUNT" -gt 1 ]; then
        echo "[PEARZ] Several devices attached:"
        echo "$DEVICE_LINES"
        echo "[PEARZ] Using the first one."
        echo "[PEARZ] Set UMP_IOS_DEVICE_UDID or UMP_IOS_DEVICE_NAME to choose."
    fi

    DEVICE_LINE="$(echo "$DEVICE_LINES" | head -n 1)"

    UDID="$(echo "$DEVICE_LINE" \
        | sed -E 's/.*\(([0-9A-Za-z-]+)\)[[:space:]]*$/\1/')"

    DEVICE_NAME="$(echo "$DEVICE_LINE" \
        | sed -E 's/ \([^)]*\) \([^)]*\)[[:space:]]*$//')"

    echo "[PEARZ] Device       : $DEVICE_NAME"
fi

echo "[PEARZ] Device UDID  : $UDID"

# ------------------------------------------------------------
# Provisioning pre-flight
#
# A signing certificate in the keychain is not enough: to create
# a provisioning profile, Xcode needs an Apple ID signed in as
# the user Jenkins runs as, or an App Store Connect API key.
# ------------------------------------------------------------

PROFILE_DIRS=(
    "$HOME/Library/MobileDevice/Provisioning Profiles"
    "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"
)

# Name of a profile on this Mac that covers the bundle id, which
# is also what manual signing needs to be handed later on.
find_profile_for() {

    local bundle="$1"
    local dir
    local profile
    local plist
    local app_id
    local name

    [ -n "$bundle" ] || return 1

    for dir in "${PROFILE_DIRS[@]}"; do

        [ -d "$dir" ] || continue

        for profile in "$dir"/*.mobileprovision; do

            [ -f "$profile" ] || continue

            plist="$(security cms -D -i "$profile" 2>/dev/null || true)"

            [ -n "$plist" ] || continue

            app_id="$(echo "$plist" \
                | plutil -extract Entitlements.application-identifier raw - \
                    2>/dev/null || true)"

            [ -n "$app_id" ] || continue

            # A wildcard profile carries no capability of its own,
            # so it signs this build just as well.
            case "$app_id" in
                *".$bundle"|*".*") ;;
                *) continue ;;
            esac

            name="$(echo "$plist" \
                | plutil -extract Name raw - 2>/dev/null || true)"

            [ -n "$name" ] || continue

            echo "$name"
            return 0
        done
    done

    return 1
}

has_profile_for() {

    [ -n "$(find_profile_for "$1" || true)" ]
}

USING_API_KEY=0

if [ -n "${UMP_ASC_KEY_PATH:-}" ] && \
   [ -n "${UMP_ASC_KEY_ID:-}" ] && \
   [ -n "${UMP_ASC_ISSUER_ID:-}" ]; then

    USING_API_KEY=1
fi

# ------------------------------------------------------------
# Build for that device
# ------------------------------------------------------------

BUILD_ARGS=(
    -project "$PROJECT"
    -scheme "$SCHEME"
    -configuration "$CONFIGURATION"
    -destination "id=$UDID"
    -derivedDataPath "$DERIVED"
    -allowProvisioningUpdates
)

# Reads the team out of the signing certificates installed on this
# Mac. The team id is the OU of an Apple Development certificate.
detect_team() {

    local names
    local team
    local found=""

    names="$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Apple Development[^"]*\)".*/\1/p
                  s/.*"\(iPhone Developer[^"]*\)".*/\1/p')"

    [ -n "$names" ] || return 0

    while IFS= read -r name; do

        [ -n "$name" ] || continue

        team="$(security find-certificate -c "$name" -p 2>/dev/null \
            | openssl x509 -noout -subject 2>/dev/null \
            | tr '/,' '\n\n' \
            | sed -n 's/^[[:space:]]*OU[[:space:]]*=[[:space:]]*\([A-Z0-9]\{10\}\).*/\1/p' \
            | head -n 1)"

        [ -n "$team" ] && found="$found$team
"
    done <<INNER
$names
INNER

    echo "$found" | grep -v '^$' | sort -u
}

# Teams of the Apple IDs signed in to Xcode. These are the only
# ones automatic signing can actually create a profile for - a
# leftover certificate in the keychain proves nothing.
detect_account_teams() {

    local teams=""

    # Where Xcode keeps this moves between versions, so read the
    # preference and the provisioning profiles it downloaded.
    teams="$(defaults read com.apple.dt.Xcode IDEProvisioningTeams 2>/dev/null \
        | sed -n 's/.*teamID[[:space:]]*=[[:space:]]*"\{0,1\}\([A-Z0-9]\{10\}\)"\{0,1\}.*/\1/p' \
        || true)"

    local dir
    local profile
    local team

    for dir in "${PROFILE_DIRS[@]}"; do

        [ -d "$dir" ] || continue

        for profile in "$dir"/*.mobileprovision; do

            [ -f "$profile" ] || continue

            team="$(security cms -D -i "$profile" 2>/dev/null \
                | plutil -extract TeamIdentifier.0 raw - 2>/dev/null || true)"

            [ -n "$team" ] && teams="$teams
$team"
        done
    done

    echo "$teams" | grep -E '^[A-Z0-9]{10}$' | sort -u || true
}

TEAM="${UMP_IOS_TEAM_ID:-}"
TEAM_SOURCE="UMP_IOS_TEAM_ID"

if [ -z "$TEAM" ]; then

    # Unity writes the Player Settings team into the project.
    TEAM="$(echo "$SETTINGS" \
        | awk -F' = ' '/ DEVELOPMENT_TEAM = / {print $2; exit}' \
        | tr -d ' \r' || true)"

    TEAM_SOURCE="Player Settings"
fi

ACCOUNT_TEAMS="$(detect_account_teams || true)"

if [ -z "$TEAM" ]; then

    COUNT="$(echo "$ACCOUNT_TEAMS" | grep -c . || true)"

    if [ "$COUNT" -eq 1 ]; then

        TEAM="$ACCOUNT_TEAMS"
        TEAM_SOURCE="Apple ID signed in to Xcode"

    elif [ "$COUNT" -gt 1 ]; then

        echo "[PEARZ] Several teams signed in to Xcode:"
        echo "$ACCOUNT_TEAMS"
        echo "[PEARZ] Set UMP_IOS_TEAM_ID or Player Settings ->"
        echo "[PEARZ] iOS -> Signing Team ID to pick one."
    fi
fi

if [ -z "$TEAM" ]; then

    DETECTED="$(detect_team || true)"

    COUNT="$(echo "$DETECTED" | grep -c . || true)"

    if [ "$COUNT" -eq 1 ]; then

        TEAM="$DETECTED"
        TEAM_SOURCE="signing certificate on this Mac"

    elif [ "$COUNT" -gt 1 ]; then

        echo "[PEARZ] Several signing teams on this Mac:"
        echo "$DETECTED"
        echo "[PEARZ] Set UMP_IOS_TEAM_ID or Player Settings ->"
        echo "[PEARZ] iOS -> Signing Team ID to pick one."
    fi
fi

# Forcing a team the signed-in account does not belong to fails
# with "No profiles for ... were found", which reads like a
# missing account rather than a mismatch.
if [ -n "$TEAM" ] && [ -n "$ACCOUNT_TEAMS" ] && \
   ! echo "$ACCOUNT_TEAMS" | grep -qx "$TEAM"; then

    echo "[PEARZ] WARNING: team $TEAM ($TEAM_SOURCE) is not one of"
    echo "[PEARZ] the teams signed in to Xcode:"
    echo "$ACCOUNT_TEAMS" | sed 's/^/[PEARZ]   /'
    echo "[PEARZ] Automatic signing cannot create a profile for it."
fi

if [ -n "$TEAM" ]; then

    echo "[PEARZ] Team         : $TEAM ($TEAM_SOURCE)"

    BUILD_ARGS+=(
        "DEVELOPMENT_TEAM=$TEAM"
        "CODE_SIGN_STYLE=Automatic"
    )

    if [ "$USING_API_KEY" -eq 1 ]; then

        echo "[PEARZ] Auth         : App Store Connect API key"

        BUILD_ARGS+=(
            -authenticationKeyPath "$UMP_ASC_KEY_PATH"
            -authenticationKeyID "$UMP_ASC_KEY_ID"
            -authenticationKeyIssuerID "$UMP_ASC_ISSUER_ID"
        )
    fi

else

    echo "[PEARZ] ERROR: no signing team, xcodebuild cannot sign."
    echo "[PEARZ] No Apple Development certificate on this Mac and"
    echo "[PEARZ] no team in Player Settings."
    echo "[PEARZ] Fix on the Mac: Xcode -> Settings -> Accounts -> +"
    echo "[PEARZ] and sign in with any Apple ID. A free account gives"
    echo "[PEARZ] a Personal Team; the app then runs 7 days on the"
    echo "[PEARZ] device. Re-run afterwards."
    echo "[PEARZ] Or set UMP_IOS_TEAM_ID in Jenkins, or fill"
    echo "[PEARZ] Player Settings -> iOS -> Signing Team ID."

    exit 1
fi

# Where Xcode records signed-in accounts differs between
# versions, so treat a negative result as a hint only - never
# block a build on it. xcodebuild has the final word.
has_xcode_account() {

    defaults read com.apple.dt.Xcode IDEProvisioningTeams \
        >/dev/null 2>&1 && return 0

    defaults read com.apple.dt.Xcode DVTDeveloperAccountManagerAppleIDLists \
        >/dev/null 2>&1 && return 0

    security find-generic-password -s "Xcode-Token" \
        >/dev/null 2>&1 && return 0

    return 1
}

signing_help() {

    local profiles=0
    local dir
    local token="NOT visible from this session"

    for dir in "${PROFILE_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        profiles=$((profiles + $(ls -1 "$dir"/*.mobileprovision 2>/dev/null | wc -l | tr -d ' ')))
    done

    security find-generic-password -s "Xcode-Token" >/dev/null 2>&1 &&
        token="found"

    echo "[PEARZ]"
    echo "[PEARZ] --- signing diagnostics ---"
    echo "[PEARZ] build user          : $(id -un 2>/dev/null || echo unknown)"
    echo "[PEARZ] home                : $HOME"
    echo "[PEARZ] Xcode account token : $token"
    echo "[PEARZ] teams signed in     : ${ACCOUNT_TEAMS:-<none>}"
    echo "[PEARZ] team used for build : $TEAM ($TEAM_SOURCE)"
    echo "[PEARZ] provisioning profiles: $profiles"
    echo "[PEARZ] keychains in search list:"

    security list-keychains 2>/dev/null | sed 's/^/[PEARZ]   /' || true

    echo "[PEARZ]"

    if [ "$token" = "found" ]; then

        echo "[PEARZ] An Xcode account IS visible, so this is most"
        echo "[PEARZ] likely the login keychain being locked for the"
        echo "[PEARZ] Jenkins session. Unlock it before the build:"
        echo "[PEARZ]   security unlock-keychain -p <password> \\"
        echo "[PEARZ]     ~/Library/Keychains/login.keychain-db"
        echo "[PEARZ] Running Jenkins as a LaunchAgent inside the"
        echo "[PEARZ] user's GUI session avoids this for good."
        echo "[PEARZ]"

        return
    fi

    echo "[PEARZ] Xcode needs an Apple ID signed in to create the"
    echo "[PEARZ] provisioning profile for $BUNDLE_ID - a certificate"
    echo "[PEARZ] in the keychain is not enough."
    echo "[PEARZ]"
    echo "[PEARZ] On this Mac, logged in as the user Jenkins runs as"
    echo "[PEARZ] (${USER:-unknown}): Xcode -> Settings -> Accounts -> +"
    echo "[PEARZ] -> Apple Account. A free Apple ID is enough for a"
    echo "[PEARZ] test device; an account in team $TEAM reuses the"
    echo "[PEARZ] certificate already installed here."
    echo "[PEARZ]"
    echo "[PEARZ] Headless alternative (paid account): create an App"
    echo "[PEARZ] Store Connect API key and set UMP_ASC_KEY_PATH,"
    echo "[PEARZ] UMP_ASC_KEY_ID and UMP_ASC_ISSUER_ID in Jenkins."
}

if [ "$USING_API_KEY" -eq 0 ] && \
   ! has_xcode_account && \
   ! has_profile_for "$BUNDLE_ID"; then

    echo "[PEARZ] Note: no signed-in Xcode account found."
    echo "[PEARZ] Building anyway - Xcode may still know better."
fi

# ------------------------------------------------------------
# Strip capabilities a test build cannot sign
#
# Appending keeps the signing setup made in Xcode, but it does
# not keep a capability deleted there: com.unity.purchasing runs
# a post-process build callback that writes In-App Purchase back
# into the project on every single build, append or not. Nothing
# in Unity turns that off, so it is undone here - after Unity has
# written the project, before xcodebuild reads it.
#
# A free Personal Team is never issued a profile carrying In-App
# Purchase, so leaving it in fails provisioning outright.
#
# UMP_IOS_STRIP_CAPABILITIES="" keeps every capability, which is
# what a paid team wants.
# ------------------------------------------------------------

STRIP="${UMP_IOS_STRIP_CAPABILITIES-com.apple.InAppPurchase}"

PROJECT_DIR="$(dirname "$PROJECT")"

# Every entitlements file this build could sign with: the one the
# target points at (a path relative to the project) plus anything
# Unity left in the exported project. Which of the two carries a
# capability changed between Unity versions, so both are cleaned.
list_entitlements() {

    local declared
    local file

    declared="$(echo "$SETTINGS" \
        | awk -F' = ' '/ CODE_SIGN_ENTITLEMENTS = / {print $2}' \
        | tr -d '\r' || true)"

    while IFS= read -r file; do

        [ -n "$file" ] || continue

        case "$file" in
            /*) echo "$file" ;;
            *)  echo "$PROJECT_DIR/$file" ;;
        esac

    done <<DECLARED
$declared
DECLARED

    find "$PROJECT_DIR" \
        -maxdepth 3 \
        -type f \
        -name "*.entitlements" \
        2>/dev/null || true
}

if [ -n "$STRIP" ]; then

    STRIPPED_BY_NAME=0

    for capability in $STRIP; do

        if grep -q "$capability" "$PBXPROJ" 2>/dev/null; then

            perl -0pi -e \
                "s/^[ \t]*\"?\Q$capability\E\"?[ \t]*=[ \t]*\{[^}]*\};[ \t]*\n//mg" \
                "$PBXPROJ"

            echo "[PEARZ] Removed capability: $capability"

            STRIPPED_BY_NAME=1
        fi
    done

    SYSTEM_CAPABILITIES="$(perl -0ne \
        'print "$1\n" while /(SystemCapabilities\s*=\s*(\{(?:[^{}]++|(?2))*\});)/g' \
        "$PBXPROJ" 2>/dev/null || true)"

    if [ -n "$SYSTEM_CAPABILITIES" ]; then

        echo "[PEARZ] Capabilities left in the Xcode project:"
        echo "$SYSTEM_CAPABILITIES" | sed 's|^|[PEARZ]   |'

        # Removing by name is the precise way and leaves every
        # other capability set up in Xcode alone. It only works
        # when the key is spelled the way Apple documents it,
        # which Unity does not always do - and a capability this
        # team cannot sign still fails the whole build. So when
        # no name matched, the block goes as a whole.
        if [ "$STRIPPED_BY_NAME" -eq 0 ]; then

            perl -0pi -e \
                's/^[ \t]*SystemCapabilities\s*=\s*(\{(?:[^{}]++|(?1))*\});[ \t]*\n//mg' \
                "$PBXPROJ"

            echo "[PEARZ] No name in UMP_IOS_STRIP_CAPABILITIES matched,"
            echo "[PEARZ] so the whole block above was removed."
        fi
    fi

    # The matching entitlements, when Unity wrote any.
    ENTITLEMENTS_FOUND="$(list_entitlements | sort -u | grep -v '^$' || true)"

    if [ -n "$ENTITLEMENTS_FOUND" ]; then

        echo "[PEARZ] Entitlements files:"
        echo "$ENTITLEMENTS_FOUND" | sed 's|^|[PEARZ]   |'

    else

        echo "[PEARZ] No entitlements file in the exported project."
    fi

    while IFS= read -r entitlements; do

        [ -f "$entitlements" ] || continue

        for key in \
            com.apple.developer.in-app-payments \
            com.apple.developer.storekit-external-purchase \
            com.apple.developer.storekit-external-purchase-link \
            aps-environment; do

            /usr/libexec/PlistBuddy -c "Print :$key" "$entitlements" \
                >/dev/null 2>&1 || continue

            if /usr/libexec/PlistBuddy -c "Delete :$key" "$entitlements" \
                >/dev/null 2>&1; then

                echo "[PEARZ] Removed entitlement $key from $entitlements"
            fi
        done

    done <<ENTITLEMENTS
$ENTITLEMENTS_FOUND
ENTITLEMENTS

fi

rm -rf "$DERIVED"

BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/ump-xcodebuild-XXXXXX")"

# Each attempt overwrites BUILD_LOG, so the reason the first one
# failed is gone by the time the diagnostics run. Keeping the
# error lines of every attempt is what lets them report on all of
# them - "No Accounts" only ever shows up in the first.
ERROR_LOG="$(mktemp "${TMPDIR:-/tmp}/ump-xcodeerrors-XXXXXX")"

record_errors() {

    grep -E "error:|No Accounts" "$BUILD_LOG" >> "$ERROR_LOG" 2>/dev/null || true
}

BUILD_OK=1

xcodebuild "${BUILD_ARGS[@]}" build 2>&1 | tee "$BUILD_LOG" || BUILD_OK=0

record_errors

capability_refused() {

    grep -qE \
        "do not support the|does not support the|doesn't include the .*capability" \
        "$BUILD_LOG"
}

# A free Personal Team cannot sign In-App Purchase, push and
# friends: "Personal development teams ... do not support the
# In-App Purchase capability". The capability is stripped from
# the project above, but Xcode also derives what a profile must
# contain from the entitlements file the target points at, and
# Unity writes that file in a different place per version.
#
# Building with no entitlements at all settles it. The device
# test build loses IAP, push and keychain sharing; the App Store
# path (release/ios) never comes through here, so nothing that
# ships is affected.
if [ "$BUILD_OK" -eq 0 ] && [ -n "$STRIP" ] && capability_refused; then

    echo "========================================"
    echo "[PEARZ] This team cannot sign a capability the project asks"
    echo "[PEARZ] for. Retrying without entitlements - test build only."
    echo "========================================"

    rm -rf "$DERIVED"

    BUILD_OK=1

    xcodebuild "${BUILD_ARGS[@]}" \
        CODE_SIGN_ENTITLEMENTS="" \
        build 2>&1 | tee "$BUILD_LOG" || BUILD_OK=0

    record_errors
fi


if [ "$BUILD_OK" -eq 0 ]; then

    echo "[PEARZ] ERROR: xcodebuild failed."

    if grep -qE "No Accounts|No profiles for|requires a development team" \
        "$ERROR_LOG"; then

        signing_help
    fi

    if grep -qE "do not support the|does not support the|doesn't include the .*capability" \
        "$ERROR_LOG"; then

        echo "[PEARZ]"
        echo "[PEARZ] --- capability not signable by this team ---"
        echo "[PEARZ] Team $TEAM is a free Personal Team, and Apple does"
        echo "[PEARZ] not issue one a development profile carrying"
        echo "[PEARZ] In-App Purchase."
        echo "[PEARZ]"
        echo "[PEARZ] The exported project asks for no such capability -"
        echo "[PEARZ] the block printed above is all it declares, and"
        echo "[PEARZ] there is no entitlements file. So this comes from"
        echo "[PEARZ] Apple's side: the App ID behind $BUNDLE_ID"
        echo "[PEARZ] carries In-App Purchase, and every profile Xcode"
        echo "[PEARZ] asks for has to match it. Nothing this script can"
        echo "[PEARZ] delete from the project changes that."
        echo "[PEARZ]"
        echo "[PEARZ] Two ways out:"
        echo "[PEARZ]"
        echo "[PEARZ]  - An Apple Developer Program team. Sign that"
        echo "[PEARZ]    Apple ID in to Xcode -> Settings -> Accounts"
        echo "[PEARZ]    and set UMP_IOS_TEAM_ID to its team id. It"
        echo "[PEARZ]    signs In-App Purchase, so the device build"
        echo "[PEARZ]    matches what ships."
        echo "[PEARZ]"
        echo "[PEARZ]  - A bundle id no App ID exists for yet, e.g."
        echo "[PEARZ]    $BUNDLE_ID.test, in Player Settings ->"
        echo "[PEARZ]    iOS -> Identification, committed on this"
        echo "[PEARZ]    branch only. A fresh App ID carries no"
        echo "[PEARZ]    capability, so a Personal Team can sign it."
        echo "[PEARZ]    Run once with UMP_IOS_CLEAN=1 afterwards so"
        echo "[PEARZ]    the Xcode project is exported from scratch."
        echo "[PEARZ]"
    fi

    rm -f "$BUILD_LOG" "$ERROR_LOG"

    exit 1
fi

rm -f "$BUILD_LOG" "$ERROR_LOG"

# ------------------------------------------------------------
# Locate the .app
# ------------------------------------------------------------

APP="$(find "$DERIVED/Build/Products/$CONFIGURATION-iphoneos" \
    -maxdepth 1 \
    -type d \
    -name "*.app" \
    2>/dev/null | head -n 1 || true)"

if [ -z "$APP" ]; then

    echo "[PEARZ] ERROR: built .app not found under"
    echo "$DERIVED/Build/Products/$CONFIGURATION-iphoneos"
    echo "[PEARZ] Scheme '$SCHEME' produced:"

    ls -1 "$DERIVED/Build/Products/$CONFIGURATION-iphoneos" 2>/dev/null || true

    echo "[PEARZ] A library-only scheme (GameAssembly, UnityFramework)"
    echo "[PEARZ] builds no app. Set IOS_SCHEME to the app scheme."

    exit 1
fi

echo "[PEARZ] App          : $APP"

# ------------------------------------------------------------
# Install
# ------------------------------------------------------------

INSTALLED=0

if xcrun devicectl --version >/dev/null 2>&1; then

    echo "[PEARZ] Installing with devicectl..."

    if xcrun devicectl device install app \
        --device "$UDID" \
        "$APP"; then

        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ] && command -v ios-deploy >/dev/null 2>&1; then

    echo "[PEARZ] Installing with ios-deploy..."

    if ios-deploy --id "$UDID" --bundle "$APP" --no-wifi; then
        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ]; then
    echo "[PEARZ] ERROR: install failed."
    echo "[PEARZ] Unlock the device and accept the trust prompt,"
    echo "[PEARZ] or install ios-deploy: brew install ios-deploy"
    exit 1
fi

echo "[PEARZ] Installed on $UDID"

# ------------------------------------------------------------
# Launch (best effort)
# ------------------------------------------------------------

if [ "${UMP_IOS_LAUNCH:-1}" != "0" ]; then

    BUNDLE_ID="$(/usr/libexec/PlistBuddy \
        -c "Print :CFBundleIdentifier" \
        "$APP/Info.plist" 2>/dev/null || true)"

    if [ -n "$BUNDLE_ID" ]; then

        echo "[PEARZ] Launching $BUNDLE_ID..."

        xcrun devicectl device process launch \
            --device "$UDID" \
            "$BUNDLE_ID" || \
            echo "[PEARZ] Launch skipped (install still succeeded)."
    fi
fi

echo "========================================"
echo "[PEARZ] iOS device install finished"
echo "========================================"
