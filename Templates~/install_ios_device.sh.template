#!/bin/bash

set -euo pipefail

# ============================================================
# PEARZ iOS - compile the Xcode project Unity generated and
# install it on a device plugged into the Jenkins Mac.
# Used by release/ios-test.
#
# Optional Jenkins env vars:
#   UMP_IOS_DEVICE_UDID   pick one device when several are attached
#   UMP_IOS_DEVICE_NAME   ... or pick it by name
#   UMP_IOS_TEAM_ID       Apple Developer team for automatic signing
#   UMP_IOS_CONFIGURATION Release (default) or Debug
#   UMP_IOS_LAUNCH=0      install only, do not start the app
# ============================================================

echo "========================================"
echo "[PEARZ] iOS install on device"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"

# Unity exports to Builds/iOS/<Game name>, so look the project up
# instead of assuming a fixed path.
PROJECT="${UMP_IOS_PROJECT:-}"

if [ -z "$PROJECT" ]; then

    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project under"
    echo "$WORKSPACE/Builds/iOS"
    echo "[PEARZ] Run the Unity iOS build first."
    exit 1
fi

DERIVED="$WORKSPACE/Builds/iOSDerived"

echo "[PEARZ] Project      : $PROJECT"

# ------------------------------------------------------------
# Scheme
# ------------------------------------------------------------

#
# A Unity project ships several schemes - GameAssembly and
# UnityFramework are libraries and never produce a .app, so
# picking the first one in the list builds the wrong thing.
#

SCHEME="${IOS_SCHEME:-}"

if [ -z "$SCHEME" ]; then

    SCHEMES="$(xcodebuild -list -project "$PROJECT" 2>/dev/null \
        | awk '/Schemes:/ {found=1; next} found && !NF {exit} found {
            gsub(/^[ \t]+|[ \t]+$/, ""); print }')"

    if echo "$SCHEMES" | grep -qx "Unity-iPhone"; then

        SCHEME="Unity-iPhone"

    else

        SCHEME="$(echo "$SCHEMES" \
            | grep -vxE "GameAssembly|UnityFramework|Pods-.*" \
            | head -n 1 || true)"
    fi
fi

[ -n "$SCHEME" ] || SCHEME="Unity-iPhone"

echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"

SETTINGS="$(xcodebuild -showBuildSettings \
    -project "$PROJECT" \
    -scheme "$SCHEME" 2>/dev/null || true)"

BUNDLE_ID="$(echo "$SETTINGS" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

[ -n "$BUNDLE_ID" ] && echo "[PEARZ] Bundle id    : $BUNDLE_ID"

# ------------------------------------------------------------
# Device
#
# xctrace lists physical devices as
#   <name> (<ios version>) (<udid>)
# while the host Mac has no version, which is what separates
# them. Offline devices sit in their own section.
# ------------------------------------------------------------

DEVICE_LINES="$(xcrun xctrace list devices 2>/dev/null \
    | awk '/^== Devices ==/ {found=1; next} /^== / {found=0} found {print}' \
    | grep -E '\([0-9]+(\.[0-9]+)+\) \([0-9A-Za-z-]+\)[[:space:]]*$' || true)"

UDID="${UMP_IOS_DEVICE_UDID:-}"

if [ -z "$UDID" ] && [ -n "${UMP_IOS_DEVICE_NAME:-}" ]; then

    DEVICE_LINES="$(echo "$DEVICE_LINES" \
        | grep -F "$UMP_IOS_DEVICE_NAME" || true)"
fi

if [ -z "$UDID" ]; then

    if [ -z "$DEVICE_LINES" ]; then

        echo "[PEARZ] ERROR: no iOS device detected."
        echo "[PEARZ] Check that the device is plugged in, unlocked,"
        echo "[PEARZ] and that it trusts this Mac."
        echo "[PEARZ] Devices seen by Xcode:"
        xcrun xctrace list devices 2>/dev/null || true
        exit 1
    fi

    COUNT="$(echo "$DEVICE_LINES" | grep -c . || true)"

    if [ "$COUNT" -gt 1 ]; then
        echo "[PEARZ] Several devices attached:"
        echo "$DEVICE_LINES"
        echo "[PEARZ] Using the first one."
        echo "[PEARZ] Set UMP_IOS_DEVICE_UDID or UMP_IOS_DEVICE_NAME to choose."
    fi

    DEVICE_LINE="$(echo "$DEVICE_LINES" | head -n 1)"

    UDID="$(echo "$DEVICE_LINE" \
        | sed -E 's/.*\(([0-9A-Za-z-]+)\)[[:space:]]*$/\1/')"

    DEVICE_NAME="$(echo "$DEVICE_LINE" \
        | sed -E 's/ \([^)]*\) \([^)]*\)[[:space:]]*$//')"

    echo "[PEARZ] Device       : $DEVICE_NAME"
fi

echo "[PEARZ] Device UDID  : $UDID"

# ------------------------------------------------------------
# Provisioning pre-flight
#
# A signing certificate in the keychain is not enough: to create
# a provisioning profile, Xcode needs an Apple ID signed in as
# the user Jenkins runs as, or an App Store Connect API key.
# ------------------------------------------------------------

PROFILE_DIRS=(
    "$HOME/Library/MobileDevice/Provisioning Profiles"
    "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"
)

has_profile_for() {

    local bundle="$1"
    local dir
    local profile
    local app_id

    [ -n "$bundle" ] || return 1

    for dir in "${PROFILE_DIRS[@]}"; do

        [ -d "$dir" ] || continue

        for profile in "$dir"/*.mobileprovision; do

            [ -f "$profile" ] || continue

            app_id="$(security cms -D -i "$profile" 2>/dev/null \
                | plutil -extract Entitlements.application-identifier raw - \
                    2>/dev/null || true)"

            [ -n "$app_id" ] || continue

            case "$app_id" in
                *".$bundle"|*".*") return 0 ;;
            esac
        done
    done

    return 1
}

USING_API_KEY=0

if [ -n "${UMP_ASC_KEY_PATH:-}" ] && \
   [ -n "${UMP_ASC_KEY_ID:-}" ] && \
   [ -n "${UMP_ASC_ISSUER_ID:-}" ]; then

    USING_API_KEY=1
fi

# ------------------------------------------------------------
# Build for that device
# ------------------------------------------------------------

BUILD_ARGS=(
    -project "$PROJECT"
    -scheme "$SCHEME"
    -configuration "$CONFIGURATION"
    -destination "id=$UDID"
    -derivedDataPath "$DERIVED"
    -allowProvisioningUpdates
)

# Reads the team out of the signing certificates installed on this
# Mac. The team id is the OU of an Apple Development certificate.
detect_team() {

    local names
    local team
    local found=""

    names="$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Apple Development[^"]*\)".*/\1/p
                  s/.*"\(iPhone Developer[^"]*\)".*/\1/p')"

    [ -n "$names" ] || return 0

    while IFS= read -r name; do

        [ -n "$name" ] || continue

        team="$(security find-certificate -c "$name" -p 2>/dev/null \
            | openssl x509 -noout -subject 2>/dev/null \
            | tr '/,' '\n\n' \
            | sed -n 's/^[[:space:]]*OU[[:space:]]*=[[:space:]]*\([A-Z0-9]\{10\}\).*/\1/p' \
            | head -n 1)"

        [ -n "$team" ] && found="$found$team
"
    done <<INNER
$names
INNER

    echo "$found" | grep -v '^$' | sort -u
}

TEAM="${UMP_IOS_TEAM_ID:-}"
TEAM_SOURCE="UMP_IOS_TEAM_ID"

if [ -z "$TEAM" ]; then

    # Unity writes the Player Settings team into the project.
    TEAM="$(echo "$SETTINGS" \
        | awk -F' = ' '/ DEVELOPMENT_TEAM = / {print $2; exit}' \
        | tr -d ' \r' || true)"

    TEAM_SOURCE="Player Settings"
fi

if [ -z "$TEAM" ]; then

    DETECTED="$(detect_team || true)"

    COUNT="$(echo "$DETECTED" | grep -c . || true)"

    if [ "$COUNT" -eq 1 ]; then

        TEAM="$DETECTED"
        TEAM_SOURCE="signing certificate on this Mac"

    elif [ "$COUNT" -gt 1 ]; then

        echo "[PEARZ] Several signing teams on this Mac:"
        echo "$DETECTED"
        echo "[PEARZ] Set UMP_IOS_TEAM_ID or Player Settings ->"
        echo "[PEARZ] iOS -> Signing Team ID to pick one."
    fi
fi

if [ -n "$TEAM" ]; then

    echo "[PEARZ] Team         : $TEAM ($TEAM_SOURCE)"

    BUILD_ARGS+=(
        "DEVELOPMENT_TEAM=$TEAM"
        "CODE_SIGN_STYLE=Automatic"
    )

    if [ "$USING_API_KEY" -eq 1 ]; then

        echo "[PEARZ] Auth         : App Store Connect API key"

        BUILD_ARGS+=(
            -authenticationKeyPath "$UMP_ASC_KEY_PATH"
            -authenticationKeyID "$UMP_ASC_KEY_ID"
            -authenticationKeyIssuerID "$UMP_ASC_ISSUER_ID"
        )
    fi

else

    echo "[PEARZ] ERROR: no signing team, xcodebuild cannot sign."
    echo "[PEARZ] No Apple Development certificate on this Mac and"
    echo "[PEARZ] no team in Player Settings."
    echo "[PEARZ] Fix on the Mac: Xcode -> Settings -> Accounts -> +"
    echo "[PEARZ] and sign in with any Apple ID. A free account gives"
    echo "[PEARZ] a Personal Team; the app then runs 7 days on the"
    echo "[PEARZ] device. Re-run afterwards."
    echo "[PEARZ] Or set UMP_IOS_TEAM_ID in Jenkins, or fill"
    echo "[PEARZ] Player Settings -> iOS -> Signing Team ID."

    exit 1
fi

# Where Xcode records signed-in accounts differs between
# versions, so treat a negative result as a hint only - never
# block a build on it. xcodebuild has the final word.
has_xcode_account() {

    defaults read com.apple.dt.Xcode IDEProvisioningTeams \
        >/dev/null 2>&1 && return 0

    defaults read com.apple.dt.Xcode DVTDeveloperAccountManagerAppleIDLists \
        >/dev/null 2>&1 && return 0

    security find-generic-password -s "Xcode-Token" \
        >/dev/null 2>&1 && return 0

    return 1
}

signing_help() {

    echo "[PEARZ]"
    echo "[PEARZ] Xcode needs an Apple ID signed in to create the"
    echo "[PEARZ] provisioning profile for $BUNDLE_ID - a certificate"
    echo "[PEARZ] in the keychain is not enough."
    echo "[PEARZ]"
    echo "[PEARZ] On this Mac, logged in as the user Jenkins runs as"
    echo "[PEARZ] (${USER:-unknown}): Xcode -> Settings -> Accounts -> +"
    echo "[PEARZ] -> Apple Account. A free Apple ID is enough for a"
    echo "[PEARZ] test device; an account in team $TEAM reuses the"
    echo "[PEARZ] certificate already installed here."
    echo "[PEARZ]"
    echo "[PEARZ] Headless alternative (paid account): create an App"
    echo "[PEARZ] Store Connect API key and set UMP_ASC_KEY_PATH,"
    echo "[PEARZ] UMP_ASC_KEY_ID and UMP_ASC_ISSUER_ID in Jenkins."
}

if [ "$USING_API_KEY" -eq 0 ] && \
   ! has_xcode_account && \
   ! has_profile_for "$BUNDLE_ID"; then

    echo "[PEARZ] Note: no signed-in Xcode account found."
    echo "[PEARZ] Building anyway - Xcode may still know better."
fi

rm -rf "$DERIVED"

BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/ump-xcodebuild-XXXXXX")"

BUILD_OK=1

xcodebuild "${BUILD_ARGS[@]}" build 2>&1 | tee "$BUILD_LOG" || BUILD_OK=0

if [ "$BUILD_OK" -eq 0 ]; then

    echo "[PEARZ] ERROR: xcodebuild failed."

    if grep -qE "No Accounts|No profiles for|requires a development team" \
        "$BUILD_LOG"; then

        signing_help
    fi

    rm -f "$BUILD_LOG"

    exit 1
fi

rm -f "$BUILD_LOG"

# ------------------------------------------------------------
# Locate the .app
# ------------------------------------------------------------

APP="$(find "$DERIVED/Build/Products/$CONFIGURATION-iphoneos" \
    -maxdepth 1 \
    -type d \
    -name "*.app" \
    2>/dev/null | head -n 1 || true)"

if [ -z "$APP" ]; then

    echo "[PEARZ] ERROR: built .app not found under"
    echo "$DERIVED/Build/Products/$CONFIGURATION-iphoneos"
    echo "[PEARZ] Scheme '$SCHEME' produced:"

    ls -1 "$DERIVED/Build/Products/$CONFIGURATION-iphoneos" 2>/dev/null || true

    echo "[PEARZ] A library-only scheme (GameAssembly, UnityFramework)"
    echo "[PEARZ] builds no app. Set IOS_SCHEME to the app scheme."

    exit 1
fi

echo "[PEARZ] App          : $APP"

# ------------------------------------------------------------
# Install
# ------------------------------------------------------------

INSTALLED=0

if xcrun devicectl --version >/dev/null 2>&1; then

    echo "[PEARZ] Installing with devicectl..."

    if xcrun devicectl device install app \
        --device "$UDID" \
        "$APP"; then

        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ] && command -v ios-deploy >/dev/null 2>&1; then

    echo "[PEARZ] Installing with ios-deploy..."

    if ios-deploy --id "$UDID" --bundle "$APP" --no-wifi; then
        INSTALLED=1
    fi
fi

if [ "$INSTALLED" -eq 0 ]; then
    echo "[PEARZ] ERROR: install failed."
    echo "[PEARZ] Unlock the device and accept the trust prompt,"
    echo "[PEARZ] or install ios-deploy: brew install ios-deploy"
    exit 1
fi

echo "[PEARZ] Installed on $UDID"

# ------------------------------------------------------------
# Launch (best effort)
# ------------------------------------------------------------

if [ "${UMP_IOS_LAUNCH:-1}" != "0" ]; then

    BUNDLE_ID="$(/usr/libexec/PlistBuddy \
        -c "Print :CFBundleIdentifier" \
        "$APP/Info.plist" 2>/dev/null || true)"

    if [ -n "$BUNDLE_ID" ]; then

        echo "[PEARZ] Launching $BUNDLE_ID..."

        xcrun devicectl device process launch \
            --device "$UDID" \
            "$BUNDLE_ID" || \
            echo "[PEARZ] Launch skipped (install still succeeded)."
    fi
fi

echo "========================================"
echo "[PEARZ] iOS device install finished"
echo "========================================"
