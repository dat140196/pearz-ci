#!/bin/bash

# ============================================================
# PEARZ / UMP - Android keystore resolver
#
# Sourced by build_android.sh. Exports:
#   UMP_ANDROID_KEYSTORE
#   UMP_ANDROID_KEYSTORE_PASS
#   UMP_ANDROID_KEY_ALIAS
#   UMP_ANDROID_KEY_ALIAS_PASS
#
# The keystore is looked up by the Android package name
# (applicationIdentifier), so nothing has to be configured
# per project in Jenkins.
#
# Search order:
#
#   1. Jenkins credentials, if the job already bound them.
#
#   2. Keystores/ in the project repo - the normal way. Commit
#      the key with the game and Jenkins picks it up on the
#      next push:
#
#        Keystores/
#          com.pearz.meowpuzzle.keystore
#          com.pearz.meowpuzzle.properties
#
#   3. $UMP_KEYSTORE_HOME on the build machine
#      (default ~/.pearz/keystores), same naming. Use it for
#      keys that must not live in a repo.
#
# In every location the lookup keys are tried in this order:
#   <applicationIdentifier>, <productName without spaces>,
#   "default".
#
# .properties contents (all optional when the matching
# UMP_ANDROID_* environment variable is set instead):
#   storePass=...
#   alias=...
#   aliasPass=...
#   keystore=path/if/not/next/to/this/file
#
# Passwords are never printed.
# ============================================================

ump_ks_log() {
    echo "[PEARZ] $*"
}

ump_ks_prop() {

    [ -f "$1" ] || return 0

    awk -F= -v key="$2" \
        '$1 == key { sub(/^[^=]*=/, ""); print; exit }' \
        "$1" 2>/dev/null | tr -d '\r'
}

# Reads ProjectSettings.asset, which exists before the build.
ump_ks_app_id() {

    local file="$1/ProjectSettings/ProjectSettings.asset"

    [ -f "$file" ] || return 0

    awk '
        /^  applicationIdentifier:/ { found = 1; next }
        found && /^    Android:/    { print $2; exit }
        found && !/^    /           { exit }
    ' "$file" 2>/dev/null | tr -d '\r'
}

ump_ks_product() {

    local file="$1/ProjectSettings/ProjectSettings.asset"

    [ -f "$file" ] || return 0

    sed -n 's/^  productName: //p' "$file" 2>/dev/null \
        | head -n 1 \
        | tr -d '\r' \
        | tr -d ' '
}

# Fills the UMP_ANDROID_* variables. Values come from the
# properties file, or from the environment when a project
# keeps its passwords in Jenkins instead of in the repo.
ump_ks_apply() {

    local keystore="$1"
    local props="$2"

    local store_pass
    local alias_name
    local alias_pass

    store_pass="$(ump_ks_prop "$props" storePass)"
    alias_name="$(ump_ks_prop "$props" alias)"
    alias_pass="$(ump_ks_prop "$props" aliasPass)"

    [ -n "$store_pass" ] || store_pass="${UMP_ANDROID_KEYSTORE_PASS:-}"
    [ -n "$alias_name" ] || alias_name="${UMP_ANDROID_KEY_ALIAS:-}"
    [ -n "$alias_pass" ] || alias_pass="${UMP_ANDROID_KEY_ALIAS_PASS:-}"

    if [ -z "$store_pass" ] || [ -z "$alias_name" ]; then

        ump_ks_log "Found $keystore but storePass/alias is missing."
        ump_ks_log "Add them to the .properties file next to it."

        return 1
    fi

    # A separate key password is optional.
    if [ -z "$alias_pass" ]; then
        alias_pass="$store_pass"
    fi

    # Passwords go through a private file, never the environment:
    # Unity dumps every environment variable into the build log
    # when Gradle fails, and a value that did not come from a
    # Jenkins credential is not masked there.
    local secrets
    secrets="$(mktemp "${TMPDIR:-/tmp}/ump-keystore-XXXXXX")"

    chmod 600 "$secrets"

    {
        printf 'keystore=%s\n' "$keystore"
        printf 'storePass=%s\n' "$store_pass"
        printf 'alias=%s\n' "$alias_name"
        printf 'aliasPass=%s\n' "$alias_pass"
    } > "$secrets"

    export UMP_ANDROID_KEYSTORE="$keystore"
    export UMP_ANDROID_KEYSTORE_PROPS="$secrets"

    unset UMP_ANDROID_KEYSTORE_PASS
    unset UMP_ANDROID_KEY_ALIAS
    unset UMP_ANDROID_KEY_ALIAS_PASS

    ump_ks_log "Keystore: $keystore (alias $alias_name)"

    return 0
}

# Tries "<dir>/<key>.keystore" and "<dir>/<key>/".
ump_ks_try() {

    local dir="$1"
    local key="$2"

    [ -n "$key" ] || return 1
    [ -d "$dir" ] || return 1

    local props=""
    local keystore=""

    # Layout A: files named after the package.
    for candidate in \
        "$dir/$key.keystore" \
        "$dir/$key.jks"; do

        if [ -f "$candidate" ]; then
            keystore="$candidate"
            break
        fi
    done

    if [ -n "$keystore" ]; then

        [ -f "$dir/$key.properties" ] && props="$dir/$key.properties"

    # Layout B: one folder per project.
    elif [ -d "$dir/$key" ]; then

        [ -f "$dir/$key/keystore.properties" ] &&
            props="$dir/$key/keystore.properties"

        keystore="$(find "$dir/$key" \
            -maxdepth 1 \
            -type f -name "*.keystore" -o \
            -type f -name "*.jks" \
            2>/dev/null | head -n 1 || true)"
    fi

    # The properties file may point somewhere else.
    if [ -n "$props" ]; then

        local declared
        declared="$(ump_ks_prop "$props" keystore)"

        if [ -n "$declared" ]; then

            case "$declared" in
                /*) keystore="$declared" ;;
                *)  keystore="$(dirname "$props")/$declared" ;;
            esac
        fi
    fi

    [ -n "$keystore" ] || return 1

    if [ ! -f "$keystore" ]; then
        ump_ks_log "Keystore file missing for '$key': $keystore"
        return 1
    fi

    ump_ks_apply "$keystore" "$props"
}

ump_ks_search() {

    local dir="$1"
    local label="$2"

    [ -d "$dir" ] || return 1

    ump_ks_log "Looking in $label: $dir"

    local key

    for key in "${UMP_KS_APP_ID:-}" "${UMP_KS_PRODUCT:-}" "default"; do

        if ump_ks_try "$dir" "$key"; then
            return 0
        fi
    done

    return 1
}

ump_resolve_keystore() {

    local project_root="${WORKSPACE:-$(pwd)}"

    # 1. Jenkins credentials win.
    if [ -n "${UMP_ANDROID_KEYSTORE:-}" ] && [ -f "${UMP_ANDROID_KEYSTORE}" ]; then
        ump_ks_log "Keystore: Jenkins credential."
        return 0
    fi

    UMP_KS_APP_ID="$(ump_ks_app_id "$project_root")"
    UMP_KS_PRODUCT="$(ump_ks_product "$project_root")"

    ump_ks_log "Package name : ${UMP_KS_APP_ID:-<unknown>}"
    ump_ks_log "Lookup keys  : ${UMP_KS_APP_ID:-<none>}, ${UMP_KS_PRODUCT:-<none>}, default"

    # 2. Committed with the project.
    local repo_dir
    for repo_dir in \
        "$project_root/Keystores" \
        "$project_root/keystores" \
        "$project_root/Jenkins/Keystores"; do

        if ump_ks_search "$repo_dir" "repo"; then
            return 0
        fi
    done

    # 3. Build machine.
    if ump_ks_search \
        "${UMP_KEYSTORE_HOME:-$HOME/.pearz/keystores}" "machine store"; then
        return 0
    fi

    ump_ks_log "No keystore found for this project."
    ump_ks_log "Add Keystores/${UMP_KS_APP_ID:-<package>}.keystore"
    ump_ks_log "and Keystores/${UMP_KS_APP_ID:-<package>}.properties to the repo."

    return 0
}

ump_resolve_keystore
