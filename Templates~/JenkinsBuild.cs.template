using System;
using System.IO;
using System.Linq;
using System.Text;
using UnityEditor;
using UnityEditor.Build.Reporting;

#if UNITY_IOS
using UnityEditor.iOS.Xcode;
#endif

public static class JenkinsBuild
{
    // Jenkins metadata used by shell scripts. A separate human-readable
    // BUILD_INFO file is written into the platform output root.
    private const string InfoFile = "Builds/ump_build_info.txt";

    public static void BuildAndroidAab() => BuildAndroid("Builds/Android", ".aab", true);
    public static void BuildAndroidApk() => BuildAndroid("Builds/AndroidTest", ".apk", false);

    private static void BuildAndroid(string directory, string extension, bool appBundle)
    {
        Prepare(directory);

        // An AAB goes to Google Play, so it must be signed for real.
        ConfigureSigning(appBundle);

        EditorUserBuildSettings.buildAppBundle = appBundle;

        string output = directory + "/" + ArtifactName() + extension;

        var options = new BuildPlayerOptions
        {
            scenes = GetEnabledScenes(),
            locationPathName = output,
            target = BuildTarget.Android,
            options = BuildOptions.None
        };

        Check(BuildPipeline.BuildPlayer(options));

        WriteBuildInfo(output);

        UnityEngine.Debug.Log("[UMP] Android build: " + output);
    }

    public static void BuildIOS()
    {
        // One folder per game so several projects never share an
        // Xcode project path on the same build machine.
        string output = "Builds/iOS/" + Sanitize(PlayerSettings.productName);

        // Appending leaves everything set up in Xcode by hand in
        // place - signing team, provisioning, In-App Purchase and
        // the rest of Signing & Capabilities - and rewrites only
        // the code and data Unity owns. A fresh export throws all
        // of that away on every build, which is why the device
        // build kept losing its signing setup.
        //
        // The first build has nothing to append to, and
        // UMP_IOS_CLEAN=1 forces the export back to a clean one.
        bool append =
            Env("UMP_IOS_CLEAN") != "1" &&
            Directory.Exists(output + "/Unity-iPhone.xcodeproj");

        if (append)
            Directory.CreateDirectory(output);
        else
            Prepare(output);

        UnityEngine.Debug.Log(
            "[UMP] iOS export: " + (append ? "append" : "clean"));

        var options = new BuildPlayerOptions
        {
            scenes = GetEnabledScenes(),
            locationPathName = output,
            target = BuildTarget.iOS,
            options = append
                ? BuildOptions.AcceptExternalModificationsToPlayer
                : BuildOptions.None
        };

        // Appending only works on a project this Unity version
        // wrote. After a Unity upgrade, or if Xcode rewrote the
        // project in a way Unity cannot read, the append fails -
        // and a build that stops here leaves nothing to install.
        try
        {
            Check(BuildPipeline.BuildPlayer(options));
        }
        catch (Exception e) when (append)
        {
            UnityEngine.Debug.LogWarning(
                "[UMP] Append failed (" + e.Message + "), exporting a " +
                "clean Xcode project. Signing & Capabilities set up in " +
                "Xcode is gone and has to be set up once more.");

            Prepare(output);

            options.options = BuildOptions.None;

            Check(BuildPipeline.BuildPlayer(options));
        }

        // release/ios-test uses a Personal Team for direct device builds.
        // Unity IAP can add StoreKit.framework to both Unity-iPhone and
        // UnityFramework. Keep it on UnityFramework (where Unity/player
        // plugin code lives) but remove it from the app target. This
        // mirrors the target-level framework change made by Xcode when
        // the IAP capability is removed for the device build.
        RemoveStoreKitFromDeviceAppTarget(output);

        WriteBuildInfo(output);

        UnityEngine.Debug.Log("[UMP] iOS Xcode project: " + output);
    }

    private static void RemoveStoreKitFromDeviceAppTarget(string output)
    {
#if UNITY_IOS
        string branch = Env("BRANCH_NAME");
        string mode = Env("UMP_IOS_STRIP_IAP");

        // Explicit env wins. Otherwise enable automatically only for the
        // Jenkins device-test branch used by this pipeline.
        bool enabled = mode == "1" || (mode.Length == 0 && branch == "release/ios-test");

        if (!enabled)
        {
            UnityEngine.Debug.Log(
                "[UMP] StoreKit app-target cleanup skipped" +
                (branch.Length > 0 ? " on branch " + branch : ""));
            return;
        }

        string pbxPath = PBXProject.GetPBXProjectPath(output);
        if (!File.Exists(pbxPath))
            throw new Exception("Xcode project.pbxproj not found: " + pbxPath);

        var project = new PBXProject();
        project.ReadFromFile(pbxPath);

        string mainTarget = project.GetUnityMainTargetGuid();
        string frameworkTarget = project.GetUnityFrameworkTargetGuid();

        if (string.IsNullOrEmpty(mainTarget))
            throw new Exception("Cannot resolve Unity main Xcode target.");

        UnityEngine.Debug.Log("[UMP] iOS main target GUID      : " + mainTarget);
        UnityEngine.Debug.Log("[UMP] iOS framework target GUID : " + frameworkTarget);

        project.RemoveFrameworkFromProject(mainTarget, "StoreKit.framework");
        project.WriteToFile(pbxPath);

        UnityEngine.Debug.Log(
            "[UMP] Removed StoreKit.framework from Unity-iPhone target only.");
        UnityEngine.Debug.Log(
            "[UMP] UnityFramework StoreKit dependency is intentionally preserved.");
#endif
    }

    // Unity never generates a release keystore. Without one it signs
    // with the Android debug key (~/.android/debug.keystore, created
    // automatically), which is fine for a test APK but rejected by
    // Google Play. Keystore + passwords come from Jenkins credentials
    // because Unity does not store passwords in the project.
    private static void ConfigureSigning(bool required)
    {
        // Only the Google Play AAB (release/android) is allowed to use
        // the production keystore. APK/test builds must ignore any
        // Jenkins/global keystore variables and use Android debug/default
        // signing instead.
        if (!required)
        {
            PlayerSettings.Android.useCustomKeystore = false;

            UnityEngine.Debug.Log(
                "[UMP] Android custom keystore skipped - " +
                "only release/android AAB uses release signing.");

            return;
        }

        string keystore = Env("UMP_ANDROID_KEYSTORE");
        string keystorePass = Env("UMP_ANDROID_KEYSTORE_PASS");
        string alias = Env("UMP_ANDROID_KEY_ALIAS");
        string aliasPass = Env("UMP_ANDROID_KEY_ALIAS_PASS");

        // resolve_keystore.sh passes the passwords in a private file
        // rather than the environment, which Unity dumps into the
        // build log when Gradle fails.
        string secrets = Env("UMP_ANDROID_KEYSTORE_PROPS");

        if (secrets.Length > 0 && File.Exists(secrets))
        {
            keystore = Prop(secrets, "keystore", keystore);
            keystorePass = Prop(secrets, "storePass", keystorePass);
            alias = Prop(secrets, "alias", alias);
            aliasPass = Prop(secrets, "aliasPass", aliasPass);
        }

        if (keystore.Length == 0)
        {
            throw new Exception(
                "No release keystore for this project. release/android builds " +
                "an AAB and requires release signing. Add " +
                "<applicationIdentifier>.keystore and " +
                "<applicationIdentifier>.properties to the keystore store " +
                "on the build machine (~/.pearz/keystores by default, see " +
                "Jenkins/resolve_keystore.sh), or bind the " +
                "UMP_ANDROID_KEYSTORE credentials in the job.");
        }

        if (!File.Exists(keystore))
            throw new Exception("Keystore not found: " + keystore);

        if (keystorePass.Length == 0 || alias.Length == 0 || aliasPass.Length == 0)
            throw new Exception(
                "Keystore found but UMP_ANDROID_KEYSTORE_PASS / " +
                "UMP_ANDROID_KEY_ALIAS / UMP_ANDROID_KEY_ALIAS_PASS is empty.");

        PlayerSettings.Android.useCustomKeystore = true;
        PlayerSettings.Android.keystoreName = Path.GetFullPath(keystore);
        PlayerSettings.Android.keystorePass = keystorePass;
        PlayerSettings.Android.keyaliasName = alias;
        PlayerSettings.Android.keyaliasPass = aliasPass;

        UnityEngine.Debug.Log(
            "[UMP] Signing with " + PlayerSettings.Android.keystoreName +
            " (alias " + alias + ")");
    }

    private static string Env(string name)
    {
        string value = Environment.GetEnvironmentVariable(name);
        return value == null ? "" : value.Trim();
    }

    // key=value, one per line. A value may contain '='.
    private static string Prop(string file, string key, string fallback)
    {
        foreach (string line in File.ReadAllLines(file))
        {
            int separator = line.IndexOf('=');

            if (separator <= 0)
                continue;

            if (line.Substring(0, separator).Trim() != key)
                continue;

            string value = line.Substring(separator + 1).TrimEnd('\r', '\n');

            return value.Length > 0 ? value : fallback;
        }

        return fallback;
    }

    // ProductName-v1.0.0, safe for a file name.
    private static string ArtifactName()
    {
        return Sanitize(PlayerSettings.productName) +
               "-v" +
               Sanitize(PlayerSettings.bundleVersion);
    }

    private static string Sanitize(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "Game";

        var invalid = Path.GetInvalidFileNameChars();
        var builder = new StringBuilder();

        foreach (char c in value.Trim())
        {
            if (char.IsWhiteSpace(c) || invalid.Contains(c))
                continue;

            builder.Append(c);
        }

        return builder.Length == 0 ? "Game" : builder.ToString();
    }

    // Android counts with an integer, iOS with a string, and the
    // notification shows whichever one this build really used.
    private static string BuildNumber()
    {
        return EditorUserBuildSettings.activeBuildTarget == BuildTarget.iOS
            ? PlayerSettings.iOS.buildNumber
            : PlayerSettings.Android.bundleVersionCode.ToString();
    }

    private static string PackageName()
    {
        BuildTarget target = EditorUserBuildSettings.activeBuildTarget;
        BuildTargetGroup group = target == BuildTarget.iOS
            ? BuildTargetGroup.iOS
            : BuildTargetGroup.Android;

        return PlayerSettings.GetApplicationIdentifier(group);
    }

    private static void WriteBuildInfo(string artifact)
    {
        try
        {
            Directory.CreateDirectory("Builds");

            var lines = new[]
            {
                "PRODUCT_NAME=" + PlayerSettings.productName,
                "PRODUCT_NAME_SAFE=" + Sanitize(PlayerSettings.productName),
                "VERSION=" + PlayerSettings.bundleVersion,
                "BUILD_NUMBER=" + BuildNumber(),
                "PACKAGE_NAME=" + PackageName(),
                "ARTIFACT=" + artifact
            };

            string content = string.Join("\n", lines) + "\n";
            File.WriteAllText(InfoFile, content);

            // Human-readable companion file used by Drive uploads.
            // It MUST be tied to the exact build artifact/export path:
            //   Android: Builds/AndroidTest/MeowTrail-v1.0.0.apk
            //         -> Builds/AndroidTest/MeowTrail-v1.0.0_BUILD_INFO.txt
            //   iOS:     Builds/iOS/MeowTrail/
            //         -> Builds/iOS/MeowTrail_BUILD_INFO.txt
            // Keep Builds/ump_build_info.txt only as Jenkins/Telegram metadata.
            string companionDirectory = Path.GetDirectoryName(artifact);

            if (string.IsNullOrEmpty(companionDirectory))
                companionDirectory = "Builds";

            Directory.CreateDirectory(companionDirectory);

            string artifactLeaf;
            if (Directory.Exists(artifact))
            {
                artifactLeaf = Path.GetFileName(
                    artifact.TrimEnd(
                        Path.DirectorySeparatorChar,
                        Path.AltDirectorySeparatorChar));
            }
            else
            {
                artifactLeaf = Path.GetFileNameWithoutExtension(artifact);
            }

            if (string.IsNullOrEmpty(artifactLeaf))
                artifactLeaf = Sanitize(PlayerSettings.productName);

            string gameInfoFile = Path.Combine(
                companionDirectory,
                artifactLeaf + "_BUILD_INFO.txt");

            File.WriteAllText(gameInfoFile, content);

            UnityEngine.Debug.Log("[UMP] Build info: " + InfoFile);
            UnityEngine.Debug.Log("[UMP] Game build info: " + gameInfoFile);
        }
        catch (Exception ex)
        {
            UnityEngine.Debug.LogWarning("[UMP] Cannot write build info: " + ex.Message);
        }
    }

    private static string[] GetEnabledScenes()
    {
        var scenes = EditorBuildSettings.scenes.Where(s => s.enabled).Select(s => s.path).ToArray();
        if (scenes.Length == 0) throw new Exception("No enabled scenes found in Build Settings.");
        foreach (var scene in scenes) UnityEngine.Debug.Log("[UMP] Scene: " + scene);
        return scenes;
    }

    private static void Prepare(string path) { if (Directory.Exists(path)) Directory.Delete(path, true); Directory.CreateDirectory(path); }

    private static void Check(BuildReport report)
    { if (report == null || report.summary.result != BuildResult.Succeeded) throw new Exception("Unity build failed: " + (report == null ? "null report" : report.summary.result)); }
}
