using System;
using System.IO;
using System.Linq;
using System.Text;
using UnityEditor;
using UnityEditor.Build.Reporting;

public static class JenkinsBuild
{
    // Written next to the artifact so the Jenkins shell scripts
    // know the product name / version without parsing Unity files.
    private const string InfoFile = "Builds/ump_build_info.txt";

    public static void BuildAndroidAab() => BuildAndroid("Builds/Android", ".aab", true);
    public static void BuildAndroidApk() => BuildAndroid("Builds/AndroidTest", ".apk", false);

    private static void BuildAndroid(string directory, string extension, bool appBundle)
    {
        Prepare(directory);

        // An AAB goes to Google Play, so it must be signed for real.
        ConfigureSigning(appBundle);

        EditorUserBuildSettings.buildAppBundle = appBundle;

        string output = directory + "/" + ArtifactName() + extension;

        var options = new BuildPlayerOptions
        {
            scenes = GetEnabledScenes(),
            locationPathName = output,
            target = BuildTarget.Android,
            options = BuildOptions.None
        };

        Check(BuildPipeline.BuildPlayer(options));

        WriteBuildInfo(output);

        UnityEngine.Debug.Log("[UMP] Android build: " + output);
    }

    public static void BuildIOS()
    {
        string output = "Builds/iOS";
        Prepare(output);

        var options = new BuildPlayerOptions
        {
            scenes = GetEnabledScenes(),
            locationPathName = output,
            target = BuildTarget.iOS,
            options = BuildOptions.None
        };

        Check(BuildPipeline.BuildPlayer(options));

        WriteBuildInfo(output);

        UnityEngine.Debug.Log("[UMP] iOS Xcode project: " + output);
    }

    // Unity never generates a release keystore. Without one it signs
    // with the Android debug key (~/.android/debug.keystore, created
    // automatically), which is fine for a test APK but rejected by
    // Google Play. Keystore + passwords come from Jenkins credentials
    // because Unity does not store passwords in the project.
    private static void ConfigureSigning(bool required)
    {
        string keystore = Env("UMP_ANDROID_KEYSTORE");
        string keystorePass = Env("UMP_ANDROID_KEYSTORE_PASS");
        string alias = Env("UMP_ANDROID_KEY_ALIAS");
        string aliasPass = Env("UMP_ANDROID_KEY_ALIAS_PASS");

        if (keystore.Length == 0)
        {
            if (required)
                throw new Exception(
                    "No release keystore for this project. Add " +
                    "<applicationIdentifier>.keystore and " +
                    "<applicationIdentifier>.properties to the keystore store " +
                    "on the build machine (~/.pearz/keystores by default, see " +
                    "Jenkins/resolve_keystore.sh), or bind the " +
                    "UMP_ANDROID_KEYSTORE credentials in the job. " +
                    "Google Play rejects an AAB signed with the debug key.");

            UnityEngine.Debug.LogWarning(
                "[UMP] No keystore configured - signing with the Android debug key.");

            PlayerSettings.Android.useCustomKeystore = false;
            return;
        }

        if (!File.Exists(keystore))
            throw new Exception("Keystore not found: " + keystore);

        if (keystorePass.Length == 0 || alias.Length == 0 || aliasPass.Length == 0)
            throw new Exception(
                "Keystore found but UMP_ANDROID_KEYSTORE_PASS / " +
                "UMP_ANDROID_KEY_ALIAS / UMP_ANDROID_KEY_ALIAS_PASS is empty.");

        PlayerSettings.Android.useCustomKeystore = true;
        PlayerSettings.Android.keystoreName = Path.GetFullPath(keystore);
        PlayerSettings.Android.keystorePass = keystorePass;
        PlayerSettings.Android.keyaliasName = alias;
        PlayerSettings.Android.keyaliasPass = aliasPass;

        UnityEngine.Debug.Log(
            "[UMP] Signing with " + PlayerSettings.Android.keystoreName +
            " (alias " + alias + ")");
    }

    private static string Env(string name)
    {
        string value = Environment.GetEnvironmentVariable(name);
        return value == null ? "" : value.Trim();
    }

    // ProductName-v1.0.0, safe for a file name.
    private static string ArtifactName()
    {
        return Sanitize(PlayerSettings.productName) +
               "-v" +
               Sanitize(PlayerSettings.bundleVersion);
    }

    private static string Sanitize(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "Game";

        var invalid = Path.GetInvalidFileNameChars();
        var builder = new StringBuilder();

        foreach (char c in value.Trim())
        {
            if (char.IsWhiteSpace(c) || invalid.Contains(c))
                continue;

            builder.Append(c);
        }

        return builder.Length == 0 ? "Game" : builder.ToString();
    }

    private static void WriteBuildInfo(string artifact)
    {
        try
        {
            Directory.CreateDirectory("Builds");

            var lines = new[]
            {
                "PRODUCT_NAME=" + PlayerSettings.productName,
                "PRODUCT_NAME_SAFE=" + Sanitize(PlayerSettings.productName),
                "VERSION=" + PlayerSettings.bundleVersion,
                "BUILD_NUMBER=" + PlayerSettings.Android.bundleVersionCode,
                "ARTIFACT=" + artifact
            };

            File.WriteAllText(InfoFile, string.Join("\n", lines) + "\n");

            UnityEngine.Debug.Log("[UMP] Build info: " + InfoFile);
        }
        catch (Exception ex)
        {
            UnityEngine.Debug.LogWarning("[UMP] Cannot write build info: " + ex.Message);
        }
    }

    private static string[] GetEnabledScenes()
    {
        var scenes = EditorBuildSettings.scenes.Where(s => s.enabled).Select(s => s.path).ToArray();
        if (scenes.Length == 0) throw new Exception("No enabled scenes found in Build Settings.");
        foreach (var scene in scenes) UnityEngine.Debug.Log("[UMP] Scene: " + scene);
        return scenes;
    }

    private static void Prepare(string path) { if (Directory.Exists(path)) Directory.Delete(path, true); Directory.CreateDirectory(path); }

    private static void Check(BuildReport report)
    { if (report == null || report.summary.result != BuildResult.Succeeded) throw new Exception("Unity build failed: " + (report == null ? "null report" : report.summary.result)); }
}
