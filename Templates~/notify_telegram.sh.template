#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ Telegram build notification.
#
# Required Jenkins secret text credentials:
#   UMP_TELEGRAM_BOT_TOKEN
#   UMP_TELEGRAM_CHAT_ID
#
# Optional:
#   UMP_BUILD_STATUS
#   UMP_ARTIFACT
#   UMP_GAME_NAME
#   UMP_TELEGRAM_TOPIC_ID
#   UMP_TELEGRAM_TOPICS="Game A=123;Game B=456"
#   UMP_TELEGRAM_AUTO_TOPIC=0
#   UMP_TELEGRAM_TOPIC_CACHE=/path/to/topic-state
#   UMP_TELEGRAM_TOPIC_STATE=/path/to/topic-state  (legacy alias)
#   UMP_TELEGRAM_DRY_RUN=1
#
# Topic state notes:
# - The default state is $HOME/.pearz/telegram-topics.
# - Old single-file TSV state and the temporary *.d directory layout
#   are both read for backward compatibility.
# - Game aliases are matched canonically, so "MeowTrail" and
#   "Meow Trail" resolve to the same remembered topic.
# - Topic creation is protected by a cross-branch mkdir lock so two
#   multibranch builds cannot create duplicate topics concurrently.
#
# Build metadata:
#   Builds/ump_build_info.txt
#   Builds/ump_drive_url.txt
#   Builds/ump_build_info_drive_url.txt
# ============================================================

INFO_FILE="${UMP_BUILD_INFO:-Builds/ump_build_info.txt}"
DRIVE_URL_FILE="${UMP_DRIVE_URL_FILE:-Builds/ump_drive_url.txt}"
BUILD_INFO_URL_FILE="${UMP_BUILD_INFO_DRIVE_URL_FILE:-Builds/ump_build_info_drive_url.txt}"
STATUS="${UMP_BUILD_STATUS:-${BUILD_STATUS:-UNKNOWN}}"
ARTIFACT="${UMP_ARTIFACT:-}"
BRANCH="${BRANCH_NAME:-}"
BUILD_NO="${BUILD_NUMBER:-}"
JENKINS_URL="${BUILD_URL:-}"

read_kv() {
    local file="$1"
    local key="$2"
    [ -f "$file" ] || return 0
    awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$file" \
        | tr -d '\r'
}

PRODUCT_NAME="$(read_kv "$INFO_FILE" PRODUCT_NAME)"
VERSION="$(read_kv "$INFO_FILE" VERSION)"
BUILD_VERSION="$(read_kv "$INFO_FILE" BUILD_NUMBER)"
PACKAGE_NAME="$(read_kv "$INFO_FILE" PACKAGE_NAME)"
DRIVE_URL="$(read_kv "$DRIVE_URL_FILE" url)"
BUILD_INFO_URL="$(read_kv "$BUILD_INFO_URL_FILE" url)"
JOB_GAME="${JOB_NAME%%/*}"

GAME="${UMP_GAME_NAME:-$PRODUCT_NAME}"
if [ -z "$GAME" ]; then
    GAME="$JOB_GAME"
fi
[ -n "$GAME" ] || GAME="Game"

# Build platform is derived from the release branch.
# Android: release/android, release/android-test
# iOS:     release/ios, release/ios-test
PLATFORM_LABEL=""
case "$BRANCH" in
    release/android|release/android-test)
        PLATFORM_LABEL="Android"
        ;;
    release/ios|release/ios-test)
        PLATFORM_LABEL="IOS"
        ;;
esac

case "$STATUS" in
    SUCCESS) ICON="✅" ;;
    UNSTABLE) ICON="⚠️" ;;
    ABORTED) ICON="⏹️" ;;
    NOT_BUILT) ICON="⏭️" ;;
    *) ICON="❌" ;;
esac

if [ -n "$PLATFORM_LABEL" ]; then
    MESSAGE="$ICON [$PLATFORM_LABEL Build] $GAME - $STATUS"
else
    MESSAGE="$ICON $GAME - $STATUS"
fi
append_line() {
    MESSAGE="${MESSAGE}"$'\n'"$1"
}

[ -n "$BRANCH" ] && append_line "Branch: $BRANCH"
[ -n "$BUILD_NO" ] && append_line "Build: #$BUILD_NO"

if [ -n "$VERSION" ] && [ -n "$BUILD_VERSION" ]; then
    append_line "Version: $VERSION ($BUILD_VERSION)"
elif [ -n "$VERSION" ]; then
    append_line "Version: $VERSION"
fi

[ -n "$PACKAGE_NAME" ] && append_line "Package: $PACKAGE_NAME"

if [ -n "$ARTIFACT" ]; then
    append_line "Artifact: $(basename "$ARTIFACT")"
fi

[ -n "$DRIVE_URL" ] && append_line "Drive: $DRIVE_URL"
[ -n "$BUILD_INFO_URL" ] && append_line "Build Info: $BUILD_INFO_URL"
[ -n "$JENKINS_URL" ] && append_line "Jenkins: $JENKINS_URL"

if [ "${UMP_TELEGRAM_DRY_RUN:-0}" = "1" ]; then
    echo "========================================"
    echo "[PEARZ] Telegram dry run"
    printf '%s\n' "$MESSAGE"
    echo "========================================"
    exit 0
fi

TOKEN="${UMP_TELEGRAM_BOT_TOKEN:-}"
CHAT_ID="${UMP_TELEGRAM_CHAT_ID:-}"

if [ -z "$TOKEN" ] || [ -z "$CHAT_ID" ]; then
    echo "[PEARZ] ERROR: Telegram bot token/chat id is missing."
    exit 1
fi

# Strip accidental whitespace/quotes from Jenkins secret text values.
TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]' | sed "s/^['\"]//; s/['\"]$//")"
CHAT_ID="$(printf '%s' "$CHAT_ID" | tr -d '[:space:]' | sed "s/^['\"]//; s/['\"]$//")"

API="https://api.telegram.org/bot${TOKEN}"

json_result_field() {
    local field="$1"
    ruby -rjson -e '
        field = ARGV.fetch(0)
        begin
          json = JSON.parse(STDIN.read)
          value = json.dig("result", field)
          print(value.to_s) unless value.nil?
        rescue StandardError
        end
    ' "$field"
}

BOT_JSON="$(curl -fsS --max-time 20 "$API/getMe" 2>/dev/null || true)"
BOT_USER="$(printf '%s' "$BOT_JSON" | json_result_field username)"
[ -n "$BOT_USER" ] && echo "[PEARZ] Telegram bot: @$BOT_USER"

CHAT_JSON="$(curl -fsS --max-time 20 \
    --get --data-urlencode "chat_id=$CHAT_ID" \
    "$API/getChat" 2>/dev/null || true)"
CHAT_TITLE="$(printf '%s' "$CHAT_JSON" | json_result_field title)"
IS_FORUM="$(printf '%s' "$CHAT_JSON" | json_result_field is_forum)"
if [ -n "$CHAT_TITLE" ]; then
    echo "[PEARZ] Telegram chat: $CHAT_TITLE"
else
    echo "[PEARZ] Telegram chat: $CHAT_ID"
fi

truthy() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
        *) return 1 ;;
    esac
}

safe_name() {
    printf '%s' "$1" \
        | tr ' /:' '___' \
        | tr -cd '[:alnum:]_.-'
}

canonical_name() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -cd '[:alnum:]'
}

game_alias_matches() {
    local candidate="$1"
    local wanted
    local alias

    wanted="$(canonical_name "$candidate")"
    [ -n "$wanted" ] || return 1

    for alias in "$GAME" "$PRODUCT_NAME" "$JOB_GAME" "${UMP_GAME_NAME:-}"; do
        [ -n "$alias" ] || continue
        if [ "$(canonical_name "$alias")" = "$wanted" ]; then
            return 0
        fi
    done

    return 1
}

topic_root() {
    printf '%s' "${UMP_TELEGRAM_TOPIC_CACHE:-${UMP_TELEGRAM_TOPIC_STATE:-$HOME/.pearz/telegram-topics}}"
}

mapped_topic_candidates() {
    local mappings="${UMP_TELEGRAM_TOPICS:-}"
    local pair
    local name
    local id
    [ -n "$mappings" ] || return 0

    while IFS= read -r pair; do
        [ -n "$pair" ] || continue
        name="${pair%%=*}"
        id="${pair#*=}"
        id="$(printf '%s' "$id" | tr -d '[:space:]')"
        if game_alias_matches "$name" && printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            printf '%s\n' "$id"
        fi
    done < <(printf '%s' "$mappings" | tr ';' '\n')
}

topic_ids_from_tsv_file() {
    local file="$1"
    local chat
    local name
    local id

    [ -f "$file" ] || return 0

    while IFS=$'\t' read -r chat name id _rest; do
        [ "$chat" = "$CHAT_ID" ] || continue
        printf '%s' "$id" | grep -Eq '^[0-9]+$' || continue
        if game_alias_matches "$name"; then
            printf '%s\n' "$id"
        fi
    done < "$file"
}

topic_id_from_kv_file() {
    local file="$1"
    local name
    local chat
    local id

    [ -f "$file" ] || return 0

    name="$(read_kv "$file" GAME)"
    chat="$(read_kv "$file" CHAT_ID)"
    id="$(read_kv "$file" TOPIC_ID)"

    [ -n "$name" ] || return 0
    [ -z "$chat" ] || [ "$chat" = "$CHAT_ID" ] || return 0
    printf '%s' "$id" | grep -Eq '^[0-9]+$' || return 0

    if game_alias_matches "$name"; then
        printf '%s\n' "$id"
    fi
}

topic_ids_from_directory() {
    local dir="$1"
    local candidate
    local id

    [ -d "$dir" ] || return 0

    while IFS= read -r candidate; do
        [ -f "$candidate" ] || continue
        id="$(topic_id_from_kv_file "$candidate")"
        if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            printf '%s\n' "$id"
        fi
    done < <(find "$dir" -maxdepth 2 -type f 2>/dev/null | head -n 200)
}

topic_history_file() {
    local root
    root="$(topic_root)"
    if [ -d "$root" ]; then
        printf '%s/history.tsv' "$root"
    else
        printf '%s.history' "$root"
    fi
}

known_topic_candidates() {
    local root
    local history
    root="$(topic_root)"
    history="$(topic_history_file)"

    # Explicit Jenkins mapping is authoritative and tried first.
    if [ -n "${UMP_TELEGRAM_TOPIC_ID:-}" ] && \
       printf '%s' "$UMP_TELEGRAM_TOPIC_ID" | grep -Eq '^[0-9]+$'; then
        printf '%s\n' "$UMP_TELEGRAM_TOPIC_ID"
    fi

    mapped_topic_candidates

    # Current/legacy cache layouts.
    if [ -f "$root" ]; then
        topic_ids_from_tsv_file "$root"
    fi
    if [ -d "$root" ]; then
        topic_ids_from_directory "$root"
    fi
    if [ -d "${root}.d" ]; then
        topic_ids_from_directory "${root}.d"
    fi
    topic_ids_from_tsv_file "$history"
}

remember_topic_history() {
    local id="$1"
    local history
    local tmp

    history="$(topic_history_file)"
    mkdir -p "$(dirname "$history")"
    touch "$history"

    # Keep all historical topic ids for this game. A deleted latest topic may
    # have an older duplicate that is still active and should be recovered.
    if awk -F'\t' -v chat="$CHAT_ID" -v id="$id" \
        '$1 == chat && $3 == id { found=1 } END { exit(found ? 0 : 1) }' \
        "$history"; then
        return 0
    fi

    tmp="${history}.tmp.$$"
    cat "$history" > "$tmp"
    printf '%s\t%s\t%s\n' "$CHAT_ID" "$GAME" "$id" >> "$tmp"
    mv "$tmp" "$history"
}

store_topic() {
    local id="$1"
    local root
    local safe
    local tmp
    root="$(topic_root)"
    safe="$(safe_name "$GAME")"

    remember_topic_history "$id"

    # If the configured root is already a directory, preserve that layout.
    if [ -d "$root" ]; then
        mkdir -p "$root"
        cat > "$root/${safe}.topic" <<CACHE
GAME=$GAME
CHAT_ID=$CHAT_ID
TOPIC_ID=$id
CACHE
        return 0
    fi

    # Default / legacy layout: one current TSV mapping per game.
    mkdir -p "$(dirname "$root")"
    touch "$root"
    tmp="${root}.tmp.$$"

    awk -F'\t' -v chat="$CHAT_ID" -v game="$GAME" \
        '!($1 == chat && $2 == game)' \
        "$root" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$root"

    printf '%s\t%s\t%s\n' "$CHAT_ID" "$GAME" "$id" >> "$root"
}

TOPIC_LOCK_DIR=""
acquire_topic_lock() {
    local key
    local lock_root
    local attempts=0

    key="$(canonical_name "${CHAT_ID}_${GAME}")"
    [ -n "$key" ] || key="topic"
    lock_root="${UMP_TELEGRAM_TOPIC_LOCK_ROOT:-$HOME/.pearz/telegram-topic-locks}"
    mkdir -p "$lock_root"
    TOPIC_LOCK_DIR="$lock_root/${key}.lock"

    while ! mkdir "$TOPIC_LOCK_DIR" 2>/dev/null; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 30 ]; then
            echo "[PEARZ] Telegram topic lock timeout: $TOPIC_LOCK_DIR" >&2
            TOPIC_LOCK_DIR=""
            return 1
        fi
        sleep 1
    done

    return 0
}

release_topic_lock() {
    if [ -n "$TOPIC_LOCK_DIR" ]; then
        rmdir "$TOPIC_LOCK_DIR" 2>/dev/null || true
        TOPIC_LOCK_DIR=""
    fi
}

create_topic() {
    local response
    local id

    if [ -n "$IS_FORUM" ] && ! truthy "$IS_FORUM"; then
        return 0
    fi

    response="$(curl -sS --max-time 20 -X POST \
        --data-urlencode "chat_id=$CHAT_ID" \
        --data-urlencode "name=$GAME" \
        "$API/createForumTopic" 2>/dev/null || true)"
    id="$(printf '%s' "$response" | json_result_field message_thread_id)"
    if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
        store_topic "$id"
        echo "[PEARZ] Telegram topic '$GAME' created: $id" >&2
        printf '%s\n' "$id"
    fi
}

json_top_field() {
    local field="$1"
    ruby -rjson -e '
        field = ARGV.fetch(0)
        begin
          json = JSON.parse(STDIN.read)
          value = json[field]
          if value == true
            print "true"
          elsif value == false
            print "false"
          elsif !value.nil?
            print value.to_s
          end
        rescue StandardError
        end
    ' "$field"
}

tg_ok() {
    [ "$(printf '%s' "$1" | json_top_field ok)" = "true" ]
}

tg_description() {
    printf '%s' "$1" | json_top_field description
}

# Telegram Bot API has no method that lists/searches every forum topic.
# getUpdates can still reveal topic service messages that are currently in
# the bot update queue. We use them as an additional recovery source without
# advancing offset, so CI does not intentionally consume/confirm updates.
discover_topic_candidates_from_updates() {
    local updates
    local response_ok

    updates="$(curl -sS --max-time 20 --get \
        --data-urlencode "limit=100" \
        --data-urlencode "timeout=0" \
        "$API/getUpdates" 2>/dev/null || true)"

    response_ok="$(printf '%s' "$updates" | json_top_field ok)"
    if [ "$response_ok" != "true" ]; then
        local reason
        reason="$(printf '%s' "$updates" | json_top_field description)"
        [ -z "$reason" ] || echo "[PEARZ] Telegram topic discovery unavailable: $reason" >&2
        return 0
    fi

    printf '%s' "$updates" | ruby -rjson -e '
        chat_id = ARGV.shift.to_s
        aliases = ARGV.map { |s| s.to_s.downcase.gsub(/[^[:alnum:]]/, "") }.reject(&:empty?).uniq

        begin
          json = JSON.parse(STDIN.read)
        rescue StandardError
          exit 0
        end

        state = {}
        Array(json["result"]).each do |update|
          msg = update["message"] || update["channel_post"] ||
                update["edited_message"] || update["edited_channel_post"]
          next unless msg.is_a?(Hash)
          next unless msg.dig("chat", "id").to_s == chat_id

          tid = msg["message_thread_id"]
          created = msg["forum_topic_created"]
          edited = msg["forum_topic_edited"]
          closed = msg.key?("forum_topic_closed")
          reopened = msg.key?("forum_topic_reopened")

          # For the topic-creation service message, message_id is the topic
          # root id and is a safe fallback if message_thread_id is absent.
          tid ||= msg["message_id"] if created
          next unless tid

          item = (state[tid.to_i] ||= { name: nil, closed: false })
          if created.is_a?(Hash)
            item[:name] = created["name"] if created["name"]
            item[:closed] = false
          end
          if edited.is_a?(Hash) && edited["name"]
            item[:name] = edited["name"]
          end
          item[:closed] = true if closed
          item[:closed] = false if reopened
        end

        canonical = ->(s) { s.to_s.downcase.gsub(/[^[:alnum:]]/, "") }
        state.each do |id, item|
          next if item[:closed]
          next unless aliases.include?(canonical.call(item[:name]))
          puts id
        end
    ' -- "$CHAT_ID" "$GAME" "$PRODUCT_NAME" "$JOB_GAME" "${UMP_GAME_NAME:-}"
}

send_message() {
    local thread_id="${1:-}"
    local args=(
        -sS
        --max-time 30
        -X POST
        --data-urlencode "chat_id=$CHAT_ID"
        --data-urlencode "text=$MESSAGE"
        --data-urlencode "disable_web_page_preview=true"
    )

    if [ -n "$thread_id" ]; then
        args+=(--data-urlencode "message_thread_id=$thread_id")
    fi

    curl "${args[@]}" "$API/sendMessage" 2>/dev/null || true
}

try_topic_candidates() {
    local candidates="$1"
    local id
    local response
    local description

    while IFS= read -r id; do
        [ -n "$id" ] || continue
        printf '%s' "$id" | grep -Eq '^[0-9]+$' || continue

        echo "[PEARZ] Trying Telegram topic '$GAME': $id"
        response="$(send_message "$id")"

        if tg_ok "$response"; then
            TOPIC_ID="$id"
            store_topic "$id"
            echo "[PEARZ] Telegram topic '$GAME' active: $id"
            echo "[PEARZ] Telegram notification sent."
            return 0
        fi

        description="$(tg_description "$response")"
        echo "[PEARZ] Telegram topic $id unavailable: ${description:-unknown error}" >&2
    done < <(printf '%s\n' "$candidates" | sed '/^$/d' | awk '!seen[$0]++')

    return 1
}

# Non-forum chats have no topic to target. For forum groups, however, never
# fall back to General: build notifications must stay inside the game topic.
if [ -n "$IS_FORUM" ] && ! truthy "$IS_FORUM"; then
    RESPONSE="$(send_message "")"
    if tg_ok "$RESPONSE"; then
        echo "[PEARZ] Telegram notification sent (non-forum chat)."
        exit 0
    fi
    echo "[PEARZ] ERROR: Telegram notification was not sent: $(tg_description "$RESPONSE")" >&2
    exit 2
fi

KNOWN_CANDIDATES="$(known_topic_candidates | sed '/^$/d' | awk '!seen[$0]++')"
DISCOVERED_CANDIDATES="$(discover_topic_candidates_from_updates | sed '/^$/d' | awk '!seen[$0]++')"
ALL_CANDIDATES="$(printf '%s\n%s\n' "$KNOWN_CANDIDATES" "$DISCOVERED_CANDIDATES" \
    | sed '/^$/d' | awk '!seen[$0]++')"

if [ -n "$DISCOVERED_CANDIDATES" ]; then
    echo "[PEARZ] Same-name Telegram topic candidates discovered from updates:" >&2
    printf '%s\n' "$DISCOVERED_CANDIDATES" | sed 's/^/[PEARZ]   topic /' >&2
fi

if [ -n "$ALL_CANDIDATES" ] && try_topic_candidates "$ALL_CANDIDATES"; then
    exit 0
fi

# If there was any known/discovered same-name topic, this is recovery mode.
# Do NOT reopen, do NOT send General, and do NOT create another duplicate.
if [ -n "$ALL_CANDIDATES" ]; then
    echo "[PEARZ] ERROR: No active Telegram topic named '$GAME' was reachable." >&2
    echo "[PEARZ] General fallback is disabled; no duplicate topic was created." >&2
    echo "[PEARZ] If the bot update queue no longer contains the active topic," >&2
    echo "[PEARZ] set UMP_TELEGRAM_TOPICS=\"$GAME=<message_thread_id>\" once." >&2
    exit 2
fi

# Truly first-time game: no remembered or discoverable same-name topic exists.
# Preserve automatic topic creation for this one case only.
if truthy "${UMP_TELEGRAM_AUTO_TOPIC:-1}"; then
    if acquire_topic_lock; then
        # Another branch may have recorded/discovered the topic while waiting.
        KNOWN_CANDIDATES="$(known_topic_candidates | sed '/^$/d' | awk '!seen[$0]++')"
        DISCOVERED_CANDIDATES="$(discover_topic_candidates_from_updates | sed '/^$/d' | awk '!seen[$0]++')"
        ALL_CANDIDATES="$(printf '%s\n%s\n' "$KNOWN_CANDIDATES" "$DISCOVERED_CANDIDATES" \
            | sed '/^$/d' | awk '!seen[$0]++')"

        if [ -n "$ALL_CANDIDATES" ]; then
            release_topic_lock
            if try_topic_candidates "$ALL_CANDIDATES"; then
                exit 0
            fi
            echo "[PEARZ] ERROR: Same-name Telegram topic appeared but none is active." >&2
            exit 2
        fi

        CREATED_TOPIC="$(create_topic)"
        release_topic_lock

        if [ -n "$CREATED_TOPIC" ] && try_topic_candidates "$CREATED_TOPIC"; then
            exit 0
        fi
    fi
fi

echo "[PEARZ] ERROR: Telegram topic '$GAME' was not found and notification was not sent." >&2
exit 2
