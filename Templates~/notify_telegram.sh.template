#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ Telegram build notification.
#
# Required Jenkins secret text credentials:
#   UMP_TELEGRAM_BOT_TOKEN
#   UMP_TELEGRAM_CHAT_ID
#
# Optional:
#   UMP_BUILD_STATUS
#   UMP_ARTIFACT
#   UMP_GAME_NAME
#   UMP_TELEGRAM_TOPIC_ID
#   UMP_TELEGRAM_TOPICS="Game A=123;Game B=456"
#   UMP_TELEGRAM_AUTO_TOPIC=0
#   UMP_TELEGRAM_TOPIC_CACHE=/path/to/topic-state
#   UMP_TELEGRAM_TOPIC_STATE=/path/to/topic-state  (legacy alias)
#   UMP_TELEGRAM_DRY_RUN=1
#
# Topic state notes:
# - The default state is $HOME/.pearz/telegram-topics.
# - Old single-file TSV state and the temporary *.d directory layout
#   are both read for backward compatibility.
# - Game aliases are matched canonically, so "MeowTrail" and
#   "Meow Trail" resolve to the same remembered topic.
# - Topic creation is protected by a cross-branch mkdir lock so two
#   multibranch builds cannot create duplicate topics concurrently.
#
# Build metadata:
#   Builds/ump_build_info.txt
#   Builds/ump_drive_url.txt
#   Builds/ump_build_info_drive_url.txt
# ============================================================

INFO_FILE="${UMP_BUILD_INFO:-Builds/ump_build_info.txt}"
DRIVE_URL_FILE="${UMP_DRIVE_URL_FILE:-Builds/ump_drive_url.txt}"
BUILD_INFO_URL_FILE="${UMP_BUILD_INFO_DRIVE_URL_FILE:-Builds/ump_build_info_drive_url.txt}"
STATUS="${UMP_BUILD_STATUS:-${BUILD_STATUS:-UNKNOWN}}"
ARTIFACT="${UMP_ARTIFACT:-}"
BRANCH="${BRANCH_NAME:-}"
BUILD_NO="${BUILD_NUMBER:-}"
JENKINS_URL="${BUILD_URL:-}"

read_kv() {
    local file="$1"
    local key="$2"
    [ -f "$file" ] || return 0
    awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$file" \
        | tr -d '\r'
}

PRODUCT_NAME="$(read_kv "$INFO_FILE" PRODUCT_NAME)"
VERSION="$(read_kv "$INFO_FILE" VERSION)"
BUILD_VERSION="$(read_kv "$INFO_FILE" BUILD_NUMBER)"
PACKAGE_NAME="$(read_kv "$INFO_FILE" PACKAGE_NAME)"
DRIVE_URL="$(read_kv "$DRIVE_URL_FILE" url)"
BUILD_INFO_URL="$(read_kv "$BUILD_INFO_URL_FILE" url)"
JOB_GAME="${JOB_NAME%%/*}"

GAME="${UMP_GAME_NAME:-$PRODUCT_NAME}"
if [ -z "$GAME" ]; then
    GAME="$JOB_GAME"
fi
[ -n "$GAME" ] || GAME="Game"

# Build platform is derived from the release branch.
# Android: release/android, release/android-test
# iOS:     release/ios, release/ios-test
PLATFORM_LABEL=""
case "$BRANCH" in
    release/android|release/android-test)
        PLATFORM_LABEL="Android"
        ;;
    release/ios|release/ios-test)
        PLATFORM_LABEL="IOS"
        ;;
esac

case "$STATUS" in
    SUCCESS) ICON="✅" ;;
    UNSTABLE) ICON="⚠️" ;;
    ABORTED) ICON="⏹️" ;;
    NOT_BUILT) ICON="⏭️" ;;
    *) ICON="❌" ;;
esac

if [ -n "$PLATFORM_LABEL" ]; then
    MESSAGE="$ICON [$PLATFORM_LABEL Build] $GAME - $STATUS"
else
    MESSAGE="$ICON $GAME - $STATUS"
fi
append_line() {
    MESSAGE="${MESSAGE}"$'\n'"$1"
}

[ -n "$BRANCH" ] && append_line "Branch: $BRANCH"
[ -n "$BUILD_NO" ] && append_line "Build: #$BUILD_NO"

if [ -n "$VERSION" ] && [ -n "$BUILD_VERSION" ]; then
    append_line "Version: $VERSION ($BUILD_VERSION)"
elif [ -n "$VERSION" ]; then
    append_line "Version: $VERSION"
fi

[ -n "$PACKAGE_NAME" ] && append_line "Package: $PACKAGE_NAME"

if [ -n "$ARTIFACT" ]; then
    append_line "Artifact: $(basename "$ARTIFACT")"
fi

[ -n "$DRIVE_URL" ] && append_line "Drive: $DRIVE_URL"
[ -n "$BUILD_INFO_URL" ] && append_line "Build Info: $BUILD_INFO_URL"
[ -n "$JENKINS_URL" ] && append_line "Jenkins: $JENKINS_URL"

if [ "${UMP_TELEGRAM_DRY_RUN:-0}" = "1" ]; then
    echo "========================================"
    echo "[PEARZ] Telegram dry run"
    printf '%s\n' "$MESSAGE"
    echo "========================================"
    exit 0
fi

TOKEN="${UMP_TELEGRAM_BOT_TOKEN:-}"
CHAT_ID="${UMP_TELEGRAM_CHAT_ID:-}"

if [ -z "$TOKEN" ] || [ -z "$CHAT_ID" ]; then
    echo "[PEARZ] ERROR: Telegram bot token/chat id is missing."
    exit 1
fi

# Strip accidental whitespace/quotes from Jenkins secret text values.
TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]' | sed "s/^['\"]//; s/['\"]$//")"
CHAT_ID="$(printf '%s' "$CHAT_ID" | tr -d '[:space:]' | sed "s/^['\"]//; s/['\"]$//")"

API="https://api.telegram.org/bot${TOKEN}"

json_result_field() {
    local field="$1"
    ruby -rjson -e '
        field = ARGV.fetch(0)
        begin
          json = JSON.parse(STDIN.read)
          value = json.dig("result", field)
          print(value.to_s) unless value.nil?
        rescue StandardError
        end
    ' "$field"
}

BOT_JSON="$(curl -fsS --max-time 20 "$API/getMe" 2>/dev/null || true)"
BOT_USER="$(printf '%s' "$BOT_JSON" | json_result_field username)"
[ -n "$BOT_USER" ] && echo "[PEARZ] Telegram bot: @$BOT_USER"

CHAT_JSON="$(curl -fsS --max-time 20 \
    --get --data-urlencode "chat_id=$CHAT_ID" \
    "$API/getChat" 2>/dev/null || true)"
CHAT_TITLE="$(printf '%s' "$CHAT_JSON" | json_result_field title)"
IS_FORUM="$(printf '%s' "$CHAT_JSON" | json_result_field is_forum)"
if [ -n "$CHAT_TITLE" ]; then
    echo "[PEARZ] Telegram chat: $CHAT_TITLE"
else
    echo "[PEARZ] Telegram chat: $CHAT_ID"
fi

truthy() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
        *) return 1 ;;
    esac
}

safe_name() {
    printf '%s' "$1" \
        | tr ' /:' '___' \
        | tr -cd '[:alnum:]_.-'
}

canonical_name() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -cd '[:alnum:]'
}

game_alias_matches() {
    local candidate="$1"
    local wanted
    local alias

    wanted="$(canonical_name "$candidate")"
    [ -n "$wanted" ] || return 1

    for alias in "$GAME" "$PRODUCT_NAME" "$JOB_GAME" "${UMP_GAME_NAME:-}"; do
        [ -n "$alias" ] || continue
        if [ "$(canonical_name "$alias")" = "$wanted" ]; then
            return 0
        fi
    done

    return 1
}

topic_root() {
    printf '%s' "${UMP_TELEGRAM_TOPIC_CACHE:-${UMP_TELEGRAM_TOPIC_STATE:-$HOME/.pearz/telegram-topics}}"
}

mapped_topic() {
    local mappings="${UMP_TELEGRAM_TOPICS:-}"
    local pair
    local name
    local id
    [ -n "$mappings" ] || return 0

    while IFS= read -r pair; do
        [ -n "$pair" ] || continue
        name="${pair%%=*}"
        id="${pair#*=}"
        id="$(printf '%s' "$id" | tr -d '[:space:]')"
        if game_alias_matches "$name" && printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            printf '%s' "$id"
            return 0
        fi
    done < <(printf '%s' "$mappings" | tr ';' '\n')
}

topic_from_tsv_file() {
    local file="$1"
    local chat
    local name
    local id

    [ -f "$file" ] || return 0

    while IFS=$'\t' read -r chat name id _rest; do
        [ "$chat" = "$CHAT_ID" ] || continue
        printf '%s' "$id" | grep -Eq '^[0-9]+$' || continue
        if game_alias_matches "$name"; then
            printf '%s' "$id"
            return 0
        fi
    done < "$file"
}

topic_from_kv_file() {
    local file="$1"
    local name
    local chat
    local id

    [ -f "$file" ] || return 0

    name="$(read_kv "$file" GAME)"
    chat="$(read_kv "$file" CHAT_ID)"
    id="$(read_kv "$file" TOPIC_ID)"

    [ -n "$name" ] || return 0
    [ -z "$chat" ] || [ "$chat" = "$CHAT_ID" ] || return 0
    printf '%s' "$id" | grep -Eq '^[0-9]+$' || return 0

    if game_alias_matches "$name"; then
        printf '%s' "$id"
        return 0
    fi
}

topic_from_directory() {
    local dir="$1"
    local candidate
    local id

    [ -d "$dir" ] || return 0

    while IFS= read -r candidate; do
        [ -f "$candidate" ] || continue

        id="$(topic_from_kv_file "$candidate")"
        if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            printf '%s' "$id"
            return 0
        fi
    done < <(find "$dir" -maxdepth 2 -type f 2>/dev/null | head -n 200)
}

cached_topic() {
    local root
    local id
    root="$(topic_root)"

    # Original reliable layout: one TSV file keyed by chat + game + topic.
    if [ -f "$root" ]; then
        id="$(topic_from_tsv_file "$root")"
        if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            echo "[PEARZ] Telegram topic cache hit (legacy state): $id" >&2
            printf '%s' "$id"
            return 0
        fi
    fi

    # Directory layout used by some 1.0.10 builds.
    if [ -d "$root" ]; then
        id="$(topic_from_directory "$root")"
        if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            echo "[PEARZ] Telegram topic cache hit: $id" >&2
            printf '%s' "$id"
            return 0
        fi
    fi

    # Regression compatibility: 1.0.10 wrote new topics to <state>.d when
    # the old single-file state already existed, but its reader never looked
    # there. Read it now so already-created topics stop multiplying.
    if [ -d "${root}.d" ]; then
        id="$(topic_from_directory "${root}.d")"
        if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
            echo "[PEARZ] Telegram topic cache hit (1.0.10 .d migration): $id" >&2
            printf '%s' "$id"
            return 0
        fi
    fi
}

store_topic() {
    local id="$1"
    local root
    local safe
    local tmp
    root="$(topic_root)"
    safe="$(safe_name "$GAME")"

    # If the configured root is already a directory, preserve that layout.
    if [ -d "$root" ]; then
        mkdir -p "$root"
        cat > "$root/${safe}.topic" <<CACHE
GAME=$GAME
CHAT_ID=$CHAT_ID
TOPIC_ID=$id
CACHE
        return 0
    fi

    # Default / legacy layout: one TSV state file. This is shared by all
    # branches and survives workspace cleanups.
    mkdir -p "$(dirname "$root")"
    touch "$root"
    tmp="${root}.tmp.$$"

    awk -F'\t' -v chat="$CHAT_ID" -v game="$GAME" \
        '!($1 == chat && $2 == game)' \
        "$root" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$root"

    printf '%s\t%s\t%s\n' "$CHAT_ID" "$GAME" "$id" >> "$root"
}

TOPIC_LOCK_DIR=""
acquire_topic_lock() {
    local key
    local lock_root
    local attempts=0

    key="$(canonical_name "${CHAT_ID}_${GAME}")"
    [ -n "$key" ] || key="topic"
    lock_root="${UMP_TELEGRAM_TOPIC_LOCK_ROOT:-$HOME/.pearz/telegram-topic-locks}"
    mkdir -p "$lock_root"
    TOPIC_LOCK_DIR="$lock_root/${key}.lock"

    while ! mkdir "$TOPIC_LOCK_DIR" 2>/dev/null; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 30 ]; then
            echo "[PEARZ] Telegram topic lock timeout: $TOPIC_LOCK_DIR" >&2
            TOPIC_LOCK_DIR=""
            return 1
        fi
        sleep 1
    done

    return 0
}

release_topic_lock() {
    if [ -n "$TOPIC_LOCK_DIR" ]; then
        rmdir "$TOPIC_LOCK_DIR" 2>/dev/null || true
        TOPIC_LOCK_DIR=""
    fi
}

create_topic() {
    local response
    local id

    # Do not call createForumTopic for normal non-forum groups.
    if [ -n "$IS_FORUM" ] && ! truthy "$IS_FORUM"; then
        echo "[PEARZ] Telegram chat is not a forum; topic creation skipped." >&2
        return 0
    fi

    response="$(curl -fsS --max-time 20 -X POST \
        --data-urlencode "chat_id=$CHAT_ID" \
        --data-urlencode "name=$GAME" \
        "$API/createForumTopic" 2>/dev/null || true)"
    id="$(printf '%s' "$response" | json_result_field message_thread_id)"
    if printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
        store_topic "$id"
        echo "[PEARZ] Telegram topic '$GAME' created: $id" >&2
        printf '%s' "$id"
    fi
}

TOPIC_ID="${UMP_TELEGRAM_TOPIC_ID:-}"
if [ -z "$TOPIC_ID" ]; then
    TOPIC_ID="$(mapped_topic)"
fi
if [ -z "$TOPIC_ID" ]; then
    TOPIC_ID="$(cached_topic)"
fi

# Only topic creation needs the cross-branch lock. Re-check the cache after
# acquiring it: another Android/iOS branch may have created the topic while
# this build was waiting.
if [ -z "$TOPIC_ID" ] && truthy "${UMP_TELEGRAM_AUTO_TOPIC:-1}"; then
    if acquire_topic_lock; then
        TOPIC_ID="$(cached_topic)"
        if [ -z "$TOPIC_ID" ]; then
            TOPIC_ID="$(create_topic)"
        fi
        release_topic_lock
    fi
fi

if [ -n "$TOPIC_ID" ]; then
    echo "[PEARZ] Telegram topic '$GAME': $TOPIC_ID"
fi

json_top_field() {
    local field="$1"
    ruby -rjson -e '''
        field = ARGV.fetch(0)
        begin
          json = JSON.parse(STDIN.read)
          value = json[field]
          if value == true
            print "true"
          elsif value == false
            print "false"
          elsif !value.nil?
            print value.to_s
          end
        rescue StandardError
        end
    ''' "$field"
}

tg_ok() {
    [ "$(printf '%s' "$1" | json_top_field ok)" = "true" ]
}

tg_description() {
    printf '%s' "$1" | json_top_field description
}

send_message() {
    local thread_id="${1:-}"
    local args=(
        -sS
        --max-time 30
        -X POST
        --data-urlencode "chat_id=$CHAT_ID"
        --data-urlencode "text=$MESSAGE"
        --data-urlencode "disable_web_page_preview=true"
    )

    if [ -n "$thread_id" ]; then
        args+=(--data-urlencode "message_thread_id=$thread_id")
    fi

    # Do not use curl -f here. Telegram returns useful JSON on HTTP 400
    # (closed/deleted/wrong topic). Jenkins intentionally treats Telegram
    # as non-fatal, so swallowing that body used to make notifications
    # disappear while the build still showed SUCCESS.
    curl "${args[@]}" "$API/sendMessage" 2>/dev/null || true
}

RESPONSE="$(send_message "$TOPIC_ID")"

if ! tg_ok "$RESPONSE"; then
    DESCRIPTION="$(tg_description "$RESPONSE")"
    echo "[PEARZ] Telegram send failed${TOPIC_ID:+ for topic $TOPIC_ID}: ${DESCRIPTION:-unknown error}" >&2

    if [ -n "$TOPIC_ID" ]; then
        case "$DESCRIPTION" in
            *TOPIC_CLOSED*|*"topic was closed"*|*"topic closed"*)
                echo "[PEARZ] Reopening existing Telegram topic $TOPIC_ID..." >&2
                REOPEN_RESPONSE="$(curl -sS --max-time 20 -X POST                     --data-urlencode "chat_id=$CHAT_ID"                     --data-urlencode "message_thread_id=$TOPIC_ID"                     "$API/reopenForumTopic" 2>/dev/null || true)"

                if tg_ok "$REOPEN_RESPONSE"; then
                    RESPONSE="$(send_message "$TOPIC_ID")"
                else
                    echo "[PEARZ] Could not reopen topic $TOPIC_ID: $(tg_description "$REOPEN_RESPONSE")" >&2
                fi
                ;;
        esac
    fi
fi

# Never auto-create another topic just because a remembered topic refused
# a message. That is exactly how duplicate game topics were produced.
# If the remembered topic is gone/invalid (or any topic retry still fails),
# post once to the group/general topic so the build notification is not lost.
if ! tg_ok "$RESPONSE" && [ -n "$TOPIC_ID" ]; then
    DESCRIPTION="$(tg_description "$RESPONSE")"
    echo "[PEARZ] Falling back to Telegram group/general topic; cached game topic is kept." >&2
    echo "[PEARZ] Cached topic '$GAME' = $TOPIC_ID. Reason: ${DESCRIPTION:-unknown error}" >&2
    RESPONSE="$(send_message "")"
fi

if tg_ok "$RESPONSE"; then
    echo "[PEARZ] Telegram notification sent."
else
    DESCRIPTION="$(tg_description "$RESPONSE")"
    echo "[PEARZ] ERROR: Telegram notification was not sent: ${DESCRIPTION:-no response from Telegram}" >&2
    # Keep Telegram non-fatal for Jenkins, but make the failure unmistakable
    # in the console instead of silently disappearing behind `|| true`.
    exit 2
fi
