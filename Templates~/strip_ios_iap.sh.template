#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ iOS device build - remove local IAP capability metadata
# and isolate the Personal Team test build from the production
# App ID by using a dedicated bundle id.
#
# Runs AFTER Unity export and BEFORE xcodebuild.
#
# Default on release/ios-test:
#   com.company.game -> com.company.game.device
#
# Overrides:
#   UMP_IOS_PROJECT=/path/to/Unity-iPhone.xcodeproj
#   UMP_IOS_DEVICE_BUNDLE_ID=com.company.game.mydevice
#   UMP_IOS_KEEP_BUNDLE_ID=1      # do not change bundle id
#   UMP_IOS_STRIP_BRANCH=""       # allow any branch
# ============================================================

echo "========================================"
echo "[PEARZ] iOS device project fix"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

STRIP_BRANCH="${UMP_IOS_STRIP_BRANCH-release/ios-test}"
if [ -n "$STRIP_BRANCH" ] && [ -n "${BRANCH_NAME:-}" ] && \
   [ "$BRANCH_NAME" != "$STRIP_BRANCH" ]; then
    echo "[PEARZ] Branch ${BRANCH_NAME} is not $STRIP_BRANCH."
    echo "[PEARZ] Project left unchanged."
    exit 0
fi

PROJECT="${UMP_IOS_PROJECT:-}"
if [ -z "$PROJECT" ]; then
    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project found under $WORKSPACE/Builds/iOS"
    exit 1
fi

PBXPROJ="$PROJECT/project.pbxproj"
if [ ! -f "$PBXPROJ" ]; then
    echo "[PEARZ] ERROR: missing $PBXPROJ"
    exit 1
fi

SCHEME="${IOS_SCHEME:-Unity-iPhone}"
CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"
BACKUP="$(mktemp "${TMPDIR:-/tmp}/ump-pbxproj-XXXXXX")"
cp "$PBXPROJ" "$BACKUP"

restore_on_error() {
    local code=$?
    if [ "$code" -ne 0 ]; then
        echo "[PEARZ] ERROR: restoring project.pbxproj after failed edit."
        cp "$BACKUP" "$PBXPROJ" 2>/dev/null || true
    fi
    rm -f "$BACKUP"
    exit "$code"
}
trap restore_on_error EXIT

signing_state() {
    grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam|PROVISIONING_PROFILE_SPECIFIER|ProvisioningStyle)[ \t]*=[ \t]*[^;]*;' \
        "$PBXPROJ" 2>/dev/null | sort -u || true
}

SIGNING_BEFORE="$(signing_state)"

echo "[PEARZ] Project       : $PROJECT"
echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"

if [ -n "$SIGNING_BEFORE" ]; then
    echo "[PEARZ] Signing before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
fi

# ------------------------------------------------------------
# 1) Remove the local Xcode capability marker if Unity or a
# package wrote it. This mirrors the project-file part of pressing
# '-' on In-App Purchase in Signing & Capabilities.
# ------------------------------------------------------------
IAP_BEFORE="$(grep -nE 'com\.apple\.InAppPurchase|In-App Purchase' "$PBXPROJ" 2>/dev/null || true)"

if [ -n "$IAP_BEFORE" ]; then
    echo "[PEARZ] Local IAP metadata before:"
    echo "$IAP_BEFORE" | sed 's/^/[PEARZ]   /'
fi

perl -0pi -e '
    s/^[ \t]*"?com\.apple\.InAppPurchase"?[ \t]*=[ \t]*\{[^{}]*\};[ \t]*\r?\n//mg;
    s/^[ \t]*SystemCapabilities[ \t]*=[ \t]*\{[ \t\r\n]*\};[ \t]*\r?\n//mg;
' "$PBXPROJ"

IAP_AFTER="$(grep -nE 'com\.apple\.InAppPurchase' "$PBXPROJ" 2>/dev/null || true)"
if [ -n "$IAP_AFTER" ]; then
    echo "[PEARZ] ERROR: com.apple.InAppPurchase is still present:"
    echo "$IAP_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

echo "[PEARZ] Local IAP capability marker: absent."

# ------------------------------------------------------------
# 2) Resolve the app target bundle id.
# ------------------------------------------------------------
SETTINGS="$(xcodebuild -showBuildSettings \
    -project "$PROJECT" \
    -scheme "$SCHEME" \
    -configuration "$CONFIGURATION" \
    2>/dev/null || true)"

BUNDLE_ID="$(echo "$SETTINGS" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

if [ -z "$BUNDLE_ID" ]; then
    BUNDLE_ID="$(grep -hoE 'PRODUCT_BUNDLE_IDENTIFIER[ \t]*=[ \t]*"?[A-Za-z0-9._-]+"?;' \
        "$PBXPROJ" 2>/dev/null \
        | sed -E 's/.*=[ \t]*"?([^";]+)"?;.*/\1/' \
        | grep -v '^com\.unity3d\.' \
        | head -n 1 || true)"
fi

if [ -z "$BUNDLE_ID" ]; then
    echo "[PEARZ] ERROR: cannot determine app bundle id."
    exit 1
fi

echo "[PEARZ] Original bundle id: $BUNDLE_ID"

# ------------------------------------------------------------
# 3) Personal Team isolation.
#
# The production App ID can keep In-App Purchase enabled on
# Apple's signing side even when the exported pbxproj has no IAP
# marker. release/ios-test therefore gets its own stable App ID.
# This does not touch PlayerSettings or the release/ios workspace.
# ------------------------------------------------------------
DEVICE_BUNDLE_ID="$BUNDLE_ID"

if [ "${UMP_IOS_KEEP_BUNDLE_ID:-0}" != "1" ]; then
    if [ -n "${UMP_IOS_DEVICE_BUNDLE_ID:-}" ]; then
        DEVICE_BUNDLE_ID="$UMP_IOS_DEVICE_BUNDLE_ID"
    else
        case "$BUNDLE_ID" in
            *.device) DEVICE_BUNDLE_ID="$BUNDLE_ID" ;;
            *) DEVICE_BUNDLE_ID="${BUNDLE_ID}.device" ;;
        esac
    fi
fi

if [ "$DEVICE_BUNDLE_ID" != "$BUNDLE_ID" ]; then
    echo "[PEARZ] Device bundle id  : $DEVICE_BUNDLE_ID"

    OLD_BUNDLE_ID="$BUNDLE_ID" \
    NEW_BUNDLE_ID="$DEVICE_BUNDLE_ID" \
    perl -pi -e '
        if (/PRODUCT_BUNDLE_IDENTIFIER\s*=/ && index($_, $ENV{"OLD_BUNDLE_ID"}) >= 0) {
            s/\Q$ENV{"OLD_BUNDLE_ID"}\E/$ENV{"NEW_BUNDLE_ID"}/g;
        }
    ' "$PBXPROJ"
else
    echo "[PEARZ] Device bundle id  : unchanged"
fi

# Xcode must still be able to parse the project after our edits.
if ! xcodebuild -list -project "$PROJECT" >/dev/null 2>&1; then
    echo "[PEARZ] ERROR: Xcode cannot parse the edited project."
    exit 1
fi

SETTINGS_AFTER="$(xcodebuild -showBuildSettings \
    -project "$PROJECT" \
    -scheme "$SCHEME" \
    -configuration "$CONFIGURATION" \
    2>/dev/null || true)"

BUNDLE_AFTER="$(echo "$SETTINGS_AFTER" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

if [ "$BUNDLE_AFTER" != "$DEVICE_BUNDLE_ID" ]; then
    echo "[PEARZ] ERROR: bundle id patch did not take effect."
    echo "[PEARZ] Expected: $DEVICE_BUNDLE_ID"
    echo "[PEARZ] Actual  : ${BUNDLE_AFTER:-<empty>}"
    exit 1
fi

SIGNING_AFTER="$(signing_state)"
if [ "$SIGNING_BEFORE" != "$SIGNING_AFTER" ]; then
    echo "[PEARZ] ERROR: signing settings changed unexpectedly."
    echo "[PEARZ] Before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
    echo "[PEARZ] After:"
    echo "$SIGNING_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

# Diagnostic only. StoreKit may remain linked because the game
# still contains Unity IAP code; that is not the Xcode capability
# marker this script removes.
echo "[PEARZ] Remaining StoreKit references (diagnostic):"
grep -nEi 'StoreKit|InAppPurchase|In-App Purchase' "$PBXPROJ" \
    | head -n 30 \
    | sed 's/^/[PEARZ]   /' || true

echo "[PEARZ] Verified bundle id : $BUNDLE_AFTER"
echo "[PEARZ] Verified signing   : unchanged"
echo "========================================"
echo "[PEARZ] iOS device project fix finished"
echo "========================================"

trap - EXIT
rm -f "$BACKUP"
