#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ iOS device build - final IAP cleanup/verification.
#
# Runs AFTER Unity export and BEFORE xcodebuild.
#
# Unity's JenkinsBuild.cs removes StoreKit.framework from the
# Unity-iPhone app target while intentionally keeping StoreKit on
# UnityFramework. This script then removes any remaining literal
# In-App Purchase capability marker from project.pbxproj and verifies
# that signing/bundle-id settings were not changed.
#
# Optional env vars:
#   UMP_IOS_PROJECT=/path/to/Unity-iPhone.xcodeproj
#   IOS_SCHEME=Unity-iPhone
#   UMP_IOS_CONFIGURATION=Release
#   UMP_IOS_STRIP_BRANCH=""       # allow any branch
# ============================================================

echo "========================================"
echo "[PEARZ] iOS IAP final cleanup"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

STRIP_BRANCH="${UMP_IOS_STRIP_BRANCH-release/ios-test}"
if [ -n "$STRIP_BRANCH" ] && [ -n "${BRANCH_NAME:-}" ] && \
   [ "$BRANCH_NAME" != "$STRIP_BRANCH" ]; then
    echo "[PEARZ] Branch ${BRANCH_NAME} is not $STRIP_BRANCH."
    echo "[PEARZ] Project left unchanged."
    exit 0
fi

PROJECT="${UMP_IOS_PROJECT:-}"
if [ -z "$PROJECT" ]; then
    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project found under $WORKSPACE/Builds/iOS"
    exit 1
fi

PBXPROJ="$PROJECT/project.pbxproj"
if [ ! -f "$PBXPROJ" ]; then
    echo "[PEARZ] ERROR: missing $PBXPROJ"
    exit 1
fi

SCHEME="${IOS_SCHEME:-Unity-iPhone}"
CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"
BACKUP="$(mktemp "${TMPDIR:-/tmp}/ump-pbxproj-XXXXXX")"
cp "$PBXPROJ" "$BACKUP"

restore_on_error() {
    local code=$?
    if [ "$code" -ne 0 ]; then
        echo "[PEARZ] ERROR: restoring project.pbxproj after failed edit."
        cp "$BACKUP" "$PBXPROJ" 2>/dev/null || true
    fi
    rm -f "$BACKUP"
    exit "$code"
}
trap restore_on_error EXIT

signing_state() {
    grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam|PROVISIONING_PROFILE_SPECIFIER|ProvisioningStyle)[ \t]*=[ \t]*[^;]*;' \
        "$PBXPROJ" 2>/dev/null | sort -u || true
}

show_build_settings() {
    xcodebuild -showBuildSettings \
        -project "$PROJECT" \
        -scheme "$SCHEME" \
        -configuration "$CONFIGURATION" \
        2>/dev/null || true
}

SIGNING_BEFORE="$(signing_state)"
SETTINGS_BEFORE="$(show_build_settings)"
BUNDLE_BEFORE="$(echo "$SETTINGS_BEFORE" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

echo "[PEARZ] Project       : $PROJECT"
echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"
echo "[PEARZ] Bundle id     : ${BUNDLE_BEFORE:-<unknown>}"

if [ -n "$SIGNING_BEFORE" ]; then
    echo "[PEARZ] Signing before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
fi

# ------------------------------------------------------------
# Remove only the literal Xcode capability marker. Do not change
# PRODUCT_BUNDLE_IDENTIFIER and do not remove Unity IAP source files.
# ------------------------------------------------------------
IAP_BEFORE="$(grep -nE 'com\.apple\.InAppPurchase|In-App Purchase' \
    "$PBXPROJ" 2>/dev/null || true)"

if [ -n "$IAP_BEFORE" ]; then
    echo "[PEARZ] Local IAP metadata before:"
    echo "$IAP_BEFORE" | sed 's/^/[PEARZ]   /'
fi

perl -0pi -e '
    s/^[ \t]*"?com\.apple\.InAppPurchase"?[ \t]*=[ \t]*\{[^{}]*\};[ \t]*\r?\n//mg;
    s/^[ \t]*SystemCapabilities[ \t]*=[ \t]*\{[ \t\r\n]*\};[ \t]*\r?\n//mg;
' "$PBXPROJ"

IAP_AFTER="$(grep -nE 'com\.apple\.InAppPurchase' "$PBXPROJ" 2>/dev/null || true)"
if [ -n "$IAP_AFTER" ]; then
    echo "[PEARZ] ERROR: com.apple.InAppPurchase is still present:"
    echo "$IAP_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

echo "[PEARZ] Local IAP capability marker: absent."

# Xcode must still be able to parse the edited project.
if ! xcodebuild -list -project "$PROJECT" >/dev/null 2>&1; then
    echo "[PEARZ] ERROR: Xcode cannot parse the edited project."
    exit 1
fi

SETTINGS_AFTER="$(show_build_settings)"
BUNDLE_AFTER="$(echo "$SETTINGS_AFTER" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"
SIGNING_AFTER="$(signing_state)"

if [ -n "$BUNDLE_BEFORE" ] && [ "$BUNDLE_AFTER" != "$BUNDLE_BEFORE" ]; then
    echo "[PEARZ] ERROR: bundle id changed unexpectedly."
    echo "[PEARZ] Before: $BUNDLE_BEFORE"
    echo "[PEARZ] After : ${BUNDLE_AFTER:-<empty>}"
    exit 1
fi

if [ "$SIGNING_BEFORE" != "$SIGNING_AFTER" ]; then
    echo "[PEARZ] ERROR: signing settings changed unexpectedly."
    echo "[PEARZ] Before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
    echo "[PEARZ] After:"
    echo "$SIGNING_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

# Count PBXBuildFile declarations, not all comment occurrences. A single
# framework membership is referenced twice textually in a pbxproj (object
# declaration + build-phase child), so counting comments would be wrong.
# For the device build we expect at most one StoreKit PBXBuildFile: the
# UnityFramework membership intentionally preserved by JenkinsBuild.cs.
STOREKIT_BUILD_COUNT="$(grep -Ec 'isa = PBXBuildFile;.*StoreKit\.framework' \
    "$PBXPROJ" 2>/dev/null || true)"
STOREKIT_BUILD_COUNT="${STOREKIT_BUILD_COUNT:-0}"

echo "[PEARZ] StoreKit PBXBuildFile entries: $STOREKIT_BUILD_COUNT"
grep -nE 'isa = PBXBuildFile;.*StoreKit\.framework' "$PBXPROJ" \
    | head -n 20 \
    | sed 's/^/[PEARZ]   /' || true

if [ "$STOREKIT_BUILD_COUNT" -gt 1 ]; then
    echo "[PEARZ] ERROR: StoreKit.framework is still linked by more than one target."
    echo "[PEARZ] The Unity post-export cleanup did not remove it from Unity-iPhone."
    echo "[PEARZ] Check for this Unity log line:"
    echo "[PEARZ]   Removed StoreKit.framework from Unity-iPhone target only."
    exit 1
fi

echo "[PEARZ] Remaining StoreKit/IAP references (diagnostic only):"
grep -nEi 'StoreKit|InAppPurchase|In-App Purchase' "$PBXPROJ" \
    | head -n 40 \
    | sed 's/^/[PEARZ]   /' || true

echo "[PEARZ] Verified bundle id : ${BUNDLE_AFTER:-<unknown>}"
echo "[PEARZ] Verified signing   : unchanged"
echo "========================================"
echo "[PEARZ] iOS IAP final cleanup finished"
echo "========================================"

trap - EXIT
rm -f "$BACKUP"
