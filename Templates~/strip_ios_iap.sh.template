#!/bin/bash

set -euo pipefail

# ============================================================
# PEARZ iOS - remove In-App Purchase from the Xcode project
# Unity just exported, and prove it is gone.
#
# Runs between the Unity build and xcodebuild, on purpose. Unity
# packages add capabilities from post-process build callbacks -
# com.unity.purchasing calls ProjectCapabilityManager.
# AddInAppPurchase() - and callback order is not something a
# build can rely on. Once the Unity process has exited, nothing
# else writes to the project, so a strip here is the last word.
#
# Signing is never touched: DEVELOPMENT_TEAM, provisioning and
# the bundle id set up in Xcode on this Mac are read before and
# after, and a change in any of them fails the step.
#
# Only for the device test build on release/ios-test. A paid team
# signs In-App Purchase, so nothing needs removing there and the
# build stays identical to the one that ships - the step gets out
# of the way on its own when it sees one.
#
# Optional Jenkins env vars:
#   UMP_IOS_PROJECT       path to the .xcodeproj, when the guess
#                         below is wrong
#   UMP_IOS_STRIP_CAPABILITIES
#                         capabilities to remove
#                         (com.apple.InAppPurchase by default)
#   UMP_IOS_PAID_TEAM=1   skip; 0 strips even so. Read from the
#                         provisioning profiles when unset.
#   UMP_IOS_STRIP_BRANCH  branch this may run on
#                         (release/ios-test; "" allows any)
#   UMP_IOS_STRIP_STRICT=0
#                         warn instead of failing when something
#                         survives the strip
# ============================================================

echo "========================================"
echo "[PEARZ] iOS strip capabilities"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

STRIP="${UMP_IOS_STRIP_CAPABILITIES-com.apple.InAppPurchase}"

if [ -z "$STRIP" ]; then
    echo "[PEARZ] UMP_IOS_STRIP_CAPABILITIES is empty - nothing to do."
    exit 0
fi

# The pipeline only calls this from the iOS Device stage, and the
# check is repeated here so a hand-run on another branch cannot
# quietly take a capability out of a build meant for the store.
STRIP_BRANCH="${UMP_IOS_STRIP_BRANCH-release/ios-test}"

if [ -n "$STRIP_BRANCH" ] && [ -n "${BRANCH_NAME:-}" ] && \
   [ "$BRANCH_NAME" != "$STRIP_BRANCH" ]; then

    echo "[PEARZ] Branch ${BRANCH_NAME} is not $STRIP_BRANCH -"
    echo "[PEARZ] leaving the project alone."
    exit 0
fi

# ------------------------------------------------------------
# Project
# ------------------------------------------------------------

PROJECT="${UMP_IOS_PROJECT:-}"

if [ -z "$PROJECT" ]; then

    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project under"
    echo "$WORKSPACE/Builds/iOS"
    echo "[PEARZ] Run the Unity iOS build first."
    exit 1
fi

PBXPROJ="$PROJECT/project.pbxproj"
PROJECT_DIR="$(dirname "$PROJECT")"

if [ ! -f "$PBXPROJ" ]; then
    echo "[PEARZ] ERROR: $PBXPROJ is missing."
    exit 1
fi

echo "[PEARZ] Project      : $PROJECT"
echo "[PEARZ] Stripping    : $STRIP"

# ------------------------------------------------------------
# Signing, before
#
# Read straight out of the project file rather than through
# xcodebuild: this has to stay readable even when the project
# cannot be built, which is the situation being fixed.
# ------------------------------------------------------------

signing_state() {

    grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam|PROVISIONING_PROFILE_SPECIFIER|ProvisioningStyle|PRODUCT_BUNDLE_IDENTIFIER)[ \t]*=[ \t]*[^;]*;' \
        "$PBXPROJ" 2>/dev/null | sort -u || true
}

SIGNING_BEFORE="$(signing_state)"

if [ -n "$SIGNING_BEFORE" ]; then

    echo "[PEARZ] Signing in the project:"
    echo "$SIGNING_BEFORE" | sed 's|^|[PEARZ]   |'

else

    echo "[PEARZ] WARNING: no signing settings found in the project."
fi

# ------------------------------------------------------------
# Paid team?
#
# Apple issues a free Personal Team development profiles that
# last a week, and an Apple Developer Program team ones that last
# a year. The profiles on this Mac are the only place that shows
# up, and the gap between the two is far too wide to confuse.
#
# A paid team signs In-App Purchase, so removing it would only
# make the device build differ from the one that ships.
# ------------------------------------------------------------

TEAM="$(grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam)[ \t]*=[ \t]*"?[A-Z0-9]{10}' \
    "$PBXPROJ" 2>/dev/null | grep -oE '[A-Z0-9]{10}$' | sort -u | head -n 1 || true)"

# Days a profile of this team stays valid, the longest one found.
team_profile_days() {

    local team="$1"
    local dir
    local profile
    local plist
    local owner
    local created
    local expires
    local days
    local best=0

    [ -n "$team" ] || return 0

    for dir in \
        "$HOME/Library/MobileDevice/Provisioning Profiles" \
        "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"; do

        [ -d "$dir" ] || continue

        for profile in "$dir"/*.mobileprovision; do

            [ -f "$profile" ] || continue

            plist="$(security cms -D -i "$profile" 2>/dev/null || true)"

            [ -n "$plist" ] || continue

            owner="$(echo "$plist" \
                | plutil -extract TeamIdentifier.0 raw - 2>/dev/null || true)"

            [ "$owner" = "$team" ] || continue

            created="$(echo "$plist" \
                | plutil -extract CreationDate raw - 2>/dev/null || true)"

            expires="$(echo "$plist" \
                | plutil -extract ExpirationDate raw - 2>/dev/null || true)"

            created="$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$created" +%s \
                2>/dev/null || true)"

            expires="$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$expires" +%s \
                2>/dev/null || true)"

            [ -n "$created" ] && [ -n "$expires" ] || continue

            days=$(( (expires - created) / 86400 ))

            [ "$days" -gt "$best" ] && best="$days"
        done
    done

    echo "$best"
}

PAID="${UMP_IOS_PAID_TEAM:-}"

if [ -z "$PAID" ]; then

    PROFILE_DAYS="$(team_profile_days "$TEAM")"

    if [ "${PROFILE_DAYS:-0}" -gt 30 ]; then

        echo "[PEARZ] Team $TEAM has profiles valid ${PROFILE_DAYS} days,"
        echo "[PEARZ] which only a paid team is given."

        PAID=1

    elif [ "${PROFILE_DAYS:-0}" -gt 0 ]; then

        echo "[PEARZ] Team $TEAM has profiles valid ${PROFILE_DAYS} days -"
        echo "[PEARZ] a free Personal Team."

        PAID=0

    else

        echo "[PEARZ] No profile of team ${TEAM:-<unknown>} to judge by,"
        echo "[PEARZ] so this is treated as a free Personal Team."

        PAID=0
    fi
fi

if [ "$PAID" = "1" ]; then

    echo "[PEARZ] Paid team - In-App Purchase is signable, so the"
    echo "[PEARZ] project is left exactly as Unity wrote it."
    echo "========================================"
    exit 0
fi

# ------------------------------------------------------------
# Entitlements
#
# Searched by hand rather than through xcodebuild, and deeper
# than the project root, because Unity has moved this file
# between versions.
# ------------------------------------------------------------

ENTITLEMENTS_FOUND="$(find "$PROJECT_DIR" \
    -maxdepth 4 \
    -type f \
    -name "*.entitlements" \
    2>/dev/null | sort -u || true)"

# ------------------------------------------------------------
# Strip
# ------------------------------------------------------------

REMOVED=0

for capability in $STRIP; do

    grep -q "$capability" "$PBXPROJ" 2>/dev/null || continue

    BEFORE="$(shasum "$PBXPROJ" | cut -d' ' -f1)"

    # The key is quoted in some Unity versions and bare in
    # others, and the entry it opens holds "enabled = 1;".
    perl -0pi -e \
        "s/^[ \t]*\"?\Q$capability\E\"?[ \t]*=[ \t]*\{[^{}]*\};[ \t]*\n//mg" \
        "$PBXPROJ"

    # The name can also turn up somewhere the pattern above does
    # not reach, and saying it was removed then would be a lie
    # the verification below has to catch.
    if [ "$BEFORE" = "$(shasum "$PBXPROJ" | cut -d' ' -f1)" ]; then

        echo "[PEARZ] $capability is in the project but not as a"
        echo "[PEARZ] capability entry - left alone."

        continue
    fi

    echo "[PEARZ] Removed $capability from the project."

    REMOVED=$((REMOVED + 1))
done

# An empty SystemCapabilities block left behind is harmless, but
# Xcode rewrites it on open and it reads as leftovers, so it goes.
if perl -0ne 'exit(/SystemCapabilities\s*=\s*\{\s*\};/ ? 0 : 1)' \
    "$PBXPROJ" 2>/dev/null; then

    perl -0pi -e \
        's/^[ \t]*SystemCapabilities\s*=\s*\{\s*\};[ \t]*\n//mg' \
        "$PBXPROJ"

    echo "[PEARZ] Removed the now empty SystemCapabilities block."
fi

# StoreKit and Apple Pay write their own entitlement keys, which
# provisioning reads the same way it reads a capability.
while IFS= read -r entitlements; do

    [ -f "$entitlements" ] || continue

    for key in \
        com.apple.developer.in-app-payments \
        com.apple.developer.storekit-external-purchase \
        com.apple.developer.storekit-external-purchase-link; do

        /usr/libexec/PlistBuddy -c "Print :$key" "$entitlements" \
            >/dev/null 2>&1 || continue

        if /usr/libexec/PlistBuddy -c "Delete :$key" "$entitlements" \
            >/dev/null 2>&1; then

            echo "[PEARZ] Removed $key from $entitlements"

            REMOVED=$((REMOVED + 1))
        fi
    done

done <<ENTITLEMENTS
$ENTITLEMENTS_FOUND
ENTITLEMENTS

if [ "$REMOVED" -eq 0 ]; then
    echo "[PEARZ] Nothing to remove - the project never had it."
fi

# ------------------------------------------------------------
# Verify the capability is gone
# ------------------------------------------------------------

LEFTOVERS=""

for capability in $STRIP; do

    HITS="$(grep -n "$capability" "$PBXPROJ" 2>/dev/null || true)"

    if [ -n "$HITS" ]; then
        LEFTOVERS="$LEFTOVERS
$PBXPROJ:
$HITS"
    fi
done

while IFS= read -r entitlements; do

    [ -f "$entitlements" ] || continue

    HITS="$(grep -nE "in-app-payments|storekit-external-purchase|InAppPurchase" \
        "$entitlements" 2>/dev/null || true)"

    if [ -n "$HITS" ]; then
        LEFTOVERS="$LEFTOVERS
$entitlements:
$HITS"
    fi

done <<ENTITLEMENTS
$ENTITLEMENTS_FOUND
ENTITLEMENTS

LEFTOVERS="$(echo "$LEFTOVERS" | grep -v '^$' || true)"

if [ -n "$LEFTOVERS" ]; then

    echo "[PEARZ] ERROR: the capability is still in the project:"
    echo "$LEFTOVERS" | sed 's|^|[PEARZ]   |'

    if [ "${UMP_IOS_STRIP_STRICT:-1}" = "1" ]; then
        exit 1
    fi

else

    echo "[PEARZ] Verified: no capability in $STRIP is left."
fi

# What the project still declares, so a build that fails on a
# capability anyway can be read against this.
SYSTEM_CAPABILITIES="$(perl -0ne \
    'print "$1\n" while /(SystemCapabilities\s*=\s*(\{(?:[^{}]++|(?2))*\});)/g' \
    "$PBXPROJ" 2>/dev/null || true)"

if [ -n "$SYSTEM_CAPABILITIES" ]; then

    echo "[PEARZ] Capabilities the project still declares:"
    echo "$SYSTEM_CAPABILITIES" | sed 's|^|[PEARZ]   |'

else

    echo "[PEARZ] The project declares no capability at all."
fi

if [ -n "$ENTITLEMENTS_FOUND" ]; then

    echo "[PEARZ] Entitlements files:"
    echo "$ENTITLEMENTS_FOUND" | sed 's|^|[PEARZ]   |'

else

    echo "[PEARZ] No entitlements file in the exported project."
fi

# ------------------------------------------------------------
# Verify signing came through untouched
# ------------------------------------------------------------

SIGNING_AFTER="$(signing_state)"

if [ "$SIGNING_BEFORE" != "$SIGNING_AFTER" ]; then

    echo "[PEARZ] ERROR: the strip changed signing settings."
    echo "[PEARZ] Before:"
    echo "$SIGNING_BEFORE" | sed 's|^|[PEARZ]   |'
    echo "[PEARZ] After:"
    echo "$SIGNING_AFTER" | sed 's|^|[PEARZ]   |'

    exit 1
fi

echo "[PEARZ] Verified: signing settings unchanged."

echo "========================================"
echo "[PEARZ] iOS strip finished"
echo "========================================"
