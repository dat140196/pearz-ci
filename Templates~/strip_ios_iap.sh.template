#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ iOS device build - final capability cleanup/verification.
#
# Runs AFTER Unity export and BEFORE xcodebuild.
#
# Always for release/ios-test:
#   - finish the Personal Team IAP cleanup.
#
# Optional for release/ios-test:
#   - disable Firebase test-only Xcode requirements when the Jenkins
#     Firebase checkbox is OFF: strip Push/APNs signing requirements
#     and the generated Crashlytics Run Script build phase. This does
#     NOT edit the Unity project, Firebase packages, or game source code.
#
# Jenkins checkbox IOS_TEST_ENABLE_FIREBASE_PUSH maps to:
#   UMP_IOS_STRIP_FIREBASE_PUSH=1  -> strip APNs + Crashlytics phase (default)
#   UMP_IOS_STRIP_FIREBASE_PUSH=0  -> keep Firebase/APNs/Crashlytics for testing
#
# Optional env vars:
#   UMP_IOS_PROJECT=/path/to/Unity-iPhone.xcodeproj
#   IOS_SCHEME=Unity-iPhone
#   UMP_IOS_CONFIGURATION=Release
#   UMP_IOS_STRIP_BRANCH=""       # allow any branch
#   UMP_IOS_STRIP_FIREBASE_PUSH=1 # default: strip Push/APNs
# ============================================================

echo "========================================"
echo "[PEARZ] iOS device capability cleanup"
echo "[PEARZ] UMP @UMP_VERSION@"
echo "========================================"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

STRIP_BRANCH="${UMP_IOS_STRIP_BRANCH-release/ios-test}"
if [ -n "$STRIP_BRANCH" ] && [ -n "${BRANCH_NAME:-}" ] && \
   [ "$BRANCH_NAME" != "$STRIP_BRANCH" ]; then
    echo "[PEARZ] Branch ${BRANCH_NAME} is not $STRIP_BRANCH."
    echo "[PEARZ] Project left unchanged."
    exit 0
fi

PROJECT="${UMP_IOS_PROJECT:-}"
if [ -z "$PROJECT" ]; then
    PROJECT="$(find "$WORKSPACE/Builds/iOS" \
        -maxdepth 2 \
        -type d \
        -name "*.xcodeproj" \
        2>/dev/null | head -n 1 || true)"
fi

if [ -z "$PROJECT" ] || [ ! -d "$PROJECT" ]; then
    echo "[PEARZ] ERROR: no Xcode project found under $WORKSPACE/Builds/iOS"
    exit 1
fi

PBXPROJ="$PROJECT/project.pbxproj"
if [ ! -f "$PBXPROJ" ]; then
    echo "[PEARZ] ERROR: missing $PBXPROJ"
    exit 1
fi

SCHEME="${IOS_SCHEME:-Unity-iPhone}"
CONFIGURATION="${UMP_IOS_CONFIGURATION:-Release}"
BACKUP="$(mktemp "${TMPDIR:-/tmp}/ump-pbxproj-XXXXXX")"
cp "$PBXPROJ" "$BACKUP"

restore_on_error() {
    local code=$?
    if [ "$code" -ne 0 ]; then
        echo "[PEARZ] ERROR: restoring project.pbxproj after failed edit."
        cp "$BACKUP" "$PBXPROJ" 2>/dev/null || true
    fi
    rm -f "$BACKUP"
    exit "$code"
}
trap restore_on_error EXIT

signing_state() {
    grep -hoE '(DEVELOPMENT_TEAM|DevelopmentTeam|PROVISIONING_PROFILE_SPECIFIER|ProvisioningStyle)[ \t]*=[ \t]*[^;]*;' \
        "$PBXPROJ" 2>/dev/null | sort -u || true
}

show_build_settings() {
    xcodebuild -showBuildSettings \
        -project "$PROJECT" \
        -scheme "$SCHEME" \
        -configuration "$CONFIGURATION" \
        2>/dev/null || true
}

SIGNING_BEFORE="$(signing_state)"
SETTINGS_BEFORE="$(show_build_settings)"
BUNDLE_BEFORE="$(echo "$SETTINGS_BEFORE" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"

echo "[PEARZ] Project       : $PROJECT"
echo "[PEARZ] Scheme        : $SCHEME"
echo "[PEARZ] Configuration : $CONFIGURATION"
echo "[PEARZ] Bundle id     : ${BUNDLE_BEFORE:-<unknown>}"

if [ -n "$SIGNING_BEFORE" ]; then
    echo "[PEARZ] Signing before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
fi

# ------------------------------------------------------------
# Remove only the literal Xcode capability marker. Do not change
# PRODUCT_BUNDLE_IDENTIFIER and do not remove Unity IAP source files.
# ------------------------------------------------------------
IAP_BEFORE="$(grep -nE 'com\.apple\.InAppPurchase|In-App Purchase' \
    "$PBXPROJ" 2>/dev/null || true)"

if [ -n "$IAP_BEFORE" ]; then
    echo "[PEARZ] Local IAP metadata before:"
    echo "$IAP_BEFORE" | sed 's/^/[PEARZ]   /'
fi

perl -0pi -e '
    s/^[ \t]*"?com\.apple\.InAppPurchase"?[ \t]*=[ \t]*\{[^{}]*\};[ \t]*\r?\n//mg;
    s/^[ \t]*SystemCapabilities[ \t]*=[ \t]*\{[ \t\r\n]*\};[ \t]*\r?\n//mg;
' "$PBXPROJ"

IAP_AFTER="$(grep -nE 'com\.apple\.InAppPurchase' "$PBXPROJ" 2>/dev/null || true)"
if [ -n "$IAP_AFTER" ]; then
    echo "[PEARZ] ERROR: com.apple.InAppPurchase is still present:"
    echo "$IAP_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

echo "[PEARZ] Local IAP capability marker: absent."

# ------------------------------------------------------------
# Optional Firebase cleanup for Personal Team test builds.
#
# When the Jenkins Firebase checkbox is OFF, remove only generated
# Xcode requirements that block a local test build:
#   - Push Notifications capability / aps-environment entitlement
#   - Crashlytics Run Script build phase (it requires GoogleService-Info.plist)
#
# Firebase assemblies/packages and Unity game source remain untouched.
# Production release/ios never runs this cleanup.
# ------------------------------------------------------------
STRIP_FIREBASE_PUSH="${UMP_IOS_STRIP_FIREBASE_PUSH:-1}"

case "$STRIP_FIREBASE_PUSH" in
    0|false|FALSE|False|no|NO|No|off|OFF|Off)
        STRIP_FIREBASE_PUSH=0
        ;;
    *)
        STRIP_FIREBASE_PUSH=1
        ;;
esac

if [ "$STRIP_FIREBASE_PUSH" = "1" ]; then
    echo "========================================"
    echo "[PEARZ] Firebase test integration: DISABLED"
    echo "[PEARZ] Strip: APNs capability + Crashlytics Run Script"
    echo "========================================"

    PUSH_BEFORE="$(grep -nE 'com\.apple\.Push|Push Notifications' \
        "$PBXPROJ" 2>/dev/null || true)"

    if [ -n "$PUSH_BEFORE" ]; then
        echo "[PEARZ] Push capability metadata before:"
        echo "$PUSH_BEFORE" | head -n 30 | sed 's/^/[PEARZ]   /'
    fi

    # ProjectCapabilityManager writes the Push Notifications switch
    # under TargetAttributes/SystemCapabilities as com.apple.Push.
    perl -0pi -e '
        s/^[ \t]*"?com\.apple\.Push"?[ \t]*=[ \t]*\{[^{}]*\};[ \t]*\r?\n//mg;
        s/^[ \t]*SystemCapabilities[ \t]*=[ \t]*\{[ \t\r\n]*\};[ \t]*\r?\n//mg;
    ' "$PBXPROJ"

    PUSH_AFTER="$(grep -nE 'com\.apple\.Push' "$PBXPROJ" 2>/dev/null || true)"
    if [ -n "$PUSH_AFTER" ]; then
        echo "[PEARZ] ERROR: com.apple.Push is still present:"
        echo "$PUSH_AFTER" | sed 's/^/[PEARZ]   /'
        exit 1
    fi

    echo "[PEARZ] Push Notifications capability marker: absent."

    ENTITLEMENTS_FOUND=0
    APS_REMOVED=0

    while IFS= read -r ENTITLEMENTS; do
        [ -n "$ENTITLEMENTS" ] || continue
        ENTITLEMENTS_FOUND=$((ENTITLEMENTS_FOUND + 1))

        if /usr/libexec/PlistBuddy \
            -c 'Print :aps-environment' \
            "$ENTITLEMENTS" >/dev/null 2>&1; then

            /usr/libexec/PlistBuddy \
                -c 'Delete :aps-environment' \
                "$ENTITLEMENTS"

            APS_REMOVED=$((APS_REMOVED + 1))
            echo "[PEARZ] Removed aps-environment: $ENTITLEMENTS"
        fi
    done < <(find "$WORKSPACE/Builds/iOS" \
        -type f \
        -name '*.entitlements' \
        -print 2>/dev/null | sort)

    APS_LEFT=0
    while IFS= read -r ENTITLEMENTS; do
        [ -n "$ENTITLEMENTS" ] || continue
        if /usr/libexec/PlistBuddy \
            -c 'Print :aps-environment' \
            "$ENTITLEMENTS" >/dev/null 2>&1; then
            echo "[PEARZ] ERROR: aps-environment still present: $ENTITLEMENTS"
            APS_LEFT=1
        fi
    done < <(find "$WORKSPACE/Builds/iOS" \
        -type f \
        -name '*.entitlements' \
        -print 2>/dev/null | sort)

    if [ "$APS_LEFT" -ne 0 ]; then
        exit 1
    fi

    echo "[PEARZ] Entitlements files found : $ENTITLEMENTS_FOUND"
    echo "[PEARZ] aps-environment removed : $APS_REMOVED"

    # Firebase Crashlytics adds a PBXShellScriptBuildPhase to the generated
    # Unity-iPhone target. That phase fails when the test export has no
    # GoogleService-Info.plist. Remove the phase only
    # when Firebase test integration is OFF. Ruby is used here because it is
    # available with Xcode/macOS and lets us remove the PBX object + GUID
    # references without touching other Firebase package references.
    if ! command -v ruby >/dev/null 2>&1; then
        echo "[PEARZ] ERROR: ruby is required to strip Crashlytics build phase."
        exit 1
    fi

    ruby - "$PBXPROJ" <<'RUBY'
path = ARGV.fetch(0)
lines = File.readlines(path)
start_re = /^(\s*)([A-Fa-f0-9]{24})(?: \/\*.*?\*\/)? = \{\s*$/
keywords = /Crashlytics Run Script|Crashlytics\/run|FirebaseCrashlytics|upload-symbols/i
removed = []
out = []
i = 0

while i < lines.length
  line = lines[i]
  match = start_re.match(line)

  if match
    indent = match[1]
    guid = match[2]
    block = [line]
    j = i + 1
    finish_re = /^#{Regexp.escape(indent)}\};\s*$/

    while j < lines.length
      block << lines[j]
      break if finish_re.match?(lines[j])
      j += 1
    end

    text = block.join
    if text.include?('isa = PBXShellScriptBuildPhase;') && text.match?(keywords)
      name = text[/name = \"?([^\";]+)\"?;/, 1] ||
             text[/\/\* (.*?) \*\//, 1] || 'Crashlytics script'
      removed << [guid, name]
      i = j + 1
      next
    end
  end

  out << line
  i += 1
end

removed_ids = removed.map(&:first)
unless removed_ids.empty?
  out.reject! { |line| removed_ids.any? { |guid| line.include?(guid) } }
end

File.write(path, out.join)

removed.each do |guid, name|
  puts "[PEARZ] Removed Crashlytics build phase: #{name} (#{guid})"
end
puts "[PEARZ] Crashlytics build phases removed: #{removed.length}"

# Verify no Crashlytics shell phase survived. Package/framework references
# are allowed to remain; only a shell phase is forbidden in Firebase-OFF mode.
verify_lines = File.readlines(path)
i = 0
while i < verify_lines.length
  line = verify_lines[i]
  match = start_re.match(line)
  unless match
    i += 1
    next
  end

  indent = match[1]
  block = [line]
  j = i + 1
  finish_re = /^#{Regexp.escape(indent)}\};\s*$/
  while j < verify_lines.length
    block << verify_lines[j]
    break if finish_re.match?(verify_lines[j])
    j += 1
  end

  text = block.join
  if text.include?('isa = PBXShellScriptBuildPhase;') && text.match?(keywords)
    warn '[PEARZ] ERROR: Crashlytics shell build phase still exists.'
    exit 1
  end
  i = j + 1
end
RUBY

    echo "[PEARZ] Firebase SDK/code       : untouched"
    echo "[PEARZ] GoogleService plist    : not required while Firebase test is OFF"
else
    echo "========================================"
    echo "[PEARZ] Firebase test integration: ENABLED"
    echo "[PEARZ] Keep: APNs capability + Crashlytics Run Script"
    echo "[PEARZ] Apple Push profile and GoogleService-Info.plist are required."
    echo "========================================"
fi

# Xcode must still be able to parse the edited project.
if ! xcodebuild -list -project "$PROJECT" >/dev/null 2>&1; then
    echo "[PEARZ] ERROR: Xcode cannot parse the edited project."
    exit 1
fi

SETTINGS_AFTER="$(show_build_settings)"
BUNDLE_AFTER="$(echo "$SETTINGS_AFTER" \
    | awk -F' = ' '/ PRODUCT_BUNDLE_IDENTIFIER = / {print $2; exit}' \
    | tr -d ' \r' || true)"
SIGNING_AFTER="$(signing_state)"

if [ -n "$BUNDLE_BEFORE" ] && [ "$BUNDLE_AFTER" != "$BUNDLE_BEFORE" ]; then
    echo "[PEARZ] ERROR: bundle id changed unexpectedly."
    echo "[PEARZ] Before: $BUNDLE_BEFORE"
    echo "[PEARZ] After : ${BUNDLE_AFTER:-<empty>}"
    exit 1
fi

if [ "$SIGNING_BEFORE" != "$SIGNING_AFTER" ]; then
    echo "[PEARZ] ERROR: signing settings changed unexpectedly."
    echo "[PEARZ] Before:"
    echo "$SIGNING_BEFORE" | sed 's/^/[PEARZ]   /'
    echo "[PEARZ] After:"
    echo "$SIGNING_AFTER" | sed 's/^/[PEARZ]   /'
    exit 1
fi

# Count PBXBuildFile declarations, not all comment occurrences. A single
# framework membership is referenced twice textually in a pbxproj (object
# declaration + build-phase child), so counting comments would be wrong.
# For the device build we expect at most one StoreKit PBXBuildFile: the
# UnityFramework membership intentionally preserved by JenkinsBuild.cs.
STOREKIT_BUILD_COUNT="$(grep -Ec 'isa = PBXBuildFile;.*StoreKit\.framework' \
    "$PBXPROJ" 2>/dev/null || true)"
STOREKIT_BUILD_COUNT="${STOREKIT_BUILD_COUNT:-0}"

echo "[PEARZ] StoreKit PBXBuildFile entries: $STOREKIT_BUILD_COUNT"
grep -nE 'isa = PBXBuildFile;.*StoreKit\.framework' "$PBXPROJ" \
    | head -n 20 \
    | sed 's/^/[PEARZ]   /' || true

if [ "$STOREKIT_BUILD_COUNT" -gt 1 ]; then
    echo "[PEARZ] ERROR: StoreKit.framework is still linked by more than one target."
    echo "[PEARZ] The Unity post-export cleanup did not remove it from Unity-iPhone."
    echo "[PEARZ] Check for this Unity log line:"
    echo "[PEARZ]   Removed StoreKit.framework from Unity-iPhone target only."
    exit 1
fi

echo "[PEARZ] Remaining StoreKit/IAP references (diagnostic only):"
grep -nEi 'StoreKit|InAppPurchase|In-App Purchase' "$PBXPROJ" \
    | head -n 40 \
    | sed 's/^/[PEARZ]   /' || true

echo "[PEARZ] Verified bundle id : ${BUNDLE_AFTER:-<unknown>}"
echo "[PEARZ] Verified signing   : unchanged"
echo "========================================"
echo "[PEARZ] iOS device capability cleanup finished"
echo "========================================"

trap - EXIT
rm -f "$BACKUP"
