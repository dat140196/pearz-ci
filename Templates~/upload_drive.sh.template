#!/bin/bash

set -euo pipefail

echo "========================================"
echo "[PEARZ] Google Drive Upload"
echo "[PEARZ] UMP        : @UMP_VERSION@"
echo "[PEARZ] Auth       : OAuth 2.0 Client ID"
echo "========================================"

if [ "$#" -lt 1 ]; then
    echo "[PEARZ] ERROR: Missing upload file."
    exit 1
fi

UPLOAD_FILE="$1"

if [ ! -f "$UPLOAD_FILE" ]; then
    echo "[PEARZ] ERROR: Upload file not found:"
    echo "$UPLOAD_FILE"
    exit 1
fi

required=(
    UMP_DRIVE_OAUTH_CLIENT_ID
    UMP_DRIVE_OAUTH_CLIENT_SECRET
    UMP_DRIVE_OAUTH_REFRESH_TOKEN
    UMP_DRIVE_FOLDER_ID
)

for name in "${required[@]}"; do
    if [ -z "${!name:-}" ]; then
        echo "[PEARZ] ERROR: $name is empty."
        exit 1
    fi
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "[PEARZ] File       : $UPLOAD_FILE"
if [ "${UMP_DRIVE_BUILD_INFO_ONLY:-0}" = "1" ]; then
    echo "[PEARZ] Mode       : iOS BUILD_INFO only"
fi

python3 "$SCRIPT_DIR/upload_drive_impl.py" "$UPLOAD_FILE"

echo "========================================"
echo "[PEARZ] Google Drive upload completed."
echo "========================================"
