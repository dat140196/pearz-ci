#!/bin/bash

set -euo pipefail

echo "========================================"
echo "[PEARZ] Google Drive Upload"
echo "[PEARZ] UMP        : @UMP_VERSION@"
echo "[PEARZ] Auth       : OAuth 2.0 Client ID"
echo "========================================"

if [ "$#" -lt 1 ]; then
    echo "[PEARZ] ERROR: Missing artifact."
    exit 1
fi

ARTIFACT="$1"

if [ ! -f "$ARTIFACT" ]; then
    echo "[PEARZ] ERROR: Artifact not found:"
    echo "$ARTIFACT"
    exit 1
fi

required=(
    UMP_DRIVE_OAUTH_CLIENT_ID
    UMP_DRIVE_OAUTH_CLIENT_SECRET
    UMP_DRIVE_OAUTH_REFRESH_TOKEN
    UMP_DRIVE_FOLDER_ID
)

for name in "${required[@]}"; do
    if [ -z "${!name:-}" ]; then
        echo "[PEARZ] ERROR: $name is empty."
        exit 1
    fi
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "[PEARZ] Artifact   : $ARTIFACT"

python3 "$SCRIPT_DIR/upload_drive_impl.py" "$ARTIFACT"

echo "========================================"
echo "[PEARZ] Google Drive upload completed."
echo "========================================"
