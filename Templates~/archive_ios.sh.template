#!/bin/bash
set -euo pipefail

IOS_PATH="$WORKSPACE/Builds/iOS"
ARCHIVE="$WORKSPACE/Builds/iOSArchive/Game.xcarchive"
EXPORT="$WORKSPACE/Builds/iOSExport"
OPTIONS="$WORKSPACE/Jenkins/ExportOptions.plist"

rm -rf "$WORKSPACE/Builds/iOSArchive" "$EXPORT"
mkdir -p "$(dirname "$ARCHIVE")" "$EXPORT"

cd "$IOS_PATH"

# ------------------------------------------------------------
# Scheme: IOS_SCHEME if provided, otherwise read it
# from the generated Xcode project.
# ------------------------------------------------------------

# GameAssembly and UnityFramework are library schemes and
# archive into something that cannot be exported as an ipa.

SCHEME="${IOS_SCHEME:-}"

if [ -z "$SCHEME" ]; then

    SCHEMES="$(xcodebuild -list -project Unity-iPhone.xcodeproj 2>/dev/null \
        | awk '/Schemes:/ {found=1; next} found && !NF {exit} found {
            gsub(/^[ \t]+|[ \t]+$/, ""); print }')"

    if echo "$SCHEMES" | grep -qx "Unity-iPhone"; then

        SCHEME="Unity-iPhone"

    else

        SCHEME="$(echo "$SCHEMES" \
            | grep -vxE "GameAssembly|UnityFramework|Pods-.*" \
            | head -n 1 || true)"
    fi
fi

if [ -z "$SCHEME" ]; then
    SCHEME="Unity-iPhone"
fi

echo "[PEARZ] Xcode scheme: $SCHEME"

xcodebuild \
    -project Unity-iPhone.xcodeproj \
    -scheme "$SCHEME" \
    -configuration Release \
    -archivePath "$ARCHIVE" \
    archive

xcodebuild \
    -exportArchive \
    -archivePath "$ARCHIVE" \
    -exportPath "$EXPORT" \
    -exportOptionsPlist "$OPTIONS"

# ------------------------------------------------------------
# Rename the IPA to ProductName-v1.0.0.ipa,
# using the info written by JenkinsBuild.
# ------------------------------------------------------------

INFO="$WORKSPACE/Builds/ump_build_info.txt"

IPA="$(find "$EXPORT" -maxdepth 2 -type f -name "*.ipa" | head -n 1 || true)"

if [ -n "$IPA" ] && [ -f "$INFO" ]; then

    NAME="$(awk -F= '/^PRODUCT_NAME_SAFE=/ {print $2; exit}' "$INFO" | tr -d '\r')"
    VERSION="$(awk -F= '/^VERSION=/ {print $2; exit}' "$INFO" | tr -d '\r')"

    if [ -n "$NAME" ] && [ -n "$VERSION" ]; then

        TARGET="$(dirname "$IPA")/${NAME}-v${VERSION}.ipa"

        if [ "$IPA" != "$TARGET" ]; then
            mv "$IPA" "$TARGET"
            echo "[PEARZ] IPA: $TARGET"
        fi
    fi
fi

find "$EXPORT" -maxdepth 2 -type f -print
