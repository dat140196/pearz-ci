#!/bin/bash
set -euo pipefail
UNITY_PATH="${UNITY_PATH:-__UMP_UNITY_PATH__}"
if [ "${BRANCH_NAME:-}" = "release/android-test" ]; then
  "$UNITY_PATH" -batchmode -quit -projectPath "$WORKSPACE" -executeMethod JenkinsBuild.BuildAndroidApk -buildTarget Android -logFile -
else
  "$UNITY_PATH" -batchmode -quit -projectPath "$WORKSPACE" -executeMethod JenkinsBuild.BuildAndroidAab -buildTarget Android -logFile -
fi
