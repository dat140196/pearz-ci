#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ Android Build
# release/android      -> AAB + release keystore REQUIRED
# release/android-test -> APK + custom keystore SKIPPED
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

chmod +x "$SCRIPT_DIR/find_unity.sh" 2>/dev/null || true

UNITY_PATH="$("$SCRIPT_DIR/find_unity.sh")"

if [ -z "$UNITY_PATH" ] || [ ! -x "$UNITY_PATH" ]; then
    echo "[PEARZ] ERROR: Unity executable not found."
    exit 1
fi

echo "[PEARZ] UMP        : @UMP_VERSION@"
echo "[PEARZ] Unity Path : $UNITY_PATH"
echo "[PEARZ] Branch     : ${BRANCH_NAME:-unknown}"
echo "[PEARZ] Workspace  : ${WORKSPACE:-unknown}"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

# ------------------------------------------------------------
# Signing policy
#
# ONLY release/android builds an AAB for Google Play and may
# resolve/use the release keystore. Every other Android build
# must ignore custom keystore credentials completely.
# ------------------------------------------------------------

if [ "${BRANCH_NAME:-}" = "release/android" ]; then
    echo "[PEARZ] Keystore   : required for release/android AAB"

    # Exports UMP_ANDROID_* from Jenkins credentials, the project
    # Keystores folder, or the machine keystore store.
    . "$SCRIPT_DIR/resolve_keystore.sh"

    # The resolver may drop the passwords in a temp file.
    trap 'rm -f "${UMP_ANDROID_KEYSTORE_PROPS:-/dev/null}"' EXIT
else
    # Do not allow global Jenkins env vars or stale values to make
    # an APK/test build accidentally use the production key.
    unset UMP_ANDROID_KEYSTORE || true
    unset UMP_ANDROID_KEYSTORE_PASS || true
    unset UMP_ANDROID_KEY_ALIAS || true
    unset UMP_ANDROID_KEY_ALIAS_PASS || true
    unset UMP_ANDROID_KEYSTORE_PROPS || true

    echo "[PEARZ] Keystore   : skipped (only release/android uses it)"
fi

# ------------------------------------------------------------
# Android TEST
# release/android-test -> APK
# ------------------------------------------------------------

if [ "${BRANCH_NAME:-}" = "release/android-test" ]; then
    echo "========================================"
    echo "[PEARZ] Building Android APK"
    echo "[PEARZ] Signing : Android debug/default signing"
    echo "========================================"

    "$UNITY_PATH" \
        -batchmode \
        -quit \
        -nographics \
        -projectPath "$WORKSPACE" \
        -buildTarget Android \
        -executeMethod JenkinsBuild.BuildAndroidApk \
        -logFile -

# ------------------------------------------------------------
# Android RELEASE
# release/android -> AAB
# ------------------------------------------------------------

elif [ "${BRANCH_NAME:-}" = "release/android" ]; then
    echo "========================================"
    echo "[PEARZ] Building Android AAB"
    echo "[PEARZ] Signing : release keystore required"
    echo "========================================"

    "$UNITY_PATH" \
        -batchmode \
        -quit \
        -nographics \
        -projectPath "$WORKSPACE" \
        -buildTarget Android \
        -executeMethod JenkinsBuild.BuildAndroidAab \
        -logFile -
else
    echo "[PEARZ] ERROR: Unsupported Android branch:"
    echo "${BRANCH_NAME:-<empty>}"
    exit 1
fi

echo "========================================"
echo "[PEARZ] Android build finished"
echo "========================================"
