#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ Android Build
# release/android      -> AAB
# release/android-test -> APK
# ============================================================

UNITY_PATH="${UNITY_PATH:-}"

# Nếu Jenkins chưa truyền UNITY_PATH hoặc path không tồn tại,
# tự tìm Unity được cài qua Unity Hub.
if [ -z "$UNITY_PATH" ] || [ ! -x "$UNITY_PATH" ]; then
    echo "[PEARZ] UNITY_PATH is empty or invalid."
    echo "[PEARZ] Searching for Unity..."

    UNITY_PATH="$(find /Applications/Unity/Hub/Editor \
        -type f \
        -path "*/Unity.app/Contents/MacOS/Unity" \
        2>/dev/null | sort -V | tail -n 1 || true)"
fi

if [ -z "$UNITY_PATH" ] || [ ! -x "$UNITY_PATH" ]; then
    echo "[PEARZ] ERROR: Unity executable not found."
    echo "[PEARZ] Please install Unity or configure UNITY_PATH in Jenkins."
    exit 1
fi

echo "[PEARZ] Unity Path : $UNITY_PATH"
echo "[PEARZ] Branch     : ${BRANCH_NAME:-unknown}"
echo "[PEARZ] Workspace  : ${WORKSPACE:-unknown}"

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

# ------------------------------------------------------------
# Android TEST
# release/android-test -> APK
# ------------------------------------------------------------

if [ "${BRANCH_NAME:-}" = "release/android-test" ]; then

    echo "========================================"
    echo "[PEARZ] Building Android APK"
    echo "========================================"

    "$UNITY_PATH" \
        -batchmode \
        -quit \
        -nographics \
        -projectPath "$WORKSPACE" \
        -buildTarget Android \
        -executeMethod JenkinsBuild.BuildAndroidApk \
        -logFile -

# ------------------------------------------------------------
# Android RELEASE
# release/android -> AAB
# ------------------------------------------------------------

elif [ "${BRANCH_NAME:-}" = "release/android" ]; then

    echo "========================================"
    echo "[PEARZ] Building Android AAB"
    echo "========================================"

    "$UNITY_PATH" \
        -batchmode \
        -quit \
        -nographics \
        -projectPath "$WORKSPACE" \
        -buildTarget Android \
        -executeMethod JenkinsBuild.BuildAndroidAab \
        -logFile -

else

    echo "[PEARZ] ERROR: Unsupported Android branch:"
    echo "${BRANCH_NAME:-<empty>}"
    exit 1

fi

echo "========================================"
echo "[PEARZ] Android build finished"
echo "========================================"