#!/bin/bash
set -euo pipefail

# ============================================================
# PEARZ iOS Build -> Xcode project in Builds/iOS
#
# Unity appends to an Xcode project that is already there, so
# Signing & Capabilities set up by hand in Xcode survives every
# build. UMP_IOS_CLEAN=1 exports from scratch instead.
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

chmod +x "$SCRIPT_DIR/find_unity.sh" 2>/dev/null || true

UNITY_PATH="$("$SCRIPT_DIR/find_unity.sh")"

if [ -z "$UNITY_PATH" ] || [ ! -x "$UNITY_PATH" ]; then
    echo "[PEARZ] ERROR: Unity executable not found."
    exit 1
fi

if [ -z "${WORKSPACE:-}" ]; then
    echo "[PEARZ] ERROR: WORKSPACE is not defined."
    exit 1
fi

echo "[PEARZ] UMP        : @UMP_VERSION@"
echo "[PEARZ] Unity Path : $UNITY_PATH"
echo "[PEARZ] Branch     : ${BRANCH_NAME:-unknown}"
echo "[PEARZ] Workspace  : $WORKSPACE"

if [ "${UMP_IOS_CLEAN:-0}" = "1" ]; then
    echo "[PEARZ] Export     : clean (UMP_IOS_CLEAN=1)"
else
    echo "[PEARZ] Export     : append to the existing Xcode project"
fi

"$UNITY_PATH" \
    -batchmode \
    -quit \
    -nographics \
    -projectPath "$WORKSPACE" \
    -buildTarget iOS \
    -executeMethod JenkinsBuild.BuildIOS \
    -logFile -

echo "========================================"
echo "[PEARZ] iOS Xcode project generated"
echo "========================================"
